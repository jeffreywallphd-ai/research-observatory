        "revisionId": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "workId",
        "revisionId"
      ],
      "title": "CanonicalWorkReference",
      "type": "object"
    },
    "CodepointRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/Count"
        },
        "end": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "CodepointRange",
      "type": "object"
    },
    "ConfidenceObservation": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "reported",
            "unknown",
            "not-reported",
            "not-applicable",
            "unavailable"
