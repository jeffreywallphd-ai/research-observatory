{
  "name": "@research-observatory/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "domain:check": "node domain/generate.mjs --check && node domain/generate-lifecycle.mjs --check && node domain/generate-compatibility.mjs --check",
    "intent:check": "node intent/generate.mjs --check",
    "model-gateway:check": "node model-gateway/generate.mjs --check",
    "provenance:check": "node provenance/generate.mjs --check",
    "workflow:check": "node workflow/generate.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "verify": "pnpm run domain:check && pnpm run intent:check && pnpm run model-gateway:check && pnpm run provenance:check && pnpm run workflow:check && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "exports": {
    "./core-api": "./core-api/generated.ts",
    "./domain": "./domain/generated.ts",
    "./domain-compatibility": "./domain/compatibility.generated.ts",
    "./domain-lifecycle": "./domain/lifecycle.generated.ts",
    "./research-intent": "./intent/generated.ts",
    "./model-gateway": "./model-gateway/generated.ts",
    "./provenance": "./provenance/generated.ts",
    "./workflow": "./workflow/generated.ts",
    "./project": "./project/index.ts"
  }
}
