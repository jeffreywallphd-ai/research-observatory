      "type": "string"
    },
    "Count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Format": {
      "enum": [
        "jats",
        "tei",
        "xml",
        "html",
        "pdf",
        "docx",
        "plain-text"
      ],
      "type": "string"
    },
    "Identity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "LocalOrigin": {
      "additionalProperties": false,
