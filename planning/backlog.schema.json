{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/implementation-backlog-1.3.json",
  "title": "Research Observatory implementation backlog",
  "description": "Authoritative Capability -> Slice -> Task work ledger for Research Observatory Architecture Baseline 1.3.",
  "type": "object",
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "nullableTimestamp": {
      "anyOf": [
        {"$ref": "#/$defs/timestamp"},
        {"type": "null"}
      ]
    },
    "nullableCommit": {
      "anyOf": [
        {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        {"type": "null"}
      ]
    },
    "nullableLease": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["claimed_by", "claimed_at", "expires_at"],
          "properties": {
            "claimed_by": {"type": "string", "minLength": 1},
            "claimed_at": {"$ref": "#/$defs/timestamp"},
            "expires_at": {"$ref": "#/$defs/timestamp"}
          },
          "additionalProperties": false
        }
      ]
    },
    "evidenceReferences": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "taskEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path", "sha256", "commit", "recorded_at"],
        "properties": {
          "type": {"const": "criterion-manifest"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "recorded_at": {"$ref": "#/$defs/timestamp"},
          "legacy_policy": {"const": "pre-exact-evidence-hosted-ci-residual-v1"}
        },
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "required": ["reviewer", "result", "reviewed_at", "notes"],
      "properties": {
        "reviewer": {"type": ["string", "null"]},
        "result": {"enum": ["approved", "changes-requested", "blocked", null]},
        "reviewed_at": {"$ref": "#/$defs/nullableTimestamp"},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "nullableBlocker": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["reason", "next_action", "recorded_at", "owner"],
          "properties": {
            "reason": {"type": "string", "minLength": 1},
            "next_action": {"type": "string", "minLength": 1},
            "recorded_at": {"$ref": "#/$defs/timestamp"},
            "owner": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "plan",
    "status_profile",
    "status_definitions",
    "waves",
    "release_gates",
    "architecture_constraints",
    "selection_policy",
    "verification_profiles",
    "capabilities"
  ],
  "properties": {
    "plan": {
      "type": "object",
      "required": [
        "id",
        "title",
        "version",
        "date",
        "authority",
        "primary_delivery_priority",
        "document_set"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "const": "1.3"
        },
        "date": {
          "type": "string",
          "format": "date",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "primary_delivery_priority": {
          "type": "string",
          "minLength": 1
        },
        "document_set": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "status_profile": {
      "type": "object",
      "required": [
        "name",
        "claim_transition",
        "submit_transition",
        "review_transitions",
        "default_execution_unit",
        "integration_unit",
        "atomic_evidence_unit"
      ],
      "additionalProperties": true
    },
    "status_definitions": {
      "type": "object",
      "required": [
        "NOT_STARTED",
        "READY",
        "IN_PROGRESS",
        "BLOCKED",
        "REVIEW",
        "DONE",
        "DEFERRED",
        "CANCELLED"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "waves": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "goal",
          "activation_gate",
          "track"
        ],
        "properties": {
          "id": {
            "enum": [
              "W0",
              "W1",
              "W2",
              "W3",
              "W4",
              "W5",
              "W6",
              "W7",
              "W8",
              "W9",
              "W10",
              "W11"
            ]
          },
          "activation_gate": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "G0",
              "G1",
              "G2",
              "G3",
              "G4",
              "G5",
              "G6",
              "G7",
              "G8",
              "G9",
              "G10",
              "G11",
              null
            ]
          },
          "track": {
            "enum": [
              "local-baseline",
              "cross-platform-desktop",
              "research-production",
              "research-intelligence",
              "institutional",
              "cloud"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "release_gates": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "after_wave",
          "name",
          "criteria",
          "status",
          "unlocks_waves",
          "approval"
        ],
        "properties": {
          "id": {
            "enum": [
              "G0",
              "G1",
              "G2",
              "G3",
              "G4",
              "G5",
              "G6",
              "G7",
              "G8",
              "G9",
              "G10",
              "G11"
            ]
          },
          "after_wave": {
            "enum": [
              "W0",
              "W1",
              "W2",
              "W3",
              "W4",
              "W5",
              "W6",
              "W7",
              "W8",
              "W9",
              "W10",
              "W11"
            ]
          },
          "status": {
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED",
              "SUPERSEDED"
            ]
          },
          "unlocks_waves": {
            "type": "array",
            "items": {
              "enum": [
                "W0",
                "W1",
                "W2",
                "W3",
                "W4",
                "W5",
                "W6",
                "W7",
                "W8",
                "W9",
                "W10",
                "W11"
              ]
            },
            "uniqueItems": true
          },
          "approval": {
            "type": "object",
            "required": [
              "approved_by",
              "approved_at",
              "evidence",
              "notes"
            ],
            "properties": {
              "approved_by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "approved_at": {
                "$ref": "#/$defs/nullableTimestamp"
              },
              "evidence": {
                "$ref": "#/$defs/evidenceReferences"
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "architecture_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "selection_policy": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_profiles": {
      "type": "object",
      "required": [
        "foundation",
        "architecture",
        "desktop",
        "desktop-cross-platform",
        "service",
        "data",
        "documents",
        "search",
        "ai",
        "evidence",
        "graph",
        "novelty",
        "study-design",
        "manuscript",
        "results",
        "reviewer",
        "e2e-local",
        "security-local",
        "server",
        "cloud"
      ],
      "properties": {
        "foundation": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "desktop": {
          "type": "string",
          "minLength": 1
        },
        "desktop-cross-platform": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "string",
          "minLength": 1
        },
        "documents": {
          "type": "string",
          "minLength": 1
        },
        "search": {
          "type": "string",
          "minLength": 1
        },
        "ai": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "graph": {
          "type": "string",
          "minLength": 1
        },
        "novelty": {
          "type": "string",
          "minLength": 1
        },
        "study-design": {
          "type": "string",
          "minLength": 1
        },
        "manuscript": {
          "type": "string",
          "minLength": 1
        },
        "results": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "e2e-local": {
          "type": "string",
          "minLength": 1
        },
        "security-local": {
          "type": "string",
          "minLength": 1
        },
        "server": {
          "type": "string",
          "minLength": 1
        },
        "cloud": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "desktop_platforms": {
      "type": "object",
      "required": [
        "windows-x64",
        "macos-arm64",
        "linux-x64",
        "linux-arm64",
        "platform-neutral"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "objective",
          "exit_criteria",
          "execution_mode",
          "campaign",
          "completion",
          "slices"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CAP-[0-9]{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "exit_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "execution_mode": {
            "const": "capability_campaign"
          },
          "campaign": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "status": {
                "enum": [
                  "PLANNED",
                  "ACTIVE",
                  "PAUSED",
                  "REVIEW",
                  "COMPLETE",
                  "CANCELLED"
                ]
              },
              "owner": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "branch": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "worktree": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "base_sha": {
                "$ref": "#/$defs/nullableCommit"
              },
              "started_at": {
                "$ref": "#/$defs/nullableTimestamp"
              },
              "updated_at": {
                "$ref": "#/$defs/nullableTimestamp"
              },
              "pause_reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lease": {
                "$ref": "#/$defs/nullableLease"
              }
            },
            "additionalProperties": true
          },
          "completion": {
            "type": "object",
            "required": [
              "status",
              "reviewer",
              "reviewed_at",
              "evidence",
              "notes"
            ],
            "properties": {
              "status": {
                "enum": [
                  "PENDING",
                  "IN_PROGRESS",
                  "REVIEW",
                  "APPROVED",
                  "CHANGES_REQUESTED",
                  "BLOCKED",
                  "PAUSED"
                ]
              },
              "reviewer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reviewed_at": {
                "$ref": "#/$defs/nullableTimestamp"
              },
              "evidence": {
                "$ref": "#/$defs/evidenceReferences"
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          },
          "slices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "outcome",
                "wave",
                "priority",
                "deployment_profiles",
                "platform_targets",
                "depends_on",
                "status",
                "completion",
                "tasks"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^CAP-[0-9]{2}\\.S[0-9]{2}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome": {
                  "type": "string",
                  "minLength": 1
                },
                "wave": {
                  "enum": [
                    "W0",
                    "W1",
                    "W2",
                    "W3",
                    "W4",
                    "W5",
                    "W6",
                    "W7",
                    "W8",
                    "W9",
                    "W10",
                    "W11"
                  ]
                },
                "priority": {
                  "pattern": "^P[0-3]$"
                },
                "deployment_profiles": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "LOC",
                      "LAB",
                      "UNI",
                      "CLD",
                      "ALL"
                    ]
                  },
                  "uniqueItems": true
                },
                "platform_targets": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "platform-neutral",
                      "windows-x64",
                      "macos-arm64",
                      "linux-x64",
                      "linux-arm64",
                      "linux-server",
                      "cloud"
                    ]
                  },
                  "uniqueItems": true
                },
                "depends_on": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "status": {
                  "enum": [
                    "NOT_STARTED",
                    "READY",
                    "IN_PROGRESS",
                    "BLOCKED",
                    "REVIEW",
                    "DONE",
                    "DEFERRED",
                    "CANCELLED"
                  ]
                },
                "completion": {
                  "type": "object",
                  "required": [
                    "status",
                    "reviewer",
                    "reviewed_at",
                    "evidence",
                    "notes"
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "PENDING",
                        "IN_PROGRESS",
                        "REVIEW",
                        "APPROVED",
                        "CHANGES_REQUESTED",
                        "BLOCKED",
                        "PAUSED"
                      ]
                    },
                    "reviewer": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "reviewed_at": {
                      "$ref": "#/$defs/nullableTimestamp"
                    },
                    "evidence": {
                      "$ref": "#/$defs/evidenceReferences"
                    },
                    "notes": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": true
                },
                "tasks": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "capability_id",
                      "slice_id",
                      "title",
                      "objective",
                      "deliverables",
                      "acceptance_criteria",
                      "dependencies",
                      "priority",
                      "wave",
                      "deployment_profiles",
                      "platform_targets",
                      "estimate",
                      "risk",
                      "review_gate",
                      "verification_profiles",
                      "verification_commands",
                      "status",
                      "evidence",
                      "review"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^CAP-[0-9]{2}\\.S[0-9]{2}\\.T[0-9]{2}$"
                      },
                      "capability_id": {
                        "type": "string",
                        "pattern": "^CAP-[0-9]{2}$"
                      },
                      "slice_id": {
                        "type": "string",
                        "pattern": "^CAP-[0-9]{2}\\.S[0-9]{2}$"
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1
                      },
                      "objective": {
                        "type": "string",
                        "minLength": 1
                      },
                      "deliverables": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "acceptance_criteria": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "dependencies": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "priority": {
                        "pattern": "^P[0-3]$"
                      },
                      "wave": {
                        "enum": [
                          "W0",
                          "W1",
                          "W2",
                          "W3",
                          "W4",
                          "W5",
                          "W6",
                          "W7",
                          "W8",
                          "W9",
                          "W10",
                          "W11"
                        ]
                      },
                      "deployment_profiles": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "enum": [
                            "LOC",
                            "LAB",
                            "UNI",
                            "CLD",
                            "ALL"
                          ]
                        },
                        "uniqueItems": true
                      },
                      "platform_targets": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "enum": [
                            "platform-neutral",
                            "windows-x64",
                            "macos-arm64",
                            "linux-x64",
                            "linux-arm64",
                            "linux-server",
                            "cloud"
                          ]
                        },
                        "uniqueItems": true
                      },
                      "estimate": {
                        "enum": [
                          "S",
                          "M",
                          "L",
                          "XL"
                        ]
                      },
                      "risk": {
                        "enum": [
                          "low",
                          "medium",
                          "high",
                          "critical"
                        ]
                      },
                      "review_gate": {
                        "type": "string",
                        "minLength": 1
                      },
                      "verification_profiles": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "enum": [
                            "foundation",
                            "architecture",
                            "desktop",
                            "desktop-cross-platform",
                            "service",
                            "data",
                            "documents",
                            "search",
                            "ai",
                            "evidence",
                            "graph",
                            "novelty",
                            "study-design",
                            "manuscript",
                            "results",
                            "reviewer",
                            "e2e-local",
                            "security-local",
                            "server",
                            "cloud"
                          ]
                        },
                        "uniqueItems": true
                      },
                      "verification_commands": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "status": {
                        "enum": [
                          "NOT_STARTED",
                          "READY",
                          "IN_PROGRESS",
                          "BLOCKED",
                          "REVIEW",
                          "DONE",
                          "DEFERRED",
                          "CANCELLED"
                        ]
                      },
                      "owner": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "branch": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "base_sha": {
                        "$ref": "#/$defs/nullableCommit"
                      },
                      "worktree": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "lease": {
                        "$ref": "#/$defs/nullableLease"
                      },
                      "started_at": {
                        "$ref": "#/$defs/nullableTimestamp"
                      },
                      "updated_at": {
                        "$ref": "#/$defs/nullableTimestamp"
                      },
                      "completed_at": {
                        "$ref": "#/$defs/nullableTimestamp"
                      },
                      "blocker": {
                        "$ref": "#/$defs/nullableBlocker"
                      },
                      "implementation_notes": {
                        "type": "string"
                      },
                      "evidence": {
                        "$ref": "#/$defs/taskEvidence"
                      },
                      "verification_state": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "review": {
                        "$ref": "#/$defs/review"
                      },
                      "cancellation": {
                        "type": [
                          "object",
                          "null"
                        ]
                      }
                    },
                    "additionalProperties": true
                  }
