{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/wave-amendment-bootstrap-scope-addendum-1.0.json",
  "title": "Wave amendment bootstrap scope addendum",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentType",
    "amendmentId",
    "bootstrapUnit",
    "status",
    "approvedBy",
    "approvedAt",
    "decision",
    "baseApprovalCommit",
    "candidateAtDecision",
    "authorizedAdditionalPaths",
    "constraints"
  ],
  "properties": {
    "$schema": {"const": "./bootstrap-scope-addendum.schema.json"},
    "schemaVersion": {"const": "1.0"},
    "documentType": {"const": "wave-amendment-bootstrap-scope-addendum"},
    "amendmentId": {"type": "string", "pattern": "^W[0-9]+\\.A[0-9]{2}$"},
    "bootstrapUnit": {"type": "string", "pattern": "^W[0-9]+\\.A[0-9]{2}\\.B00$"},
    "status": {"const": "APPROVED"},
    "approvedBy": {"type": "string", "minLength": 1},
    "approvedAt": {"type": "string", "format": "date-time"},
    "decision": {"type": "string", "minLength": 1},
    "baseApprovalCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidateAtDecision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authorizedAdditionalPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
      },
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
