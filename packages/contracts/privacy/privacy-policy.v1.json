{
  "schemaVersion": "1.0",
  "documentType": "research-observatory-project-privacy-policy",
  "defaults": {
    "networkPolicy": "offline",
    "remoteModelApproval": "preview-every-task",
    "telemetryMode": "off",
    "logRetentionDays": 14,
    "documentRetention": "project-lifetime",
    "cacheRetentionDays": 30
  },
  "egress": {
    "networkPolicies": ["offline", "metadata-only", "approved-providers"],
    "consentToken": "acknowledge-egress-preview-v1",
    "settingChangeSendsData": false,
    "objectContentOutcomes": {"offline": "deny", "metadata-only": "deny", "approved-providers": "require-confirmation"}
  },
  "telemetry": {"modes": ["off", "local-diagnostics-only"], "remoteTelemetryImplemented": false},
  "retention": {
    "minimumDays": 1,
    "maximumDays": 90,
    "documentPolicies": ["project-lifetime", "review-after-90-days", "review-after-365-days"],
    "automaticDocumentDeletion": false
  },
  "cacheDeletion": {
    "scope": "project-cache-only",
    "previewRequired": true,
    "exactConfirmationRequired": true,
    "logicalRemoval": true,
    "physicalErasureGuaranteed": false,
    "canonicalProjectDataExcluded": true,
    "limitations": ["filesystem-unlink-is-not-physical-erasure-proof", "ssd-wear-levelling-and-device-remapping", "journals-snapshots-backups-and-hard-links", "rebuildable-cache-only"]
  },
  "auditEvents": ["privacy.policy.changed", "privacy.cache.cleared"]
}
