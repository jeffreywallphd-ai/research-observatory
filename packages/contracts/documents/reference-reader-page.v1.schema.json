        },
        "y0": {
          "$ref": "#/$defs/UnitCoordinate"
        },
        "x1": {
          "$ref": "#/$defs/UnitCoordinate"
        },
        "y1": {
          "$ref": "#/$defs/UnitCoordinate"
        },
        "sourceWidth": {
          "exclusiveMinimum": 0,
