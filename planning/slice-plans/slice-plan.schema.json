{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/slice-implementation-plan-frontmatter-1.1.json",
  "title": "Research Observatory Slice Implementation Plan Front Matter",
  "type": "object",
  "required": [
    "plan_schema_version",
    "document_type",
    "baseline",
    "supplemental_release",
    "capability_id",
    "planning_gate",
    "capability_plan",
    "slice_id",
    "title",
    "status",
    "wave",
    "priority",
    "deployment_profiles",
    "platform_targets",
    "task_ids",
    "ui_reference",
    "approval"
  ],
  "properties": {
    "plan_schema_version": {
      "const": "1.1"
    },
    "document_type": {
      "const": "slice-implementation-plan"
    },
    "baseline": {
      "type": "string"
    },
    "supplemental_release": {
      "type": "string"
    },
    "capability_id": {
      "pattern": "^CAP-[0-9]{2}$"
    },
    "slice_id": {
      "pattern": "^CAP-[0-9]{2}\\.S[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "superseded",
        "withdrawn"
      ]
    },
    "wave": {
      "pattern": "^W[0-9]+$"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "deployment_profiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "platform_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task_ids": {
      "type": "array",
      "items": {
        "pattern": "^CAP-[0-9]{2}\\.S[0-9]{2}\\.T[0-9]{2}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "ui_reference": {
      "type": "string",
      "minLength": 1
    },
    "approval": {
      "type": "object",
      "required": [
        "status",
        "approved_by",
        "approved_at",
        "approved_commit"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "superseded"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_commit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "capability_plan": {
      "type": "string",
      "pattern": "^planning/capability-plans/CAP-[0-9]{2}\\.md$"
    },
    "planning_gate": {
      "const": "capability-decision-complete"
    }
  },
  "additionalProperties": false
}
