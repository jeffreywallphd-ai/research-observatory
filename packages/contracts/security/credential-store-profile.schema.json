{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/contracts/security/credential-store-profile.schema.json",
  "title": "Research Observatory Windows credential-store profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "profileId",
    "osProtection",
    "machineScope",
    "promptMode",
    "rootIntegrity",
    "recordAuthentication",
    "physicalIdentity",
    "secretDelivery",
    "secretKinds",
    "scopeFields",
    "writeConcurrency",
    "failureMode",
    "auditProjection",
    "forbiddenSecretDestinations"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "documentType": {"const": "research-observatory-credential-store-profile"},
    "profileId": {"const": "windows-dpapi-profile-vault-v1"},
    "osProtection": {"const": "windows-current-user-dpapi"},
    "machineScope": {"const": "forbidden"},
    "promptMode": {"const": "null-prompt-ui-forbidden"},
    "rootIntegrity": {"const": "versioned-magic-length-sha256"},
    "recordAuthentication": {"const": "xchacha20poly1305-with-scope-aad"},
    "physicalIdentity": {"const": "hmac-sha256-no-plaintext-identifiers"},
    "secretDelivery": {"const": "callback-lease-zeroed-on-close"},
    "secretKinds": {
      "const": ["provider-key", "connector-token", "signing-trust", "encryption-key-material"]
    },
    "scopeFields": {"const": ["profile-id", "secret-kind", "subject-id", "name"]},
    "writeConcurrency": {"const": "cross-process-lock-create-or-compare-and-swap"},
    "failureMode": {"const": "bounded-recoverable-ciphertext-retained"},
    "auditProjection": {"const": "operation-outcome-reason-opaque-reference-only"},
    "forbiddenSecretDestinations": {
      "const": ["sqlite", "project-package", "project-export", "support-bundle", "process-arguments"]
    }
  }
}
