{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/governance-control-recovery-runtime.v5.json",
  "title": "GCR-0005 runtime documents",
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._*/-]+$"},
    "reference": {
      "type": "object", "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}, "commit": {"$ref": "#/$defs/commit"}},
      "additionalProperties": false
    },
    "finding": {
      "type": "object", "required": ["id", "severity", "blocking", "criterionIndex", "title", "reproduction", "requiredRemediation"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "severity": {"enum": ["critical", "high", "medium", "low"]},
        "blocking": {"type": "boolean"}, "criterionIndex": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1}, "reproduction": {"type": "string", "minLength": 1},
        "requiredRemediation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "closure": {
      "type": "object", "required": ["findingId", "disposition", "evidence"],
      "properties": {
        "findingId": {"type": "string", "minLength": 1}, "disposition": {"enum": ["fixed", "withdrawn"]},
        "evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object", "required": ["command", "result", "summary"],
      "properties": {
        "command": {"type": "string", "minLength": 1}, "result": {"const": "passed"},
        "summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "submission": {
      "type": "object",
      "required": ["attemptId", "submittedBy", "submittedAt", "candidateCommit", "baseCommit", "branch", "evidence", "priorAttemptId", "openFindingIds", "rootCauseAnalysis"],
      "properties": {
        "attemptId": {"type": "string", "pattern": "^R[0-9]{2}$"},
        "submittedBy": {"const": "codex"}, "submittedAt": {"type": "string", "format": "date-time"},
        "candidateCommit": {"$ref": "#/$defs/commit"}, "baseCommit": {"$ref": "#/$defs/commit"},
        "branch": {"const": "codex/w1-windows-local-runtime"},
        "evidence": {
          "type": "object", "required": ["path", "sha256", "commit"],
          "properties": {
            "path": {"type": "string", "pattern": "^artifacts/evidence/governance-control-recovery/GCR-0005\\.B00\\.R[0-9]{2}\\.json$"},
            "sha256": {"$ref": "#/$defs/sha256"}, "commit": {"$ref": "#/$defs/commit"}
          },
          "additionalProperties": false
        },
        "priorAttemptId": {"type": ["string", "null"], "pattern": "^R[0-9]{2}$"},
        "openFindingIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rootCauseAnalysis": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    },
    "bootstrapReview": {
      "type": "object",
      "required": ["reviewer", "result", "reviewedAt", "reviewedStateCommit", "notes"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "result": {"enum": ["approved", "changes-requested", "blocked"]},
        "reviewedAt": {"type": "string", "format": "date-time"},
        "reviewedStateCommit": {"$ref": "#/$defs/commit"}, "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "reviewedAttempt": {
      "type": "object",
      "required": ["submission", "review", "ledger", "findings", "closures"],
      "properties": {
        "submission": {"$ref": "#/$defs/submission"},
        "review": {"$ref": "#/$defs/bootstrapReview"},
        "ledger": {
          "type": "object", "required": ["path", "sha256", "commit"],
          "properties": {
            "path": {"type": "string", "pattern": "^planning/governance-control-recovery/GCR-0005\\.B00\\.review-R[0-9]{2}\\.json$"},
            "sha256": {"$ref": "#/$defs/sha256"}, "commit": {"$ref": "#/$defs/commit"}
          },
          "additionalProperties": false
        },
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "closures": {"type": "array", "items": {"$ref": "#/$defs/closure"}}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "attemptId", "candidateCommit", "packetSha256", "branch", "reviewer", "result", "findings", "closures", "verified", "approvalAvailable"],
      "properties": {
        "schemaVersion": {"const": "5.0-control-recovery-review"},
        "documentType": {"const": "governance-control-recovery-packet-review"},
        "controlRecoveryId": {"const": "GCR-0005"}, "attemptId": {"pattern": "^R[0-9]{2}$"},
        "candidateCommit": {"$ref": "#/$defs/commit"}, "packetSha256": {"$ref": "#/$defs/sha256"},
        "branch": {"const": "codex/w1-windows-local-runtime"}, "reviewer": {"type": "string", "minLength": 1},
        "result": {"enum": ["approved", "changes-requested", "blocked"]},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "closures": {"type": "array", "items": {"$ref": "#/$defs/closure"}},
        "verified": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "approvalAvailable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "status", "approvedBy", "approvedAt", "packet", "independentReview", "executionAuthority"],
      "properties": {
        "schemaVersion": {"const": "5.0-control-recovery-approval"},
        "documentType": {"const": "governance-control-recovery-approval"},
        "controlRecoveryId": {"const": "GCR-0005"}, "status": {"const": "APPROVED"},
        "approvedBy": {"type": "string", "minLength": 1}, "approvedAt": {"type": "string", "format": "date-time"},
        "packet": {"$ref": "#/$defs/reference"},
        "independentReview": {
          "type": "object", "required": ["reviewer", "result", "ledger", "openFindingIds"],
          "properties": {
            "reviewer": {"type": "string", "minLength": 1}, "result": {"const": "APPROVED"},
            "ledger": {"$ref": "#/$defs/reference"},
            "openFindingIds": {"type": "array", "maxItems": 0}
          },
          "additionalProperties": false
        },
        "executionAuthority": {
          "type": "object",
          "required": ["bootstrapOnly", "reviewProjection", "b02Remediation", "amendment", "task", "waveResume", "holdRelease", "gateApproval"],
          "properties": {
            "bootstrapOnly": {"const": true}, "reviewProjection": {"const": false},
            "b02Remediation": {"const": false}, "amendment": {"const": false}, "task": {"const": false},
            "waveResume": {"const": false}, "holdRelease": {"const": false}, "gateApproval": {"const": false}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "bootstrapUnit", "attemptId", "agent", "approvalCommit", "baseCommit", "candidateCommit", "branch", "changedPaths", "requiredOutcomes", "acceptanceCriteria", "checks", "closures", "unverifiedItems", "rootCauseAnalysis"],
      "properties": {
        "schemaVersion": {"const": "5.0-control-recovery-evidence"},
        "documentType": {"const": "governance-control-recovery-bootstrap-evidence"},
        "controlRecoveryId": {"const": "GCR-0005"}, "bootstrapUnit": {"const": "GCR-0005.B00"},
        "attemptId": {"pattern": "^R[0-9]{2}$"}, "agent": {"type": "string", "minLength": 1},
        "approvalCommit": {"$ref": "#/$defs/commit"}, "baseCommit": {"$ref": "#/$defs/commit"},
        "candidateCommit": {"$ref": "#/$defs/commit"}, "branch": {"const": "codex/w1-windows-local-runtime"},
        "changedPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "requiredOutcomes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["criterion", "evidence"], "properties": {"criterion": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
        "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["criterion", "evidence"], "properties": {"criterion": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "closures": {"type": "array", "items": {"$ref": "#/$defs/closure"}},
        "unverifiedItems": {"type": "array", "maxItems": 0},
        "rootCauseAnalysis": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "bootstrapUnit", "status", "approval", "attempts", "currentSubmission", "latestReviewResult", "openFindingIds", "application"],
      "properties": {
        "schemaVersion": {"const": "5.0-control-recovery-state"},
        "documentType": {"const": "governance-control-recovery-bootstrap-state"},
        "controlRecoveryId": {"const": "GCR-0005"}, "bootstrapUnit": {"const": "GCR-0005.B00"},
        "status": {"enum": ["READY", "REVIEW", "CHANGES_REQUESTED", "BLOCKED", "APPROVED", "APPLICATION_FINALIZATION", "APPLIED"]},
        "approval": {"$ref": "#/$defs/reference"},
        "attempts": {
          "type": "object",
          "patternProperties": {"^R[0-9]{2}$": {"$ref": "#/$defs/reviewedAttempt"}},
          "additionalProperties": false
        },
        "currentSubmission": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/submission"}
          ]
        },
        "latestReviewResult": {
          "oneOf": [
            {"type": "null"},
            {"enum": ["approved", "changes-requested", "blocked"]}
          ]
        },
        "openFindingIds": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^GCR-0005(?:-R[0-9]{2}|\\.B00-R[0-9]{2})-F[0-9]{2}$"}
        },
        "application": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["approvedStateCommit", "applicationEvidence", "projectionTimestamp", "backlogBeforeRawSha256", "backlogBeforeCanonicalSha256", "backlogAfterRawSha256", "backlogAfterCanonicalSha256", "ledger", "changedPaths", "ordinaryExecutionAuthority"],
              "properties": {
                "approvedStateCommit": {"$ref": "#/$defs/commit"},
                "applicationEvidence": {
                  "type": "object", "required": ["path", "sha256", "commit"],
                  "properties": {
                    "path": {"const": "artifacts/evidence/governance-control-recovery/GCR-0005.B00.application.json"},
                    "sha256": {"$ref": "#/$defs/sha256"}, "commit": {"$ref": "#/$defs/commit"}
                  },
                  "additionalProperties": false
                },
                "projectionTimestamp": {"const": "2026-08-26T02:15:00+00:00"},
                "backlogBeforeRawSha256": {"const": "431ac0390c7aa1b1be229f741cea0b00fb73cfd24713fdcb0e8cc6a13595c7a1"},
                "backlogBeforeCanonicalSha256": {"const": "3ffa93f894b5b63cbefd11d8b058eddf4deda96069aa03c9bb15bc116bc691cb"},
                "backlogAfterRawSha256": {"const": "86c40fde359bd64f0979e0a5e982fdfa13de3823b5b77afd1e5341abcc726798"},
                "backlogAfterCanonicalSha256": {"const": "86c40fde359bd64f0979e0a5e982fdfa13de3823b5b77afd1e5341abcc726798"},
                "ledger": {
                  "type": "object", "required": ["path", "sha256", "commit", "reviewedStateCommit", "result", "openFindingIds"],
                  "properties": {
                    "path": {"const": "planning/governance-recovery-approvals/GRR-0002.B02.review-R01.json"},
                    "sha256": {"const": "4b92f7b3a6a621e25c919f8571d7a87617966ae76a7dcbc4f3dcdd05af563e09"},
                    "commit": {"const": "8b784cabc5d5d996c00fd2fbcc8f22a1ad05b5bb"},
                    "reviewedStateCommit": {"const": "962f92ff831c9a3d87a7d6ba796c8194e70b6c2c"},
                    "result": {"const": "changes-requested"},
                    "openFindingIds": {"const": ["GRR-0002.B02-R01-F01"]}
                  },
                  "additionalProperties": false
                },
                "changedPaths": {
                  "const": ["docs/planning-implementation-plan.md", "planning/backlog.yaml", "planning/status-summary.md", "planning/review-site/manifest.json", "planning/review-site/recoveries/GRR-0002.html", "planning/review-site/recoveries/index.html", "planning/review-site/waves/W1.html"]
                },
                "ordinaryExecutionAuthority": {"const": false}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "READY"}}}, "then": {"properties": {"attempts": {"maxProperties": 0}, "currentSubmission": {"type": "null"}, "latestReviewResult": {"type": "null"}, "openFindingIds": {"maxItems": 0}, "application": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "REVIEW"}}}, "then": {"properties": {"currentSubmission": {"$ref": "#/$defs/submission"}, "latestReviewResult": {"type": "null"}, "application": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "CHANGES_REQUESTED"}}}, "then": {"properties": {"attempts": {"minProperties": 1}, "currentSubmission": {"type": "null"}, "latestReviewResult": {"const": "changes-requested"}, "openFindingIds": {"minItems": 1}, "application": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "BLOCKED"}}}, "then": {"properties": {"attempts": {"minProperties": 1}, "currentSubmission": {"type": "null"}, "latestReviewResult": {"const": "blocked"}, "openFindingIds": {"minItems": 1}, "application": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "APPROVED"}}}, "then": {"properties": {"attempts": {"minProperties": 1}, "currentSubmission": {"type": "null"}, "latestReviewResult": {"const": "approved"}, "openFindingIds": {"maxItems": 0}, "application": {"type": "null"}}}},
        {"if": {"properties": {"status": {"enum": ["APPLICATION_FINALIZATION", "APPLIED"]}}}, "then": {"properties": {"attempts": {"minProperties": 1}, "currentSubmission": {"type": "null"}, "latestReviewResult": {"const": "approved"}, "openFindingIds": {"maxItems": 0}, "application": {"type": "object"}}}}
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "bootstrapUnit", "attemptId", "candidateCommit", "reviewedStateCommit", "reviewer", "result", "evidence", "notes", "findings", "closures"],
      "properties": {
        "schemaVersion": {"const": "5.0-control-recovery-bootstrap-review"},
        "documentType": {"const": "governance-control-recovery-bootstrap-review"},
        "controlRecoveryId": {"const": "GCR-0005"}, "bootstrapUnit": {"const": "GCR-0005.B00"},
        "attemptId": {"pattern": "^R[0-9]{2}$"}, "candidateCommit": {"$ref": "#/$defs/commit"},
        "reviewedStateCommit": {"$ref": "#/$defs/commit"}, "reviewer": {"type": "string", "minLength": 1},
        "result": {"enum": ["approved", "changes-requested", "blocked"]},
        "evidence": {"$ref": "#/$defs/reference"}, "notes": {"type": "string"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "closures": {"type": "array", "items": {"$ref": "#/$defs/closure"}}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "bootstrapUnit", "approvedStateCommit", "applicationBaseCommit", "projectionTimestamp", "backlogBeforeRawSha256", "backlogBeforeCanonicalSha256", "backlogAfterRawSha256", "backlogAfterCanonicalSha256", "ledger", "ledgerBytePreserved", "openFindingIds", "changedPaths", "checks", "unverifiedItems", "ordinaryExecutionAuthority"],
      "properties": {
        "schemaVersion": {"const": "5.0-control-recovery-application-evidence"},
        "documentType": {"const": "governance-control-recovery-review-transition-evidence"},
        "controlRecoveryId": {"const": "GCR-0005"}, "bootstrapUnit": {"const": "GCR-0005.B00"},
        "approvedStateCommit": {"$ref": "#/$defs/commit"}, "applicationBaseCommit": {"$ref": "#/$defs/commit"},
        "projectionTimestamp": {"const": "2026-08-26T02:15:00+00:00"},
        "backlogBeforeRawSha256": {"const": "431ac0390c7aa1b1be229f741cea0b00fb73cfd24713fdcb0e8cc6a13595c7a1"},
        "backlogBeforeCanonicalSha256": {"const": "3ffa93f894b5b63cbefd11d8b058eddf4deda96069aa03c9bb15bc116bc691cb"},
        "backlogAfterRawSha256": {"const": "86c40fde359bd64f0979e0a5e982fdfa13de3823b5b77afd1e5341abcc726798"},
        "backlogAfterCanonicalSha256": {"const": "86c40fde359bd64f0979e0a5e982fdfa13de3823b5b77afd1e5341abcc726798"},
        "ledger": {
          "type": "object", "required": ["path", "sha256", "commit", "reviewedStateCommit", "candidateCommit", "evidenceSha256", "result"],
          "properties": {
            "path": {"const": "planning/governance-recovery-approvals/GRR-0002.B02.review-R01.json"},
            "sha256": {"const": "4b92f7b3a6a621e25c919f8571d7a87617966ae76a7dcbc4f3dcdd05af563e09"},
            "commit": {"const": "8b784cabc5d5d996c00fd2fbcc8f22a1ad05b5bb"},
            "reviewedStateCommit": {"const": "962f92ff831c9a3d87a7d6ba796c8194e70b6c2c"},
            "candidateCommit": {"const": "d363c04c385251a5d789a0313e173342e7e0ae3e"},
            "evidenceSha256": {"const": "77cdc545de58ef9d7237a8ba1c32969a449a87216479fd104e5649e6b5958595"},
            "result": {"const": "changes-requested"}
          },
          "additionalProperties": false
        },
        "ledgerBytePreserved": {"const": true},
        "openFindingIds": {"const": ["GRR-0002.B02-R01-F01"]},
        "changedPaths": {"const": ["docs/planning-implementation-plan.md", "planning/backlog.yaml", "planning/status-summary.md", "planning/review-site/manifest.json", "planning/review-site/recoveries/GRR-0002.html", "planning/review-site/recoveries/index.html", "planning/review-site/waves/W1.html"]},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "unverifiedItems": {"type": "array", "maxItems": 0},
        "ordinaryExecutionAuthority": {"const": false}
      },
      "additionalProperties": false
    }
  ]
}
