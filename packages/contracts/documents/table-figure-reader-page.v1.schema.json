          "title": "Columns"
        },
        "gridState": {
          "anyOf": [
            {
              "enum": [
                "reported",
                "ambiguous"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gridstate"
        },
        "cellCount": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Cellcount",
          "type": "integer"
        },
        "afterCell": {
          "anyOf": [
            {
              "exclusiveMaximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Aftercell"
        },
        "nextAfterCell": {
          "anyOf": [
            {
              "exclusiveMaximum": 10000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Nextaftercell"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/TableCellPreview"
          },
          "maxItems": 8,
          "title": "Cells",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceObservation"
        },
        "preview": {
          "$ref": "#/$defs/StructurePreview"
