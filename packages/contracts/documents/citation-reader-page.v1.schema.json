        },
        "paragraph": {
          "anyOf": [
            {
              "$ref": "#/$defs/CitationContextPreview"
            },
            {
              "type": "null"
            }
          ]
        },
        "sentence": {
          "anyOf": [
            {
              "$ref": "#/$defs/CitationContextPreview"
            },
            {
              "type": "null"
            }
