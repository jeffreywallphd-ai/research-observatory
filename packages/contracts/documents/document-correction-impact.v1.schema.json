{
  "$defs": {
    "CorrectionImpactItem": {
      "additionalProperties": false,
      "properties": {
        "revisionId": {
          "$ref": "#/$defs/Identity"
        },
        "kind": {
          "$ref": "#/$defs/Token"
        },
        "disposition": {
          "enum": [
            "stale",
            "unknown-impact",
            "informational"
          ],
          "title": "Disposition",
          "type": "string"
        }
      },
      "required": [
        "revisionId",
        "kind",
        "disposition"
      ],
      "title": "CorrectionImpactItem",
      "type": "object"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Identity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Offset": {
      "maximum": 1000000,
      "minimum": 0,
      "type": "integer"
    },
    "ProjectIdentity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Token": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectIdentity"
    },
    "baseRevisionId": {
      "$ref": "#/$defs/Identity"
    },
    "draftRevisionId": {
      "$ref": "#/$defs/Identity"
    },
    "graphSha256": {
      "$ref": "#/$defs/Digest"
    },
    "affectedCount": {
      "$ref": "#/$defs/Offset"
    },
    "informationalCount": {
      "$ref": "#/$defs/Offset"
    },
    "legacyUnreportedCount": {
      "$ref": "#/$defs/Offset"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/CorrectionImpactItem"
      },
      "maxItems": 20,
      "title": "Items",
      "type": "array"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    },
    "state": {
      "const": "prospective-rechecked-at-acceptance",
      "default": "prospective-rechecked-at-acceptance",
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "baseRevisionId",
    "draftRevisionId",
    "graphSha256",
    "affectedCount",
    "informationalCount",
    "legacyUnreportedCount",
    "items",
    "truncated"
  ],
  "title": "CorrectionImpactView",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/contracts/documents/document-correction-impact.v1.schema.json",
  "x-research-observatory-semanticRules": [
    "typed-at-most-32-operations-on-exact-base-and-expected-original-node-reference-structure-digests",
    "saved-proposals-preview-undo-and-discard-never-advance-the-accepted-head",
    "explicit-exact-draft-confirmation-appends-human-decision-fresh-elements-provenance-outbox-and-scoped-impact-atomically",
    "current-native-human-session-project-intent-privacy-source-inspect-derive-and-canonical-work-authority-through-publication-and-delivery",
    "retain-original-parser-output-source-unicode-contributors-and-history-labels-human-matches-and-machine-assertions-are-distinct",
    "authenticate-native-docling-relationships-against-original-machine-structure-before-mapping-successor-source-lineage",
    "exact-command-retry-no-duplicate-or-conflicting-command-success-cas-and-cancellation-before-commit",
    "encrypted-128-kib-record-10000-items-one-million-retained-codepoints-five-second-cooperative-transform-32-correction-generations",
    "source-fenced-bounded-pages-20-nodes-160-codepoint-previews-10-jobs-targets-drafts-and-128-kib-delivery",
    "impact-preview-is-prospective-and-rechecked-at-acceptance-not-recalculation-or-release-authority",
