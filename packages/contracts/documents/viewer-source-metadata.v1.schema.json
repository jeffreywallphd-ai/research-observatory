{
  "$defs": {
    "AcquisitionOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "remote-acquisition",
          "title": "Kind",
          "type": "string"
        },
        "locationId": {
          "$ref": "#/$defs/Identity"
        },
        "receiptSha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "kind",
        "locationId",
        "receiptSha256"
      ],
      "title": "AcquisitionOrigin",
      "type": "object"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Format": {
      "enum": [
        "jats",
        "tei",
        "xml",
        "html",
        "pdf",
        "docx",
        "plain-text"
      ],
      "type": "string"
    },
    "Identity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "LocalOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "local-import",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LocalOrigin",
      "type": "object"
    },
    "ProjectIdentity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "SourceIdentity": {
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "$ref": "#/$defs/ProjectIdentity"
        },
        "attachmentId": {
          "$ref": "#/$defs/Identity"
        },
        "documentId": {
          "$ref": "#/$defs/Identity"
        },
        "documentRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "candidateId": {
          "$ref": "#/$defs/Identity"
        },
        "sourceAssertionRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "workId": {
          "$ref": "#/$defs/Identity"
        },
        "workRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "versionId": {
          "$ref": "#/$defs/Identity"
        },
        "versionRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "objectSha256": {
          "$ref": "#/$defs/Digest"
        },
        "byteLength": {
          "maximum": 134217728,
          "minimum": 0,
          "title": "Bytelength",
          "type": "integer"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "provenance": {
          "discriminator": {
            "mapping": {
              "local-import": "#/$defs/LocalOrigin",
              "remote-acquisition": "#/$defs/AcquisitionOrigin"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/LocalOrigin"
            },
            {
              "$ref": "#/$defs/AcquisitionOrigin"
            }
          ],
          "title": "Provenance"
        }
      },
      "required": [
        "projectId",
        "attachmentId",
        "documentId",
        "documentRevisionId",
        "candidateId",
        "sourceAssertionRevisionId",
        "workId",
        "workRevisionId",
        "versionId",
        "versionRevisionId",
        "objectSha256",
        "byteLength",
        "format",
        "provenance"
      ],
      "title": "SourceIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "source": {
      "$ref": "#/$defs/SourceIdentity"
    },
    "normalizedRevisionId": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "source"
  ],
  "title": "ViewerSourceMetadata",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/contracts/documents/viewer-source-metadata.v1.schema.json",
  "x-research-observatory-semanticRules": [
    "opaque-exact-attachment-original-and-optional-distinct-accepted-normalized-revision",
    "current-native-session-project-human-intent-privacy-and-per-copy-inspect-authority",
    "source-at-most-128-mib-range-at-most-1-mib-whole-original-authentication-before-bytes",
    "no-renderer-path-url-credential-actor-policy-or-caller-owned-rights",
    "structured-text-separately-requires-current-derive-authority-at-read-and-delivery",
    "exact-accepted-revision-element-offset-and-at-most-4096-unicode-codepoints",
    "next-offset-null-or-exact-offset-plus-text-codepoints-not-utf16-or-bytes",
    "selection-metadata-and-extraction-are-not-permission-or-scholarly-verification"
  ]
}
