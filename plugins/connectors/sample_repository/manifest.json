    "sourceId": "plugin.sample.repository",
    "displayName": "Synthetic public repository sample"
  },
  "authentication": {"mode": "none"},
  "terms": {"status": "not-reported"},
  "rateLimits": {"maxRequestsPerSecond": 1, "maxConcurrent": 1},
  "entryPoint": "plugin/connector.py",
  "files": [
    {
      "path": "plugin/connector.py",
