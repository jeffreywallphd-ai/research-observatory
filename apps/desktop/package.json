{
  "name": "@research-observatory/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:intent-native": "node scripts/intent-native-integration.mjs",
    "build": "node scripts/clean-dist.mjs && vite build --config vite.product.config.ts && node scripts/assemble-application.mjs && vite build && node scripts/assemble-reference.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "tauri": "tauri",
    "sidecar:prepare": "python ../../tools/core_sidecar_build.py --repo ../.. --output artifacts/tmp/core-sidecar-package --report artifacts/tmp/core-sidecar-package.json",
    "dev": "pnpm run sidecar:prepare && tauri dev"
  },
  "dependencies": {
    "@research-observatory/contracts": "workspace:*",
    "@research-observatory/ui-components": "workspace:*",
    "@research-observatory/ui-tokens": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
