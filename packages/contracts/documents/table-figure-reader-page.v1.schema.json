        "pageNumber": {
          "anyOf": [
            {
              "maximum": 500,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pagenumber"
        }
      },
      "required": [
        "nodeId",
        "nodeKind",
        "textOffset",
        "nodeTextStart",
        "normalizedRange",
        "pageNumber"
      ],
      "title": "StructureJump",
      "type": "object"
    },
    "StructurePreview": {
      "discriminator": {
        "mapping": {
          "source-page-region": "#/$defs/OriginalStructurePreview",
          "unavailable": "#/$defs/UnavailableStructurePreview"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/OriginalStructurePreview"
        },
        {
          "$ref": "#/$defs/UnavailableStructurePreview"
        }
      ]
    },
    "StructureTextPreview": {
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/Identity"
        },
        "textPreview": {
          "maxLength": 512,
          "title": "Textpreview",
          "type": "string"
        },
        "textLength": {
          "maximum": 65536,
          "minimum": 0,
          "title": "Textlength",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "jump": {
          "$ref": "#/$defs/StructureJump"
        }
      },
      "required": [
        "nodeId",
        "textPreview",
        "textLength",
        "truncated",
        "jump"
      ],
      "title": "StructureTextPreview",
      "type": "object"
    },
    "TableCellPreview": {
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/Identity"
        },
        "textPreview": {
          "maxLength": 512,
          "title": "Textpreview",
          "type": "string"
        },
        "textLength": {
          "maximum": 65536,
          "minimum": 0,
          "title": "Textlength",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "jump": {
          "$ref": "#/$defs/StructureJump"
        },
        "cellOrder": {
          "exclusiveMaximum": 10000,
          "minimum": 0,
          "title": "Cellorder",
          "type": "integer"
        },
        "row": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "column": {
          "maximum": 100000,
          "minimum": 0,
          "title": "Column",
          "type": "integer"
        },
        "rowSpan": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Rowspan",
          "type": "integer"
        },
        "columnSpan": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Columnspan",
          "type": "integer"
        },
        "headerState": {
          "enum": [
            "reported-header",
            "reported-body",
            "not-reported"
