{
  "$defs": {
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Identity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Members": {
      "items": {
        "$ref": "#/$defs/Identity"
      },
      "maxItems": 256,
      "type": "array"
    },
    "VersionReference": {
      "additionalProperties": false,
      "properties": {
        "revisionId": {
          "$ref": "#/$defs/Identity"
        },
        "versionId": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "versionId",
        "revisionId"
      ],
      "title": "VersionReference",
      "type": "object"
    },
    "WorkState": {
      "additionalProperties": false,
      "properties": {
        "aliasTarget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "assertionRevisionIds": {
          "$ref": "#/$defs/Members"
        },
        "decisionRevisionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "disposition": {
          "enum": [
            "active",
            "alias"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "previousRevisionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "revisionId": {
          "$ref": "#/$defs/Identity"
        },
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "workId": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "workId",
        "revisionId",
        "previousRevisionId",
        "disposition",
        "aliasTarget",
        "assertionRevisionIds",
        "decisionRevisionId"
      ],
      "title": "WorkState",
      "type": "object"
    }
  },
  "$id": "https://research-observatory.local/contracts/scholarly-records/version-outcome.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "commandId": {
      "$ref": "#/$defs/Identity"
    },
    "decisionId": {
      "$ref": "#/$defs/Identity"
    },
    "decisionRevisionId": {
      "$ref": "#/$defs/Identity"
    },
    "dependencyRunIds": {
      "items": {
        "$ref": "#/$defs/Identity"
      },
      "maxItems": 264,
      "title": "Dependencyrunids",
      "type": "array"
    },
    "planSha256": {
      "$ref": "#/$defs/Digest"
    },
    "preferenceRevisionId": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identity"
        },
        {
          "type": "null"
        }
      ]
    },
    "relationRevisionId": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identity"
        },
        {
          "type": "null"
        }
      ]
    },
    "versionRevisions": {
      "items": {
        "$ref": "#/$defs/VersionReference"
      },
      "maxItems": 256,
      "title": "Versionrevisions",
      "type": "array"
    },
    "workStates": {
      "items": {
        "$ref": "#/$defs/WorkState"
      },
      "maxItems": 8,
      "title": "Workstates",
      "type": "array"
    }
  },
  "required": [
    "commandId",
    "decisionId",
    "decisionRevisionId",
    "planSha256",
    "versionRevisions",
    "relationRevisionId",
    "preferenceRevisionId",
    "workStates",
    "dependencyRunIds"
  ],
  "title": "VersionOutcome",
  "type": "object"
}
