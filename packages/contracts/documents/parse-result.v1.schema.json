{
  "$defs": {
    "AcquisitionOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "remote-acquisition",
          "title": "Kind",
          "type": "string"
        },
        "locationId": {
          "$ref": "#/$defs/Identity"
        },
        "receiptSha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "kind",
        "locationId",
        "receiptSha256"
      ],
      "title": "AcquisitionOrigin",
      "type": "object"
    },
    "CellConfidence": {
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/Token"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceObservation"
        }
      },
      "required": [
        "nodeId",
        "confidence"
      ],
      "title": "CellConfidence",
      "type": "object"
    },
    "CodepointRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/Count"
        },
        "end": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "CodepointRange",
      "type": "object"
    },
    "ConfidenceObservation": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "reported",
            "unknown",
            "not-reported",
            "not-applicable",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "state",
        "value"
      ],
      "title": "ConfidenceObservation",
      "type": "object"
    },
    "Coordinate": {
      "minimum": 0,
      "type": "number"
    },
    "Count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "DocumentIR": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "staged",
            "inspection-only"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/ParseBinding"
        },
        "normalizationVersion": {
          "const": "ro-text-nfc-1",
          "title": "Normalizationversion",
          "type": "string"
        },
        "unicodeVersion": {
          "const": "16.0.0",
          "title": "Unicodeversion",
          "type": "string"
        },
        "textProjections": {
          "items": {
            "$ref": "#/$defs/TextProjection"
          },
          "title": "Textprojections",
          "type": "array"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/SourcePage"
          },
          "maxItems": 500,
          "title": "Pages",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/IRNode"
          },
          "title": "Nodes",
          "type": "array"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/IRReference"
          },
          "title": "References",
          "type": "array"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/IRCitation"
          },
          "title": "Citations",
          "type": "array"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/IRTable"
          },
          "title": "Tables",
          "type": "array"
        },
        "figures": {
          "items": {
            "$ref": "#/$defs/IRFigure"
          },
          "title": "Figures",
          "type": "array"
        },
        "rawArtifacts": {
          "items": {
            "$ref": "#/$defs/RawParserArtifact"
          },
          "title": "Rawartifacts",
          "type": "array"
        },
        "quality": {
          "$ref": "#/$defs/ParseQualityReport"
        }
      },
      "required": [
        "schemaVersion",
        "disposition",
        "binding",
        "normalizationVersion",
        "unicodeVersion",
        "textProjections",
        "pages",
        "nodes",
        "references",
        "citations",
        "tables",
        "figures",
        "rawArtifacts",
        "quality"
      ],
      "title": "DocumentIR",
      "type": "object"
    },
    "FailureCode": {
      "enum": [
        "parser-failed",
        "parser-timeout",
        "parser-memory-limit",
        "parser-assets-unavailable",
        "parser-runtime-unavailable",
        "parse-output-invalid",
        "parse-producer-mismatch",
        "parse-source-denied",
        "parse-delivery-denied"
      ],
      "type": "string"
    },
    "Format": {
      "enum": [
        "jats",
        "tei",
        "xml",
        "html",
        "pdf",
        "docx",
        "plain-text"
      ],
      "type": "string"
    },
    "IRCitation": {
      "additionalProperties": false,
      "properties": {
        "stagedId": {
          "$ref": "#/$defs/Token"
        },
        "nodeId": {
          "$ref": "#/$defs/Token"
        },
        "marker": {
          "$ref": "#/$defs/TextSpan"
        },
        "referenceCandidates": {
          "items": {
            "$ref": "#/$defs/Token"
          },
          "title": "Referencecandidates",
          "type": "array"
        },
        "resolution": {
          "enum": [
            "candidate",
            "ambiguous",
            "unresolved"
          ],
          "title": "Resolution",
          "type": "string"
        }
      },
      "required": [
        "stagedId",
        "nodeId",
        "marker",
        "referenceCandidates",
        "resolution"
      ],
      "title": "IRCitation",
      "type": "object"
    },
    "IRFigure": {
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/Token"
        },
        "caption": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "$ref": "#/$defs/SourceLocator"
        },
        "previewStageId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "nodeId",
        "caption",
        "locator",
        "previewStageId"
      ],
      "title": "IRFigure",
      "type": "object"
    },
    "IRNode": {
      "additionalProperties": false,
      "properties": {
        "stagedId": {
          "$ref": "#/$defs/Token"
        },
        "kind": {
          "$ref": "#/$defs/NodeKind"
        },
        "order": {
          "$ref": "#/$defs/Count"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Token"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "$ref": "#/$defs/SourceLocator"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceObservation"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ParserWarning"
          },
          "title": "Warnings",
          "type": "array"
        },
        "sourceElementType": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stagedId",
        "kind",
        "order",
        "parentId",
        "text",
        "locator",
        "confidence",
        "warnings",
        "sourceElementType"
      ],
      "title": "IRNode",
      "type": "object"
    },
    "IRReference": {
      "additionalProperties": false,
      "properties": {
        "stagedId": {
          "$ref": "#/$defs/Token"
        },
        "nodeId": {
          "$ref": "#/$defs/Token"
        },
        "order": {
          "$ref": "#/$defs/Count"
        },
        "rawText": {
          "$ref": "#/$defs/TextSpan"
        },
        "identifiers": {
          "items": {
            "$ref": "#/$defs/ReferenceIdentifier"
          },
          "title": "Identifiers",
          "type": "array"
        }
      },
      "required": [
        "stagedId",
        "nodeId",
        "order",
        "rawText",
        "identifiers"
      ],
      "title": "IRReference",
      "type": "object"
    },
    "IRTable": {
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/Token"
        },
        "rows": {
          "$ref": "#/$defs/Count"
        },
        "columns": {
          "$ref": "#/$defs/Count"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/IRTableCell"
          },
          "title": "Cells",
          "type": "array"
        },
        "gridState": {
          "enum": [
            "reported",
            "ambiguous"
          ],
          "title": "Gridstate",
          "type": "string"
        }
      },
      "required": [
        "nodeId",
        "rows",
        "columns",
        "cells",
        "gridState"
      ],
      "title": "IRTable",
      "type": "object"
    },
    "IRTableCell": {
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/Token"
        },
        "row": {
          "$ref": "#/$defs/Count"
        },
        "column": {
          "$ref": "#/$defs/Count"
        },
        "rowSpan": {
          "$ref": "#/$defs/PositiveCount"
        },
        "columnSpan": {
          "$ref": "#/$defs/PositiveCount"
        },
        "rawText": {
          "$ref": "#/$defs/TextSpan"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceObservation"
        }
      },
      "required": [
        "nodeId",
        "row",
        "column",
        "rowSpan",
        "columnSpan",
        "rawText",
        "confidence"
      ],
      "title": "IRTableCell",
      "type": "object"
    },
    "Identity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "LocalOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "local-import",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LocalOrigin",
      "type": "object"
    },
    "NodeKind": {
      "enum": [
        "region",
        "title",
        "abstract",
        "section",
        "paragraph",
        "sentence",
        "list",
        "list-item",
        "footnote",
        "reference",
        "citation-marker",
        "table",
        "table-cell",
        "figure",
        "caption",
        "equation",
        "unknown"
      ],
      "type": "string"
    },
    "PageRegionLocator": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "page-region",
          "title": "Kind",
          "type": "string"
        },
        "pageIndex": {
          "exclusiveMaximum": 500,
          "minimum": 0,
          "title": "Pageindex",
          "type": "integer"
        },
        "x0": {
          "$ref": "#/$defs/Coordinate"
        },
        "y0": {
          "$ref": "#/$defs/Coordinate"
        },
        "x1": {
          "$ref": "#/$defs/Coordinate"
        },
        "y1": {
          "$ref": "#/$defs/Coordinate"
        },
        "unit": {
          "const": "points",
          "title": "Unit",
          "type": "string"
        },
        "origin": {
          "const": "top-left",
          "title": "Origin",
          "type": "string"
        },
        "frame": {
          "const": "unrotated-source-page",
          "title": "Frame",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "pageIndex",
        "x0",
        "y0",
        "x1",
        "y1",
        "unit",
        "origin",
        "frame"
      ],
      "title": "PageRegionLocator",
      "type": "object"
    },
    "ParseAttempt": {
      "additionalProperties": false,
      "properties": {
        "jobId": {
          "$ref": "#/$defs/Identity"
        },
        "attemptId": {
          "$ref": "#/$defs/Identity"
        },
        "activityVersion": {
          "$ref": "#/$defs/Token"
        }
      },
      "required": [
        "jobId",
        "attemptId",
        "activityVersion"
      ],
      "title": "ParseAttempt",
      "type": "object"
    },
    "ParseBinding": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceIdentity"
        },
        "attempt": {
          "$ref": "#/$defs/ParseAttempt"
        },
        "producer": {
          "$ref": "#/$defs/ParserDescriptor"
        },
        "selectionSha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "source",
        "attempt",
        "producer",
        "selectionSha256"
      ],
      "title": "ParseBinding",
      "type": "object"
    },
    "ParseCancelled": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "kind": {
          "const": "cancelled",
          "title": "Kind",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/ParseBinding"
        },
        "code": {
          "const": "cancelled",
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "binding",
        "code"
      ],
      "title": "ParseCancelled",
      "type": "object"
    },
    "ParseFailure": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "kind": {
          "const": "failure",
          "title": "Kind",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/ParseBinding"
        },
        "code": {
          "$ref": "#/$defs/FailureCode"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "binding",
        "code"
      ],
      "title": "ParseFailure",
      "type": "object"
    },
    "ParseQualityReport": {
      "additionalProperties": false,
      "properties": {
        "missingTextPages": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Count"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Missingtextpages"
        },
        "replacementCharacters": {
          "anyOf": [
            {
              "$ref": "#/$defs/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "readingOrder": {
          "enum": [
            "reported-order",
            "ambiguous",
            "unavailable"
          ],
          "title": "Readingorder",
          "type": "string"
        },
        "anchorCoverage": {
          "$ref": "#/$defs/ConfidenceObservation"
        },
        "unresolvedReferences": {
          "anyOf": [
            {
              "$ref": "#/$defs/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "tableCellConfidence": {
          "items": {
            "$ref": "#/$defs/CellConfidence"
          },
          "title": "Tablecellconfidence",
          "type": "array"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ParserWarning"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "missingTextPages",
        "replacementCharacters",
        "readingOrder",
        "anchorCoverage",
        "unresolvedReferences",
        "tableCellConfidence",
        "warnings"
      ],
      "title": "ParseQualityReport",
      "type": "object"
    },
    "ParseSuccess": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "kind": {
          "const": "success",
          "title": "Kind",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/ParseBinding"
        },
        "ir": {
          "$ref": "#/$defs/DocumentIR"
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "binding",
        "ir"
      ],
      "title": "ParseSuccess",
      "type": "object"
    },
    "ParserAsset": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "$ref": "#/$defs/Token"
        },
        "version": {
          "$ref": "#/$defs/Token"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "component",
        "version",
        "sha256"
      ],
      "title": "ParserAsset",
      "type": "object"
    },
    "ParserDescriptor": {
      "additionalProperties": false,
      "properties": {
        "parserId": {
          "$ref": "#/$defs/Token"
        },
        "version": {
          "$ref": "#/$defs/Token"
        },
        "kind": {
          "enum": [
            "native",
            "docling-cpu",
            "degraded-inspection"
          ],
          "title": "Kind",
          "type": "string"
        },
        "inputFormats": {
          "items": {
            "$ref": "#/$defs/Format"
          },
          "minItems": 1,
          "title": "Inputformats",
          "type": "array"
        },
        "configurationVersion": {
          "$ref": "#/$defs/Token"
        },
        "configurationSha256": {
          "$ref": "#/$defs/Digest"
        },
        "assets": {
          "items": {
            "$ref": "#/$defs/ParserAsset"
          },
          "title": "Assets",
          "type": "array"
        }
      },
      "required": [
        "parserId",
        "version",
        "kind",
        "inputFormats",
        "configurationVersion",
        "configurationSha256",
        "assets"
      ],
      "title": "ParserDescriptor",
      "type": "object"
    },
    "ParserWarning": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/Token"
        },
        "severity": {
          "enum": [
            "information",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "nodeId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Token"
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "severity",
        "nodeId",
        "detail"
      ],
      "title": "ParserWarning",
      "type": "object"
    },
    "PositiveCount": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "ProjectIdentity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "RawParserArtifact": {
      "additionalProperties": false,
      "properties": {
        "stageId": {
          "$ref": "#/$defs/Identity"
        },
        "objectSha256": {
          "$ref": "#/$defs/Digest"
        },
        "byteLength": {
          "$ref": "#/$defs/Count"
        },
        "mediaType": {
          "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$",
          "title": "Mediatype",
          "type": "string"
        }
      },
      "required": [
        "stageId",
        "objectSha256",
        "byteLength",
        "mediaType"
      ],
      "title": "RawParserArtifact",
      "type": "object"
    },
    "ReferenceIdentifier": {
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "$ref": "#/$defs/Token"
        },
        "observed": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "scheme",
        "observed"
      ],
      "title": "ReferenceIdentifier",
      "type": "object"
    },
    "SourceIdentity": {
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "$ref": "#/$defs/ProjectIdentity"
        },
        "attachmentId": {
          "$ref": "#/$defs/Identity"
        },
        "documentId": {
          "$ref": "#/$defs/Identity"
        },
        "documentRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "candidateId": {
          "$ref": "#/$defs/Identity"
        },
        "sourceAssertionRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "workId": {
          "$ref": "#/$defs/Identity"
        },
        "workRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "versionId": {
          "$ref": "#/$defs/Identity"
        },
        "versionRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "objectSha256": {
          "$ref": "#/$defs/Digest"
        },
        "byteLength": {
          "maximum": 134217728,
          "minimum": 0,
          "title": "Bytelength",
          "type": "integer"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "provenance": {
          "discriminator": {
            "mapping": {
              "local-import": "#/$defs/LocalOrigin",
              "remote-acquisition": "#/$defs/AcquisitionOrigin"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/LocalOrigin"
            },
            {
              "$ref": "#/$defs/AcquisitionOrigin"
            }
          ],
          "title": "Provenance"
        }
      },
      "required": [
        "projectId",
        "attachmentId",
        "documentId",
        "documentRevisionId",
        "candidateId",
        "sourceAssertionRevisionId",
        "workId",
        "workRevisionId",
        "versionId",
        "versionRevisionId",
        "objectSha256",
        "byteLength",
        "format",
