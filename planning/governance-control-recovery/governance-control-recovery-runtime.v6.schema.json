{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/governance-control-recovery-runtime.v6.json",
  "title": "GCR-0006 exact runtime envelopes",
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._*/-]+$"},
    "reference": {
      "type": "object", "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}, "commit": {"$ref": "#/$defs/commit"}},
      "additionalProperties": false
    },
    "witness": {
      "type": "object", "required": ["path", "sha256", "untracked", "unstaged", "executionAuthority"],
      "properties": {
        "path": {"const": "artifacts/evidence/W1.A04.B00.json"},
        "sha256": {"const": "4a9d944ff95972b449b617bc384306c7023e79d31d6b427e6b6f4678cd58b22c"},
        "untracked": {"const": true}, "unstaged": {"const": true}, "executionAuthority": {"const": false}
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object", "required": ["command", "result", "evidence"],
      "properties": {"command": {"type": "string", "minLength": 1}, "result": {"const": "passed"}, "evidence": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "finding": {
      "type": "object", "required": ["id", "severity", "criterion", "description", "reproduction", "blocking"],
      "properties": {
        "id": {"type": "string", "pattern": "^GCR-0006(?:-R[0-9]{2}|\\.B00-R[0-9]{2})-F[0-9]{2}$"},
        "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
        "criterion": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1},
        "reproduction": {"type": "string", "minLength": 1}, "blocking": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "closure": {
      "type": "object", "required": ["findingId", "disposition", "evidence"],
      "properties": {"findingId": {"type": "string", "pattern": "^GCR-0006(?:-R[0-9]{2}|\\.B00-R[0-9]{2})-F[0-9]{2}$"}, "disposition": {"const": "closed"}, "evidence": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "submission": {
      "type": "object",
      "required": ["attemptId", "agent", "approvalCommit", "baseCommit", "candidateCommit", "branch", "evidence", "changedPaths"],
      "properties": {
        "attemptId": {"pattern": "^R[0-9]{2}$"}, "agent": {"const": "codex"},
        "approvalCommit": {"$ref": "#/$defs/commit"}, "baseCommit": {"$ref": "#/$defs/commit"}, "candidateCommit": {"$ref": "#/$defs/commit"},
        "branch": {"const": "codex/w1-windows-local-runtime"}, "evidence": {"$ref": "#/$defs/reference"},
        "changedPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object", "required": ["submission", "reviewedStateCommit", "review", "ledger"],
      "properties": {
        "submission": {"$ref": "#/$defs/submission"}, "reviewedStateCommit": {"$ref": "#/$defs/commit"},
        "review": {"type": "object", "required": ["reviewer", "result", "notes", "findings", "closures"], "properties": {"reviewer": {"type": "string", "minLength": 1}, "result": {"enum": ["approved", "changes-requested", "blocked"]}, "notes": {"type": "string"}, "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}, "closures": {"type": "array", "items": {"$ref": "#/$defs/closure"}}}, "additionalProperties": false},
        "ledger": {"$ref": "#/$defs/reference"}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "packetCommit", "packetSha256", "packetReview", "authorityManifest", "witness", "approver", "approvedAt", "scope", "ordinaryExecutionAuthority"],
      "properties": {
        "schemaVersion": {"const": "6.0-control-recovery-approval"},
        "documentType": {"const": "governance-control-recovery-approval"},
        "controlRecoveryId": {"const": "GCR-0006"}, "packetCommit": {"$ref": "#/$defs/commit"}, "packetSha256": {"$ref": "#/$defs/sha256"},
        "packetReview": {"$ref": "#/$defs/reference"}, "authorityManifest": {"$ref": "#/$defs/reference"}, "witness": {"$ref": "#/$defs/witness"},
        "approver": {"type": "string", "minLength": 1}, "approvedAt": {"$ref": "#/$defs/timestamp"},
        "scope": {"const": "GCR-0006.B00 reader-headroom bootstrap only"}, "ordinaryExecutionAuthority": {"const": false}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "attemptId", "candidateCommit", "packetSha256", "branch", "reviewer", "result", "findings", "closures", "verified", "approvalAvailable"],
      "properties": {
        "schemaVersion": {"const": "6.0-control-recovery-review"}, "documentType": {"const": "governance-control-recovery-packet-review"},
        "controlRecoveryId": {"const": "GCR-0006"}, "attemptId": {"pattern": "^R[0-9]{2}$"},
        "candidateCommit": {"$ref": "#/$defs/commit"}, "packetSha256": {"$ref": "#/$defs/sha256"},
        "branch": {"const": "codex/w1-windows-local-runtime"}, "reviewer": {"type": "string", "minLength": 1},
        "result": {"enum": ["approved", "changes-requested", "blocked"]}, "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "closures": {"type": "array", "items": {"$ref": "#/$defs/closure"}}, "verified": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "approvalAvailable": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"result": {"const": "approved"}}}, "then": {"properties": {"findings": {"maxItems": 0}, "approvalAvailable": {"const": true}}}},
        {"if": {"properties": {"result": {"enum": ["changes-requested", "blocked"]}}}, "then": {"properties": {"findings": {"minItems": 1}, "approvalAvailable": {"const": false}}}}
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "bootstrapUnit", "status", "approval", "attempts", "currentSubmission", "latestReviewResult", "openFindingIds", "activation"],
      "properties": {
        "schemaVersion": {"const": "6.0-control-recovery-state"}, "documentType": {"const": "governance-control-recovery-bootstrap-state"},
        "controlRecoveryId": {"const": "GCR-0006"}, "bootstrapUnit": {"const": "GCR-0006.B00"},
        "status": {"enum": ["READY", "REVIEW", "CHANGES_REQUESTED", "BLOCKED", "APPROVED", "HEADROOM_ACTIVATION_FINALIZATION", "HEADROOM_ACTIVE"]},
        "approval": {"$ref": "#/$defs/reference"},
        "attempts": {"type": "object", "patternProperties": {"^R[0-9]{2}$": {"$ref": "#/$defs/attempt"}}, "additionalProperties": false},
        "currentSubmission": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/submission"}]},
        "latestReviewResult": {"oneOf": [{"type": "null"}, {"enum": ["approved", "changes-requested", "blocked"]}]},
        "openFindingIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^GCR-0006\\.B00-R[0-9]{2}-F[0-9]{2}$"}},
        "activation": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["approvedStateCommit", "adoptionEvidence", "predecessorRevision", "successorRevision", "supportedControlCeiling", "generationNeutral", "finalizationCommit", "changedPaths", "ordinaryExecutionAuthority"], "properties": {"approvedStateCommit": {"$ref": "#/$defs/commit"}, "adoptionEvidence": {"$ref": "#/$defs/reference"}, "predecessorRevision": {"const": 11}, "successorRevision": {"const": 11}, "supportedControlCeiling": {"const": 12}, "generationNeutral": {"const": true}, "finalizationCommit": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/commit"}]}, "changedPaths": {"const": ["planning/backlog.yaml", "planning/governance-control-recovery/GCR-0006.B00.state.json"]}, "ordinaryExecutionAuthority": {"const": false}}, "additionalProperties": false}]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "READY"}}}, "then": {"properties": {"attempts": {"maxProperties": 0}, "currentSubmission": {"type": "null"}, "latestReviewResult": {"type": "null"}, "openFindingIds": {"maxItems": 0}, "activation": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "REVIEW"}}}, "then": {"properties": {"currentSubmission": {"$ref": "#/$defs/submission"}, "latestReviewResult": {"type": "null"}, "activation": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "APPROVED"}}}, "then": {"properties": {"attempts": {"minProperties": 1}, "currentSubmission": {"type": "null"}, "latestReviewResult": {"const": "approved"}, "openFindingIds": {"maxItems": 0}, "activation": {"type": "null"}}}},
        {"if": {"properties": {"status": {"enum": ["HEADROOM_ACTIVATION_FINALIZATION", "HEADROOM_ACTIVE"]}}}, "then": {"properties": {"attempts": {"minProperties": 1}, "currentSubmission": {"type": "null"}, "latestReviewResult": {"const": "approved"}, "openFindingIds": {"maxItems": 0}, "activation": {"type": "object"}}}}
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "bootstrapUnit", "attemptId", "agent", "approvalCommit", "baseCommit", "candidateCommit", "branch", "changedPaths", "requiredOutcomes", "acceptanceCriteria", "checks", "closures", "unverifiedItems", "rootCauseAnalysis"],
      "properties": {
        "schemaVersion": {"const": "6.0-control-recovery-evidence"}, "documentType": {"const": "governance-control-recovery-bootstrap-evidence"},
        "controlRecoveryId": {"const": "GCR-0006"}, "bootstrapUnit": {"const": "GCR-0006.B00"}, "attemptId": {"pattern": "^R[0-9]{2}$"},
        "agent": {"const": "codex"}, "approvalCommit": {"$ref": "#/$defs/commit"}, "baseCommit": {"$ref": "#/$defs/commit"}, "candidateCommit": {"$ref": "#/$defs/commit"},
        "branch": {"const": "codex/w1-windows-local-runtime"}, "changedPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "requiredOutcomes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["criterion", "evidence"], "properties": {"criterion": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
        "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["criterion", "evidence"], "properties": {"criterion": {"type": "string", "minLength": 1}, "evidence": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}, "closures": {"type": "array", "items": {"$ref": "#/$defs/closure"}},
        "unverifiedItems": {"type": "array", "maxItems": 0}, "rootCauseAnalysis": {"type": ["object", "null"]}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "bootstrapUnit", "attemptId", "candidateCommit", "reviewedStateCommit", "reviewer", "result", "evidence", "notes", "findings", "closures"],
      "properties": {
        "schemaVersion": {"const": "6.0-control-recovery-bootstrap-review"}, "documentType": {"const": "governance-control-recovery-bootstrap-review"},
        "controlRecoveryId": {"const": "GCR-0006"}, "bootstrapUnit": {"const": "GCR-0006.B00"}, "attemptId": {"pattern": "^R[0-9]{2}$"},
        "candidateCommit": {"$ref": "#/$defs/commit"}, "reviewedStateCommit": {"$ref": "#/$defs/commit"}, "reviewer": {"type": "string", "minLength": 1},
        "result": {"enum": ["approved", "changes-requested", "blocked"]}, "evidence": {"$ref": "#/$defs/reference"}, "notes": {"type": "string"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}, "closures": {"type": "array", "items": {"$ref": "#/$defs/closure"}}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "bootstrapUnit", "approvedStateCommit", "adoptionEvidenceCommit", "predecessorRevision", "successorRevision", "supportedControlCeiling", "generationNeutral", "backlogBeforeRawSha256", "backlogAfterRawSha256", "changedPaths", "checks", "unverifiedItems", "ordinaryExecutionAuthority"],
      "properties": {
        "schemaVersion": {"const": "6.0-control-recovery-adoption-evidence"}, "documentType": {"const": "governance-control-recovery-headroom-adoption-evidence"},
        "controlRecoveryId": {"const": "GCR-0006"}, "bootstrapUnit": {"const": "GCR-0006.B00"}, "approvedStateCommit": {"$ref": "#/$defs/commit"}, "adoptionEvidenceCommit": {"$ref": "#/$defs/commit"},
        "predecessorRevision": {"const": 11}, "successorRevision": {"const": 11}, "supportedControlCeiling": {"const": 12}, "generationNeutral": {"const": true},
        "backlogBeforeRawSha256": {"$ref": "#/$defs/sha256"}, "backlogAfterRawSha256": {"$ref": "#/$defs/sha256"},
        "changedPaths": {"const": ["planning/backlog.yaml", "planning/governance-control-recovery/GCR-0006.B00.state.json"]},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}}, "unverifiedItems": {"type": "array", "maxItems": 0}, "ordinaryExecutionAuthority": {"const": false}
      },
      "additionalProperties": false
    }
  ]
}
