{
  "schemaVersion": "1.0",
  "documentType": "research-observatory-credential-store-profile",
  "profileId": "windows-dpapi-profile-vault-v1",
  "osProtection": "windows-current-user-dpapi",
  "machineScope": "forbidden",
  "promptMode": "null-prompt-ui-forbidden",
  "rootIntegrity": "versioned-magic-length-sha256",
  "recordAuthentication": "xchacha20poly1305-with-scope-aad",
  "physicalIdentity": "hmac-sha256-no-plaintext-identifiers",
  "secretDelivery": "callback-lease-zeroed-on-close",
  "secretKinds": ["provider-key", "connector-token", "signing-trust", "encryption-key-material"],
  "scopeFields": ["profile-id", "secret-kind", "subject-id", "name"],
  "writeConcurrency": "cross-process-lock-create-or-compare-and-swap",
  "failureMode": "bounded-recoverable-ciphertext-retained",
  "auditProjection": "capability-purpose-operation-outcome-reason-context-opaque-reference-only",
  "forbiddenSecretDestinations": ["sqlite", "project-package", "project-export", "support-bundle", "process-arguments"]
}
