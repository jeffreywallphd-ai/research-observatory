        "x0": {
          "$ref": "#/$defs/UnitCoordinate"
        },
        "y0": {
          "$ref": "#/$defs/UnitCoordinate"
        },
        "x1": {
          "$ref": "#/$defs/UnitCoordinate"
        },
        "y1": {
          "$ref": "#/$defs/UnitCoordinate"
        },
        "sourceWidth": {
          "exclusiveMinimum": 0,
          "title": "Sourcewidth",
          "type": "number"
        },
        "sourceHeight": {
          "exclusiveMinimum": 0,
          "title": "Sourceheight",
          "type": "number"
        },
        "rotation": {
          "enum": [
            0,
            90,
            180,
            270
          ],
          "title": "Rotation",
          "type": "integer"
        },
        "frame": {
          "const": "unrotated-source-page",
          "default": "unrotated-source-page",
          "title": "Frame",
          "type": "string"
        },
        "origin": {
          "const": "top-left",
          "default": "top-left",
          "title": "Origin",
          "type": "string"
        },
        "unit": {
          "const": "normalized",
          "default": "normalized",
          "title": "Unit",
          "type": "string"
        },
        "granularity": {
          "const": "block",
          "default": "block",
          "title": "Granularity",
          "type": "string"
        }
      },
      "required": [
        "pageIndex",
        "pageNumber",
        "x0",
        "y0",
        "x1",
        "y1",
        "sourceWidth",
        "sourceHeight",
        "rotation"
      ],
      "title": "NormalizedPageRegion",
      "type": "object"
    },
    "ProjectIdentity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
