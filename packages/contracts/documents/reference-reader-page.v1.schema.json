          "type": "string"
        },
        "origin": {
          "const": "top-left",
          "default": "top-left",
          "title": "Origin",
          "type": "string"
        },
        "unit": {
          "const": "normalized",
          "default": "normalized",
          "title": "Unit",
          "type": "string"
