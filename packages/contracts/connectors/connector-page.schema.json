{
  "$defs": {
    "ApiVersion": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
      "type": "string"
    },
    "BoundedText": {
      "maxLength": 65536,
      "minLength": 1,
      "type": "string"
    },
    "CacheObservation": {
      "additionalProperties": false,
      "properties": {
        "ageMs": {
          "anyOf": [
            {
              "$ref": "#/$defs/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestSha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestDigest"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "disabled",
            "miss",
            "hit",
            "revalidated",
            "not-permitted"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "ageMs",
        "requestSha256"
      ],
      "title": "CacheObservation",
      "type": "object"
    },
    "CitationQuery": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "citations",
            "references"
          ],
          "title": "Direction",
          "type": "string"
        },
        "kind": {
          "const": "citations",
          "title": "Kind",
          "type": "string"
        },
        "seed": {
          "$ref": "#/$defs/ProviderIdentifier"
        }
      },
      "required": [
        "kind",
        "seed",
        "direction"
      ],
      "title": "CitationQuery",
      "type": "object"
    },
    "ConnectorCursor": {
      "additionalProperties": false,
      "properties": {
        "expiresAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcInstant"
            },
            {
              "type": "null"
            }
          ]
        },
        "pageIndex": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Pageindex",
          "type": "integer"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "providerId": {
          "$ref": "#/$defs/ProviderId"
        },
        "requestSha256": {
          "$ref": "#/$defs/RequestDigest"
        },
        "value": {
          "$ref": "#/$defs/IdentifierValue"
        }
      },
      "required": [
        "providerId",
        "projectId",
        "requestSha256",
        "pageIndex",
        "value",
        "expiresAt"
      ],
      "title": "ConnectorCursor",
      "type": "object"
    },
    "ConnectorError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "retryAfterMs": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetryAfter"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable",
        "retryAfterMs"
      ],
      "title": "ConnectorError",
      "type": "object"
    },
    "ConnectorPolicy": {
      "additionalProperties": false,
      "description": "Ceilings and requested behavior, never a current policy/rights grant.",
      "properties": {
        "cacheMode": {
          "enum": [
            "bypass",
            "revalidate",
            "allow-fresh"
          ],
          "title": "Cachemode",
          "type": "string"
        },
        "maxInflight": {
          "maximum": 1,
          "minimum": 1,
          "title": "Maxinflight",
          "type": "integer"
        },
        "maximumAttempts": {
          "maximum": 3,
          "minimum": 1,
          "title": "Maximumattempts",
          "type": "integer"
        },
        "maximumFreshAgeMs": {
          "maximum": 86400000,
          "minimum": 0,
          "title": "Maximumfreshagems",
          "type": "integer"
        },
        "maximumResponseBytes": {
          "maximum": 10485760,
          "minimum": 1,
          "title": "Maximumresponsebytes",
          "type": "integer"
        },
        "maximumRetryAfterMs": {
          "$ref": "#/$defs/RetryAfter"
        },
        "minimumIntervalMs": {
          "maximum": 86400000,
          "minimum": 1000,
          "title": "Minimumintervalms",
          "type": "integer"
        },
        "rawRetention": {
          "enum": [
            "if-permitted",
            "permitted-fields-only",
            "do-not-retain"
          ],
          "title": "Rawretention",
          "type": "string"
        },
        "timeoutMs": {
          "maximum": 30000,
          "minimum": 1,
          "title": "Timeoutms",
          "type": "integer"
        }
      },
      "required": [
        "maxInflight",
        "minimumIntervalMs",
        "maximumAttempts",
        "timeoutMs",
        "maximumResponseBytes",
        "maximumRetryAfterMs",
        "cacheMode",
        "maximumFreshAgeMs",
        "rawRetention"
      ],
      "title": "ConnectorPolicy",
      "type": "object"
    },
    "ConnectorRecord": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/SourceField"
          },
          "maxItems": 256,
          "title": "Fields",
          "type": "array"
        },
        "identifiers": {
          "items": {
            "$ref": "#/$defs/ProviderIdentifier"
          },
          "maxItems": 64,
          "title": "Identifiers",
          "type": "array"
        },
        "providerId": {
          "$ref": "#/$defs/ProviderId"
        },
        "rawIdentifier": {
          "$ref": "#/$defs/ProviderIdentifier"
        },
        "retrievedAt": {
          "$ref": "#/$defs/UtcInstant"
        },
        "terms": {
          "$ref": "#/$defs/SourceTerms"
        }
      },
      "required": [
        "providerId",
        "rawIdentifier",
        "identifiers",
        "retrievedAt",
        "fields",
        "terms"
      ],
      "title": "ConnectorRecord",
      "type": "object"
    },
    "ConnectorRequest": {
      "additionalProperties": false,
      "properties": {
        "adapterVersion": {
          "$ref": "#/$defs/Version"
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConnectorCursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "invocationId": {
          "$ref": "#/$defs/InvocationId"
        },
        "pageSize": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Pagesize",
          "type": "integer"
        },
        "policy": {
          "$ref": "#/$defs/ConnectorPolicy"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectId"
        },
        "providerId": {
          "$ref": "#/$defs/ProviderId"
        },
        "query": {
          "$ref": "#/$defs/ScientificQuery"
        },
        "schemaVersion": {
          "const": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "sourceApiVersion": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApiVersion"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "projectId",
        "invocationId",
        "providerId",
        "adapterVersion",
        "sourceApiVersion",
        "query",
        "pageSize",
        "cursor",
        "policy"
      ],
      "title": "ConnectorRequest",
      "type": "object"
    },
    "Count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "ErrorCode": {
      "enum": [
        "authentication",
        "permission-denied",
        "rate-limit",
        "provider-unavailable",
        "timeout",
        "invalid-query",
        "incompatible-response",
        "policy-denied",
        "cancelled",
        "not-configured",
        "unsupported-operation",
        "invalid-cursor",
        "partial-response",
        "response-too-large"
      ],
      "type": "string"
    },
    "IdentifierValue": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "InvocationId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "LookupQuery": {
      "additionalProperties": false,
      "properties": {
        "identifiers": {
          "items": {
            "$ref": "#/$defs/ProviderIdentifier"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Identifiers",
          "type": "array"
        },
        "kind": {
          "const": "lookup",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "identifiers"
      ],
      "title": "LookupQuery",
      "type": "object"
    },
    "OaQuery": {
      "additionalProperties": false,
      "properties": {
        "identifier": {
          "$ref": "#/$defs/ProviderIdentifier"
        },
        "kind": {
          "const": "oa-resolution",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "identifier"
      ],
      "title": "OaQuery",
      "type": "object"
    },
    "ObjectDigest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ProjectId": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ProviderId": {
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "type": "string"
    },
    "ProviderIdentifier": {
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "$ref": "#/$defs/ProviderId"
        },
        "value": {
          "$ref": "#/$defs/IdentifierValue"
        }
      },
      "required": [
        "scheme",
        "value"
      ],
      "title": "ProviderIdentifier",
      "type": "object"
    },
    "RateLimitState": {
      "additionalProperties": false,
      "properties": {
        "circuit": {
          "enum": [
            "closed",
            "open",
            "half-open",
            "unknown"
          ],
          "title": "Circuit",
          "type": "string"
        },
        "observedAt": {
          "$ref": "#/$defs/UtcInstant"
        },
        "providerId": {
          "$ref": "#/$defs/ProviderId"
        },
        "remaining": {
          "anyOf": [
            {
              "$ref": "#/$defs/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryAfterMs": {
          "anyOf": [
            {
              "$ref": "#/$defs/RetryAfter"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "providerId",
        "observedAt",
        "remaining",
        "retryAfterMs",
        "circuit"
      ],
      "title": "RateLimitState",
      "type": "object"
    },
    "RecommendationQuery": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "recommendations",
          "title": "Kind",
          "type": "string"
        },
        "negativeSeeds": {
          "items": {
            "$ref": "#/$defs/ProviderIdentifier"
          },
          "maxItems": 100,
          "title": "Negativeseeds",
          "type": "array"
        },
        "positiveSeeds": {
          "items": {
            "$ref": "#/$defs/ProviderIdentifier"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Positiveseeds",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "positiveSeeds",
        "negativeSeeds"
      ],
      "title": "RecommendationQuery",
      "type": "object"
    },
    "RequestDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "ResponseRetention": {
      "additionalProperties": false,
      "description": "Sanitized scientific response identity, never the credential-bearing wire body.",
      "properties": {
        "bodyState": {
          "enum": [
            "retained",
            "permitted-fields-only",
            "unavailable"
          ],
          "title": "Bodystate",
          "type": "string"
        },
        "byteLength": {
          "anyOf": [
            {
              "maximum": 10485760,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bytelength"
        },
        "contentSha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectDigest"
            },
            {
              "type": "null"
            }
          ]
        },
        "objectSha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectDigest"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "enum": [
            "permitted",
            "provider-terms",
            "policy",
            "not-retained",
            "not-received",
            "not-attempted"
          ],
          "title": "Reason",
          "type": "string"
        },
        "redaction": {
          "enum": [
            "applied",
            "not-required",
            "unavailable"
          ],
          "title": "Redaction",
          "type": "string"
        }
      },
      "required": [
        "bodyState",
        "objectSha256",
        "contentSha256",
        "byteLength",
        "redaction",
        "reason"
      ],
      "title": "ResponseRetention",
      "type": "object"
    },
    "RetryAfter": {
      "maximum": 300000,
      "minimum": 0,
      "type": "integer"
    },
    "ScientificQuery": {
      "discriminator": {
        "mapping": {
          "citations": "#/$defs/CitationQuery",
          "lookup": "#/$defs/LookupQuery",
          "oa-resolution": "#/$defs/OaQuery",
          "recommendations": "#/$defs/RecommendationQuery",
          "search": "#/$defs/SearchQuery"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SearchQuery"
        },
        {
          "$ref": "#/$defs/LookupQuery"
        },
        {
          "$ref": "#/$defs/CitationQuery"
        },
        {
          "$ref": "#/$defs/RecommendationQuery"
        },
        {
          "$ref": "#/$defs/OaQuery"
        }
      ]
    },
    "SearchFilter": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "publication-year",
            "author-id",
            "source-id",
            "work-type",
            "language",
            "open-access"
          ],
          "title": "Field",
          "type": "string"
        },
        "operator": {
          "enum": [
            "eq",
            "gte",
            "lte"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/IdentifierValue"
        }
      },
      "required": [
        "field",
        "operator",
        "value"
      ],
      "title": "SearchFilter",
      "type": "object"
    },
    "SearchQuery": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "enum": [
            "any",
            "title",
            "abstract"
          ],
          "title": "Field",
          "type": "string"
        },
        "fields": {
          "items": {
            "enum": [
              "title",
              "authors",
              "date",
              "venue",
              "identifiers",
              "abstract",
              "references",
              "rights"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "title": "Fields",
          "type": "array"
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/SearchFilter"
          },
          "maxItems": 32,
          "title": "Filters",
          "type": "array"
        },
        "kind": {
          "const": "search",
          "title": "Kind",
          "type": "string"
        },
        "sort": {
          "items": {
            "$ref": "#/$defs/SearchSort"
          },
          "maxItems": 3,
          "title": "Sort",
          "type": "array"
        },
        "text": {
          "$ref": "#/$defs/BoundedText"
        }
      },
      "required": [
        "kind",
        "text",
        "field",
        "filters",
        "sort",
        "fields"
      ],
      "title": "SearchQuery",
      "type": "object"
    },
    "SearchSort": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "enum": [
            "ascending",
            "descending"
          ],
          "title": "Direction",
          "type": "string"
        },
        "field": {
          "enum": [
            "relevance",
            "publication-date",
            "citation-count"
          ],
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "field",
        "direction"
      ],
      "title": "SearchSort",
      "type": "object"
    },
    "SourceField": {
      "additionalProperties": false,
      "properties": {
        "encoding": {
          "enum": [
            "text",
            "json"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "$ref": "#/$defs/ProviderId"
        },
        "value": {
          "maxLength": 65536,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "name",
        "encoding",
        "value"
      ],
      "title": "SourceField",
      "type": "object"
    },
    "SourceObservation": {
      "additionalProperties": false,
      "description": "A source-reported value or explicit absence; never a permission decision.",
      "properties": {
        "state": {
          "enum": [
            "reported",
            "not-reported",
            "unknown",
            "not-applicable"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundedText"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "value"
      ],
      "title": "SourceObservation",
      "type": "object"
    },
    "SourceTerms": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "enum": [
            "open",
            "closed",
            "unknown",
            "not-reported"
          ],
          "title": "Access",
          "type": "string"
        },
        "license": {
          "$ref": "#/$defs/SourceObservation"
        },
        "terms": {
          "$ref": "#/$defs/SourceObservation"
        }
      },
      "required": [
        "license",
        "terms",
        "access"
      ],
      "title": "SourceTerms",
      "type": "object"
    },
    "UtcInstant": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "type": "string"
    },
    "Version": {
      "maxLength": 128,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$",
      "type": "string"
    }
  },
  "$id": "https://research-observatory.local/contracts/connectors/connector-page.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cache": {
      "$ref": "#/$defs/CacheObservation"
    },
    "continuation": {
      "enum": [
        "exhausted",
        "next-page",
        "retry-current",
        "unavailable"
      ],
      "title": "Continuation",
      "type": "string"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/ConnectorError"
      },
      "maxItems": 16,
      "title": "Errors",
      "type": "array"
    },
    "nextCursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConnectorCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "observationId": {
      "$ref": "#/$defs/InvocationId"
    },
    "observedAt": {
      "$ref": "#/$defs/UtcInstant"
    },
    "outcome": {
      "enum": [
        "complete",
        "partial",
        "failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "rate": {
      "$ref": "#/$defs/RateLimitState"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/ConnectorRecord"
      },
      "maxItems": 1000,
      "title": "Records",
      "type": "array"
    },
    "request": {
      "$ref": "#/$defs/ConnectorRequest"
    },
    "response": {
      "$ref": "#/$defs/ResponseRetention"
    },
    "retrievedAt": {
      "anyOf": [
        {
          "$ref": "#/$defs/UtcInstant"
        },
        {
          "type": "null"
        }
      ]
    },
    "schemaVersion": {
      "const": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "terms": {
      "$ref": "#/$defs/SourceTerms"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/ProviderId"
      },
      "maxItems": 32,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "observationId",
    "request",
    "observedAt",
    "retrievedAt",
    "terms",
    "outcome",
    "continuation",
    "nextCursor",
    "records",
    "errors",
    "warnings",
    "rate",
    "response",
    "cache"
  ],
  "title": "ConnectorResultPage",
  "type": "object"
}
