{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/governance-control-recovery-request.v2.json",
  "title": "Governance control-recovery request packet v2",
  "type": "object",
  "required": [
    "$schema", "schemaVersion", "documentType", "controlRecoveryId", "title", "targetWave",
    "status", "executionState", "classification", "rootAuthority", "authorityChain",
    "triggerEvidence", "activationBoundary", "generationTransition", "lifecycle", "bootstrapUnit",
    "acceptanceCriteria", "verificationObligations", "rollback", "alternatives", "files",
    "requiredApprovalStatement"
  ],
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._*/-]+$"},
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reference": {
      "type": "object", "required": ["path", "sha256", "commit"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}, "commit": {"$ref": "#/$defs/commit"}},
      "additionalProperties": false
    },
    "file": {
      "type": "object", "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}},
      "additionalProperties": false
    },
    "witness": {
      "type": "object",
      "required": ["path", "sha256", "role", "mustRemainUntrackedAndUnstaged", "neverExecutionAuthority"],
      "properties": {
        "path": {"const": "artifacts/evidence/W1.A04.B00.json"},
        "sha256": {"const": "4a9d944ff95972b449b617bc384306c7023e79d31d6b427e6b6f4678cd58b22c"},
        "role": {"const": "atomic-failure-trigger-only"},
        "mustRemainUntrackedAndUnstaged": {"const": true},
        "neverExecutionAuthority": {"const": true}
      }, "additionalProperties": false
    }
  },
  "properties": {
    "$schema": {"const": "./governance-control-recovery-request.v2.schema.json"},
    "schemaVersion": {"const": "2.0-control-recovery-proposal"},
    "documentType": {"const": "governance-control-recovery-request-packet"},
    "controlRecoveryId": {"const": "GCR-0002"},
    "title": {"type": "string", "minLength": 1},
    "targetWave": {"const": "W1"},
    "status": {"const": "pending-human-approval"},
    "executionState": {"const": "non-executable"},
    "classification": {"const": "recovery-controller-generation-defect"},
    "rootAuthority": {
      "type": "object",
      "required": ["basis", "exceptionScope", "packetReviewHistory", "approvalSchema", "approvalPath", "authorityManifest", "untrackedTriggerWitness", "approvalIntroduction"],
      "properties": {
        "basis": {"const": "repository-owner-governance-mismatch-protocol"},
        "exceptionScope": {"const": "one-time-exact-packet-bootstrap-only"},
        "packetReviewHistory": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "approvalSchema": {"$ref": "#/$defs/file"},
        "approvalPath": {"const": "planning/governance-control-recovery/GCR-0002.approval.json"},
        "authorityManifest": {"$ref": "#/$defs/file"},
        "untrackedTriggerWitness": {"$ref": "#/$defs/witness"},
        "approvalIntroduction": {
          "type": "object", "required": ["exclusiveCreate", "trackedCleanExactBranchHead", "permittedUntracked", "packetReviewApproved", "introductionCommitIsExecutionBase"],
          "properties": {
            "exclusiveCreate": {"const": true}, "trackedCleanExactBranchHead": {"const": true},
            "permittedUntracked": {"const": "exact-trigger-witness-only"}, "packetReviewApproved": {"const": true},
            "introductionCommitIsExecutionBase": {"const": true}
          }, "additionalProperties": false
        }
      }, "additionalProperties": false
    },
    "authorityChain": {
      "type": "object", "required": ["activeRecovery", "installedControlRecovery", "latestSupplement", "approvedRepairAmendment", "blockedBootstrap"],
      "properties": {
        "activeRecovery": {"$ref": "#/$defs/file"},
        "installedControlRecovery": {"$ref": "#/$defs/file"},
        "latestSupplement": {"$ref": "#/$defs/file"},
        "approvedRepairAmendment": {"$ref": "#/$defs/file"},
        "blockedBootstrap": {
          "type": "object", "required": ["id", "approvalCommit", "candidateCommit", "triggerPath", "triggerSha256"],
          "properties": {
            "id": {"const": "W1.A04.B00"}, "approvalCommit": {"$ref": "#/$defs/commit"},
            "candidateCommit": {"$ref": "#/$defs/commit"}, "triggerPath": {"const": "artifacts/evidence/W1.A04.B00.json"},
            "triggerSha256": {"$ref": "#/$defs/sha256"}
          }, "additionalProperties": false
        }
      }, "additionalProperties": false
    },
    "triggerEvidence": {
      "type": "object", "required": ["discoveryCommit", "backlogSha256", "failedCommand", "diagnostic", "atomicNoMutation", "independentAudit"],
      "properties": {
        "discoveryCommit": {"$ref": "#/$defs/commit"}, "backlogSha256": {"$ref": "#/$defs/sha256"},
        "failedCommand": {"type": "string", "minLength": 1}, "diagnostic": {"type": "string", "minLength": 1},
        "atomicNoMutation": {"const": true}, "independentAudit": {"type": "string", "minLength": 1}
      }, "additionalProperties": false
    },
    "activationBoundary": {
      "type": "object", "required": ["controlRevision", "minimumToolRevision", "holdId", "holdStatus", "waveStatus", "waveScope", "taskId", "taskStatus", "amendmentId", "amendmentBacklogStatus", "releaseGate", "releaseGateStatus"],
      "properties": {
        "controlRevision": {"const": 8}, "minimumToolRevision": {"const": 8},
        "holdId": {"const": "HOLD-W1-GRR-0002"}, "holdStatus": {"const": "ACTIVE"},
        "waveStatus": {"const": "PAUSED"}, "waveScope": {"const": "wave"},
        "taskId": {"const": "CAP-02.S04.T03"}, "taskStatus": {"const": "BLOCKED"},
        "amendmentId": {"const": "W1.A04"}, "amendmentBacklogStatus": {"const": "ABSENT"},
        "releaseGate": {"const": "G1"}, "releaseGateStatus": {"const": "PENDING"}
      }, "additionalProperties": false
    },
    "generationTransition": {
      "type": "object", "required": ["predecessorControlRevision", "nextControlRevision", "existingHoldPreserved", "newHoldCreated", "installationMode", "postBootstrapGate"],
      "properties": {
        "predecessorControlRevision": {"const": 8}, "nextControlRevision": {"const": 9},
        "existingHoldPreserved": {"const": true}, "newHoldCreated": {"const": false},
        "installationMode": {"const": "exact-packet-root-bootstrap"},
        "postBootstrapGate": {"const": "independently-reviewed-and-exactly-approved-GRR-0002.S02"}
      }, "additionalProperties": false
    },
    "lifecycle": {
      "type": "object", "required": ["branch", "actor", "workspaceInvariant", "canonicalPaths", "submission", "review", "remediation", "adoption", "commands"],
      "properties": {
        "branch": {"const": "codex/w1-windows-local-runtime"}, "actor": {"const": "codex"},
        "workspaceInvariant": {
          "type": "object", "required": ["triggerWitness", "denyOtherUntracked", "denyWitnessStagingOrMutation", "appliesAtEveryTransition"],
          "properties": {"triggerWitness": {"$ref": "#/$defs/witness"}, "denyOtherUntracked": {"const": true}, "denyWitnessStagingOrMutation": {"const": true}, "appliesAtEveryTransition": {"const": true}},
          "additionalProperties": false
        },
        "canonicalPaths": {
          "type": "object", "required": ["controller", "state", "evidencePattern", "reviewPattern", "adoptionEvidence"],
          "properties": {"controller": {"const": "tools/gcr2ctl.py"}, "state": {"const": "planning/governance-control-recovery/GCR-0002.B00.state.json"}, "evidencePattern": {"$ref": "#/$defs/path"}, "reviewPattern": {"$ref": "#/$defs/path"}, "adoptionEvidence": {"$ref": "#/$defs/path"}},
          "additionalProperties": false
        },
        "submission": {
          "type": "object", "required": ["base", "candidateAncestry", "trackedCleanBranchAndHead", "pathComparison", "staleWriter", "atomicFailure", "liveRevisionDuringReview", "untrackedException"],
          "properties": {"base": {"const": "approval-introduction-commit"}, "candidateAncestry": {"const": "strict-descendant"}, "trackedCleanBranchAndHead": {"const": true}, "pathComparison": {"const": "approval-base-to-candidate-exact-allowlist"}, "staleWriter": {"const": "compare-and-swap"}, "atomicFailure": {"const": "byte-stable"}, "liveRevisionDuringReview": {"const": 8}, "untrackedException": {"const": "exact-trigger-witness-plus-canonical-current-attempt-evidence"}},
          "additionalProperties": false
        },
        "review": {"type": "object", "required": ["independent", "severityRanked", "reviewedStateBinding", "immutableAttempts", "blockingFindingDenial", "selfReviewDenied"], "properties": {"independent": {"const": true}, "severityRanked": {"const": true}, "reviewedStateBinding": {"const": true}, "immutableAttempts": {"const": true}, "blockingFindingDenial": {"const": true}, "selfReviewDenied": {"const": true}}, "additionalProperties": false},
        "remediation": {"type": "object", "required": ["candidateAncestry", "freshEvidence", "explicitClosures", "priorAttemptsPreserved"], "properties": {"candidateAncestry": {"const": "strict-descendant-of-prior-candidate"}, "freshEvidence": {"const": true}, "explicitClosures": {"const": true}, "priorAttemptsPreserved": {"const": true}}, "additionalProperties": false},
        "adoption": {
          "type": "object", "required": ["requiresApprovedB00", "predecessorRevision", "successorRevision", "singleGenerationRecord", "directChildOfEvidenceCommit", "exactChangedPaths", "olderReadersFailClosed", "postAdoptionGate"],
          "properties": {"requiresApprovedB00": {"const": true}, "predecessorRevision": {"const": 8}, "successorRevision": {"const": 9}, "singleGenerationRecord": {"const": true}, "directChildOfEvidenceCommit": {"const": true}, "exactChangedPaths": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}, "olderReadersFailClosed": {"const": true}, "postAdoptionGate": {"const": "separate-GRR-0002.S02-review-and-exact-approval"}},
          "additionalProperties": false
        },
        "commands": {"type": "object", "required": ["submit", "review", "resubmit", "adopt", "validate"], "properties": {"submit": {"type": "string", "minLength": 1}, "review": {"type": "string", "minLength": 1}, "resubmit": {"type": "string", "minLength": 1}, "adopt": {"type": "string", "minLength": 1}, "validate": {"type": "string", "minLength": 1}}, "additionalProperties": false}
      }, "additionalProperties": false
    },
    "bootstrapUnit": {
      "type": "object", "required": ["id", "kind", "exceptionReason", "authorizedPaths", "requiredOutcomes", "prohibitedOutcomes"],
      "properties": {"id": {"const": "GCR-0002.B00"}, "kind": {"const": "one-time-recovery-controller-generation"}, "exceptionReason": {"type": "string", "minLength": 1}, "authorizedPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}, "requiredOutcomes": {"$ref": "#/$defs/strings"}, "prohibitedOutcomes": {"$ref": "#/$defs/strings"}},
      "additionalProperties": false
    },
    "acceptanceCriteria": {"$ref": "#/$defs/strings"}, "verificationObligations": {"$ref": "#/$defs/strings"}, "rollback": {"$ref": "#/$defs/strings"},
    "alternatives": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["id", "title", "disposition", "consequence"], "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "disposition": {"enum": ["recommended", "safe", "rejected"]}, "consequence": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "files": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/file"}},
    "requiredApprovalStatement": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
