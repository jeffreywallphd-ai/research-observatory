          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceObservation"
        },
        "triage": {
          "enum": [
            "low-confidence",
            "unknown-confidence",
            "reported-confidence"
          ],
          "title": "Triage",
          "type": "string"
        }
      },
      "required": [
        "nodeId",
        "textPreview",
        "textLength",
        "truncated",
        "jump",
        "cellOrder",
        "row",
        "column",
        "rowSpan",
        "columnSpan",
        "headerState",
        "confidence",
        "triage"
      ],
      "title": "TableCellPreview",
      "type": "object"
    },
    "TableFigureExclusion": {
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/Identity"
        },
        "actorId": {
          "$ref": "#/$defs/Identity"
        },
        "commandId": {
          "$ref": "#/$defs/Identity"
        },
        "rationale": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "occurredAt": {
          "$ref": "#/$defs/Instant"
        }
      },
      "required": [
        "nodeId",
        "actorId",
        "commandId",
        "rationale",
        "occurredAt"
      ],
      "title": "TableFigureExclusion",
      "type": "object"
    },
    "TableFigureReaderEntry": {
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/Identity"
