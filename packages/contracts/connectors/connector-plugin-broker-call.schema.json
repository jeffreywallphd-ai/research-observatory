{
  "$defs": {
    "Operation": {
      "enum": [
        "lookup",
        "search",
        "references",
        "citations",
        "open-access-locations",
        "repository-metadata"
      ],
      "type": "string"
    },
    "Scope": {
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "type": "string"
    }
  },
  "$id": "https://research-observatory.local/contracts/connectors/connector-plugin-broker-call.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Scientific parameters are operation-specific; arbitrary HTTP is absent.",
  "properties": {
    "credentialScope": {
      "anyOf": [
        {
          "$ref": "#/$defs/Scope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cursor": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cursor"
    },
    "identifier": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Identifier"
    },
    "operation": {
      "$ref": "#/$defs/Operation"
    },
    "pageSize": {
      "anyOf": [
        {
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pagesize"
    },
    "query": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Query"
    },
    "repositoryId": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repositoryid"
    }
  },
  "required": [
    "operation"
  ],
  "title": "PluginBrokerCall",
  "type": "object"
}
