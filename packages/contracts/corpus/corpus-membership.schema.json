{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/contracts/corpus/corpus-membership.schema.json",
  "title": "Research Observatory corpus membership documents",
  "description": "Portable T01 projection, immutable discovery path, and consequential decision; Core resolves authority and commits them atomically.",
  "x-research-observatory-semanticRules": [
    "identity-and-revision-distinct",
    "initial-candidate-pending-with-unknown-availability-no-duplicate-or-decision",
    "later-revision-requires-decision",
    "discovery-path-ids-sorted-unique",
    "discovery-kind-has-exact-typed-source",
    "discovery-edge-direction-time-and-predecessor",
    "decision-identities-and-values-distinct",
    "decision-evidence-sorted-unique",
    "work-target-only-for-work-reference",
    "decision-time-is-real-canonical-utc-milliseconds"
  ],
  "x-research-observatory-membershipLifecycle": {
    "sourcePath": "packages/contracts/domain/domain-lifecycle.v1.json",
    "sourceSha256": "99386404ed393d385f223680a2dbafba10c995eadfc1e0c4d912e180322c5125",
    "profileVersion": "1.0.0",
    "subjectKind": "corpus-item",
    "initialState": "candidate",
    "terminalStates": ["withdrawn"],
    "transitions": [
      { "command": "include", "from": "candidate", "to": "included" },
      { "command": "exclude", "from": "candidate", "to": "excluded" },
      { "command": "reconsider", "from": "included", "to": "candidate" },
      { "command": "reconsider", "from": "excluded", "to": "candidate" },
      { "command": "withdraw", "from": "candidate", "to": "withdrawn" },
      { "command": "withdraw", "from": "included", "to": "withdrawn" },
      { "command": "withdraw", "from": "excluded", "to": "withdrawn" }
    ]
  },
  "oneOf": [
    { "$ref": "#/$defs/CorpusItemRevision" },
    { "$ref": "#/$defs/DiscoveryPath" },
    { "$ref": "#/$defs/CorpusDecision" }
  ],
  "$defs": {
    "UuidV7": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])" },
    "ProjectId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])" },
    "Digest": { "type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])" },
    "NullableUuidV7": { "anyOf": [{ "$ref": "#/$defs/UuidV7" }, { "type": "null" }] },
    "NullableDigest": { "anyOf": [{ "$ref": "#/$defs/Digest" }, { "type": "null" }] },
    "NullableOrdinal": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 200000 }, { "type": "null" }] },
    "Membership": { "enum": ["candidate", "included", "excluded", "withdrawn"] },
    "Review": { "enum": ["none", "pending"] },
    "Availability": { "enum": ["unknown", "not-applicable", "available", "unavailable"] },
    "Dimension": { "enum": ["membership", "review", "duplicate", "availability", "discovery", "work-reference"] },
    "DiscoveryKind": { "enum": ["import-member", "connector-record", "citation", "recommendation", "manual"] },
    "CommandCode": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])" },
    "DecisionValue": { "type": "string", "minLength": 1, "maxLength": 64 },
    "UtcMillis": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])" },
    "CorpusItemRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "contractVersion", "documentType", "projectId", "itemId", "revisionId", "previousRevisionId", "workId", "workRevisionId", "membership", "review", "duplicateOfItemId", "availability", "discoveryPathIds", "decisionRevisionId"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "contractVersion": { "const": "1.0.0" },
        "documentType": { "const": "research-observatory-corpus-item-revision" },
        "projectId": { "$ref": "#/$defs/ProjectId" },
        "itemId": { "$ref": "#/$defs/UuidV7" },
        "revisionId": { "$ref": "#/$defs/UuidV7" },
        "previousRevisionId": { "$ref": "#/$defs/NullableUuidV7" },
        "workId": { "$ref": "#/$defs/UuidV7" },
        "workRevisionId": { "$ref": "#/$defs/UuidV7" },
        "membership": { "$ref": "#/$defs/Membership" },
        "review": { "$ref": "#/$defs/Review" },
        "duplicateOfItemId": { "$ref": "#/$defs/NullableUuidV7" },
        "availability": { "$ref": "#/$defs/Availability" },
        "discoveryPathIds": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/UuidV7" } },
        "decisionRevisionId": { "$ref": "#/$defs/NullableUuidV7" }
      }
    },
    "DiscoveryPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "contractVersion", "documentType", "pathId", "projectId", "itemId", "kind", "sourceRevisionId", "direction", "occurredAt", "predecessorItemRevisionId", "contextId", "contextRevisionId", "ordinal", "recordKeySha256", "queryRevisionId", "citingWorkRevisionId", "recommendationRevisionId", "manualDecisionRevisionId"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "contractVersion": { "const": "1.0.0" },
        "documentType": { "const": "research-observatory-discovery-path" },
        "pathId": { "$ref": "#/$defs/UuidV7" },
        "projectId": { "$ref": "#/$defs/ProjectId" },
        "itemId": { "$ref": "#/$defs/UuidV7" },
        "kind": { "$ref": "#/$defs/DiscoveryKind" },
        "sourceRevisionId": { "$ref": "#/$defs/UuidV7" },
        "direction": { "const": "source-to-corpus-item" },
        "occurredAt": { "$ref": "#/$defs/UtcMillis" },
        "predecessorItemRevisionId": { "$ref": "#/$defs/NullableUuidV7" },
        "contextId": { "$ref": "#/$defs/UuidV7" },
        "contextRevisionId": { "$ref": "#/$defs/UuidV7" },
        "ordinal": { "$ref": "#/$defs/NullableOrdinal" },
        "recordKeySha256": { "$ref": "#/$defs/NullableDigest" },
        "queryRevisionId": { "$ref": "#/$defs/NullableUuidV7" },
        "citingWorkRevisionId": { "$ref": "#/$defs/NullableUuidV7" },
        "recommendationRevisionId": { "$ref": "#/$defs/NullableUuidV7" },
        "manualDecisionRevisionId": { "$ref": "#/$defs/NullableUuidV7" }
      }
    },
    "CorpusDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "contractVersion", "documentType", "decisionId", "projectId", "itemId", "previousRevisionId", "nextRevisionId", "dimension", "command", "previousValue", "nextValue", "previousDecisionRevisionId", "supersedesDecisionRevisionId", "nextWorkId", "actorId", "reasonCode", "protocolRevisionId", "evidenceRevisionIds", "occurredAt"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "contractVersion": { "const": "1.0.0" },
        "documentType": { "const": "research-observatory-corpus-decision" },
        "decisionId": { "$ref": "#/$defs/UuidV7" },
        "projectId": { "$ref": "#/$defs/ProjectId" },
        "itemId": { "$ref": "#/$defs/UuidV7" },
        "previousRevisionId": { "$ref": "#/$defs/UuidV7" },
        "nextRevisionId": { "$ref": "#/$defs/UuidV7" },
        "dimension": { "$ref": "#/$defs/Dimension" },
        "command": { "$ref": "#/$defs/CommandCode" },
        "previousValue": { "$ref": "#/$defs/DecisionValue" },
        "nextValue": { "$ref": "#/$defs/DecisionValue" },
        "previousDecisionRevisionId": { "$ref": "#/$defs/NullableUuidV7" },
        "supersedesDecisionRevisionId": { "$ref": "#/$defs/NullableUuidV7" },
        "nextWorkId": { "$ref": "#/$defs/NullableUuidV7" },
        "actorId": { "$ref": "#/$defs/UuidV7" },
        "reasonCode": { "$ref": "#/$defs/CommandCode" },
        "protocolRevisionId": { "$ref": "#/$defs/UuidV7" },
        "evidenceRevisionIds": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/UuidV7" } },
        "occurredAt": { "$ref": "#/$defs/UtcMillis" }
      }
    }
  }
}
