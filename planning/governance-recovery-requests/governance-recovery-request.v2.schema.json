{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/governance-recovery-request.packet.v2.json",
  "title": "Generic governance recovery request packet",
  "type": "object",
  "required": [
    "$schema", "schemaVersion", "documentType", "recoveryRequestId", "title", "targetWave", "status",
    "executionState", "classification", "authorityChain", "controlHold", "bootstrapUnit", "postBootstrap",
    "acceptanceCriteria", "verificationObligations", "approvalRequirements", "files"
  ],
  "properties": {
    "$schema": {"const": "./governance-recovery-request.v2.schema.json"},
    "schemaVersion": {"const": "2.0-recovery-proposal"},
    "documentType": {"const": "governance-recovery-request-packet"},
    "recoveryRequestId": {"$ref": "#/$defs/grr"},
    "title": {"type": "string", "minLength": 1},
    "targetWave": {"$ref": "#/$defs/wave"},
    "status": {"const": "pending-human-approval"},
    "executionState": {"const": "non-executable"},
    "classification": {"const": "control-plane-recovery"},
    "authorityChain": {
      "type": "object",
      "required": ["waveBase", "orderedAmendments"],
      "properties": {
        "waveBase": {
          "type": "object", "required": ["waveId", "packetCommit", "approvalRecordCommit"],
          "properties": {
            "waveId": {"$ref": "#/$defs/wave"},
            "packetCommit": {"$ref": "#/$defs/commit"},
            "approvalRecordCommit": {"$ref": "#/$defs/commit"}
          },
          "additionalProperties": false
        },
        "orderedAmendments": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "required": ["id", "status", "packetCommit", "approvalRecord", "effectiveStateCommit"],
            "properties": {
              "id": {"$ref": "#/$defs/amendment"},
              "changeRequestId": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ecr"}]},
              "status": {"const": "ADOPTED"},
              "packetCommit": {"$ref": "#/$defs/commit"},
              "approvalRecord": {"$ref": "#/$defs/fileReference"},
              "effectiveStateCommit": {"$ref": "#/$defs/commit"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "controlHold": {
      "type": "object", "required": ["id", "commandsDenied", "releaseConditions"],
      "properties": {
        "id": {"type": "string", "pattern": "^HOLD-W(?:[0-9]|1[01])-GRR-[0-9]{4}$"},
        "commandsDenied": {"$ref": "#/$defs/nonEmptyStrings"},
        "releaseConditions": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "additionalProperties": false
    },
    "bootstrapUnit": {
      "type": "object", "required": ["id", "authorizedPaths", "requiredOutcomes", "prohibitedOutcomes"],
      "properties": {
        "id": {"type": "string", "pattern": "^GRR-[0-9]{4}\\.B[0-9]{2}$"},
        "authorizedPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/scopedPath"}},
        "requiredOutcomes": {"$ref": "#/$defs/nonEmptyStrings"},
        "prohibitedOutcomes": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "additionalProperties": true
    },
    "postBootstrap": {
      "type": "object",
      "required": ["requiredChangeRequestId", "requiredAmendmentId", "requiredProposedTaskIds", "postBootstrapExecutionAuthority", "ordinaryWaveResumeAuthorized"],
      "properties": {
        "requiredChangeRequestId": {"$ref": "#/$defs/ecr"},
        "requiredAmendmentId": {"$ref": "#/$defs/amendment"},
        "requiredProposedTaskIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/task"}},
        "postBootstrapExecutionAuthority": {"const": false},
        "ordinaryWaveResumeAuthorized": {"const": false}
      },
      "additionalProperties": false
    },
    "acceptanceCriteria": {"$ref": "#/$defs/nonEmptyStrings"},
    "verificationObligations": {"$ref": "#/$defs/nonEmptyStrings"},
    "approvalRequirements": {
      "type": "object", "required": ["independentReview", "humanApproval", "exactCommitRequired", "selfApprovalDenied"],
      "properties": {
        "independentReview": {"const": "control-and-security"},
        "humanApproval": {"const": "explicit-repository-owner"},
        "exactCommitRequired": {"const": true},
        "selfApprovalDenied": {"const": true}
      },
      "additionalProperties": false
    },
    "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/fileReference"}}
  },
  "$defs": {
    "wave": {"type": "string", "pattern": "^W(?:[0-9]|1[01])$"},
    "grr": {"type": "string", "pattern": "^GRR-[0-9]{4}$"},
    "ecr": {"type": "string", "pattern": "^ECR-[0-9]{4}$"},
    "amendment": {"type": "string", "pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}$"},
    "task": {"type": "string", "pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}\\.T[0-9]{2}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+$"},
    "scopedPath": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._*/-]+$"},
    "fileReference": {
      "type": "object", "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "introductionCommit": {"$ref": "#/$defs/commit"},
        "role": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": true
}
