{
  "$defs": {
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "IdentifierAssertion": {
      "additionalProperties": false,
      "properties": {
        "activeForMatching": {
          "default": true,
          "title": "Activeformatching",
          "type": "boolean"
        },
        "observed": {
          "maxLength": 65536,
          "title": "Observed",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/SourceOrigin",
          "default": "observed"
        },
        "reassignmentObserved": {
          "default": false,
          "title": "Reassignmentobserved",
          "type": "boolean"
        },
        "role": {
          "default": "subject",
          "enum": [
            "subject",
            "person",
            "organization",
            "container",
            "location"
          ],
          "title": "Role",
          "type": "string"
        },
        "scheme": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "title": "Scheme",
          "type": "string"
        },
        "sourceEncoding": {
          "default": "text",
          "enum": [
            "text",
            "json-string",
            "bibtex-literal"
          ],
          "title": "Sourceencoding",
          "type": "string"
        },
        "sourceSelector": {
          "default": "observed-value",
          "maxLength": 128,
          "minLength": 1,
          "title": "Sourceselector",
          "type": "string"
        },
        "verificationState": {
          "$ref": "#/$defs/VerificationState",
          "default": "unverified"
        }
      },
      "required": [
        "scheme",
        "observed"
      ],
      "title": "IdentifierAssertion",
      "type": "object"
    },
    "Identity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ImportPermission": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "default": "not-reported",
          "enum": [
            "not-reported",
            "researcher-confirmed"
          ],
          "title": "Basis",
          "type": "string"
        },
        "value": {
          "default": "unknown",
          "enum": [
            "permitted",
            "denied",
            "unknown"
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "title": "ImportPermission",
      "type": "object"
    },
    "ImportRights": {
      "additionalProperties": false,
      "properties": {
        "derive": {
          "$ref": "#/$defs/ImportPermission"
        },
        "export": {
          "$ref": "#/$defs/ImportPermission"
        },
        "index": {
          "$ref": "#/$defs/ImportPermission"
        },
        "inspect": {
          "$ref": "#/$defs/ImportPermission"
        },
        "model-use": {
          "$ref": "#/$defs/ImportPermission"
        },
        "quote": {
          "$ref": "#/$defs/ImportPermission"
        },
        "share": {
          "$ref": "#/$defs/ImportPermission"
        },
        "store": {
          "$ref": "#/$defs/ImportPermission"
        }
      },
      "title": "ImportRights",
      "type": "object"
    },
    "Members": {
      "items": {
        "$ref": "#/$defs/Identity"
      },
      "maxItems": 256,
      "type": "array"
    },
    "ProjectIdentity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ReviewSource": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "$ref": "#/$defs/SourceAssertion"
        },
        "assertionRevisionId": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "assertionRevisionId",
        "assertion"
      ],
      "title": "ReviewSource",
      "type": "object"
    },
    "ScholarlyField": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "observed": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Observed",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/SourceOrigin"
        },
        "sourceSelector": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Sourceselector",
          "type": "string"
        }
      },
      "required": [
        "name",
        "observed",
        "origin",
        "sourceSelector"
      ],
      "title": "ScholarlyField",
      "type": "object"
    },
    "SourceAddress": {
      "additionalProperties": false,
      "properties": {
        "contextId": {
          "$ref": "#/$defs/Identity"
        },
        "kind": {
          "enum": [
            "import-member",
            "connector-record"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ordinal": {
          "maximum": 200000,
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "recordKey": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "revisionId": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "kind",
        "contextId",
        "revisionId",
        "ordinal",
        "recordKey"
      ],
      "title": "SourceAddress",
      "type": "object"
    },
    "SourceAssertion": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "$ref": "#/$defs/SourceAddress"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/ScholarlyField"
          },
          "maxItems": 256,
          "title": "Fields",
          "type": "array"
        },
        "identifiers": {
          "items": {
            "$ref": "#/$defs/IdentifierAssertion"
          },
          "maxItems": 128,
          "title": "Identifiers",
          "type": "array"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectIdentity"
        },
        "provider": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "title": "Provider",
          "type": "string"
        },
        "rights": {
          "$ref": "#/$defs/ImportRights"
        },
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "sourceRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "sourceSha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "projectId",
        "address",
        "sourceRevisionId",
        "provider",
        "identifiers",
        "fields",
        "rights",
        "sourceSha256"
      ],
      "title": "SourceAssertion",
      "type": "object"
    },
    "SourceOrigin": {
      "enum": [
        "observed",
        "correction"
      ],
      "type": "string"
    },
    "VerificationState": {
      "enum": [
        "unverified",
        "verified",
        "disputed",
        "invalid"
      ],
      "type": "string"
    },
    "WorkState": {
      "additionalProperties": false,
      "properties": {
        "aliasTarget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "assertionRevisionIds": {
          "$ref": "#/$defs/Members"
        },
        "decisionRevisionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "disposition": {
          "enum": [
            "active",
            "alias"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "previousRevisionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "revisionId": {
          "$ref": "#/$defs/Identity"
        },
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "workId": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "workId",
        "revisionId",
        "previousRevisionId",
        "disposition",
        "aliasTarget",
        "assertionRevisionIds",
        "decisionRevisionId"
      ],
      "title": "WorkState",
      "type": "object"
    }
  },
  "$id": "https://research-observatory.local/contracts/scholarly-records/review-context.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "default": "scholarly-duplicate-ranking/1.0.0",
      "title": "Algorithm",
      "type": "string"
    },
    "configurationSha256": {
      "$ref": "#/$defs/Digest",
      "default": "b3e04c16bcfbb8588a718d55a94217a21a02ba1877fa9ea6ba187ebcdfc98dfc"
    },
    "evidenceSha256": {
      "readOnly": true,
      "title": "Evidencesha256",
      "type": "string"
    },
    "featureVersion": {
      "default": "scholarly-duplicate-features/1.0.0",
      "title": "Featureversion",
      "type": "string"
    },
    "inboundAliases": {
      "items": {
        "$ref": "#/$defs/WorkState"
      },
      "maxItems": 256,
      "title": "Inboundaliases",
      "type": "array"
    },
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/ReviewSource"
      },
      "maxItems": 512,
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "unassignedAssertionRevisionIds": {
      "$ref": "#/$defs/Members"
    },
    "works": {
      "items": {
        "$ref": "#/$defs/WorkState"
      },
      "maxItems": 32,
      "title": "Works",
      "type": "array"
    }
  },
  "required": [
    "works",
    "unassignedAssertionRevisionIds",
    "inboundAliases",
    "sources",
    "evidenceSha256"
  ],
  "title": "ReviewContext",
  "type": "object"
}
