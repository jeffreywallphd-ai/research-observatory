{
  "schemaVersion": "1.1",
  "documentType": "coding-agent-operating-contract",
  "authorities": [
    "AGENTS.md",
    "docs/README.md",
    "planning/README.md",
    "docs/automation/project-automation-guide.md",
    "docs/automation/codex-tracking-guide.md"
  ],
  "campaign": {
    "approvalUnit": "capability-decisions-once-and-active-wave-slices-at-one-immutable-commit",
    "partialApprovalStartsCampaign": false,
    "executionUnit": "durable-capability-wave-increment",
    "resumeAfterOrdinaryInterruption": true,
    "routineSliceApprovalPrompts": false,
    "terminalOutcome": "active-wave-slices-approved-and-production-ready-increment-qualified",
    "permittedPauseConditions": [
      "approved-choice-infeasible",
      "consequential-new-evidence",
      "required-external-resource-unavailable",
      "higher-authority-conflict",
      "governed-experience-change-required",
      "destructive-external-or-material-spend-authorization",
      "explicit-user-direction",
      "approved-wave-increment-complete"
    ]
  },
  "selection": {
    "scope": "active-capability-wave-increment-only",
    "eligibleState": "READY",
    "dependencyPolicy": "all-task-slice-wave-and-release-gate-dependencies-satisfied",
    "inspectCommands": [
      "python tools/taskctl.py --file planning/backlog.yaml next --profile LOC --platform windows-x64",
      "python tools/taskctl.py --file planning/backlog.yaml show CAP-XX.SXX.TXX"
    ],
    "claimCommand": "python tools/taskctl.py --file planning/backlog.yaml claim CAP-XX.SXX.TXX --agent <agent> --branch <branch> --base-sha <sha> --worktree <path> --profile LOC --platform windows-x64"
  },
  "scopeControl": {
    "permitted": [
      "task-objective",
      "task-deliverables",
      "task-acceptance-criteria",
      "dependency-compatible-supporting-changes",
      "required-tests-contracts-docs-migrations-and-audit"
    ],
    "prohibited": [
      "unclaimed-adjacent-task",
      "unapproved-architecture-or-experience-change",
      "gated-later-wave-implementation",
      "test-weakening",
      "remote-push-or-publication-without-authority"
    ]
  },
  "verification": {
    "requiredSources": [
      "task-verification-commands",
      "task-verification-profiles",
      "changed-path-impact-map",
      "architecture-and-experience-contracts-when-affected"
    ],
    "selectionPolicy": "credible-failure-likelihood-and-changed-path-impact",
    "taskDefault": "focused-affected-checks",
    "fullProfileStage": "slice-integration-review",
    "completeMatrixStage": "capability-qualification",
    "earlyFullProfileConditions": [
      "explicit-task-acceptance-criterion",
      "shared-verification-build-security-or-toolchain-profile-wide-impact",
      "dependency-or-runtime-change-crosses-profile-boundary",
      "failure-cannot-be-safely-localized"
    ],
    "breadthRationaleRequiredInEvidence": true,
    "exactCommitRequired": true,
    "failurePolicy": "remain-in-progress-and-fix-within-approved-scope"
  },
  "completion": {
    "orderedSteps": [
      "commit-bounded-implementation",
      "criterion-linked-machine-evidence",
      "task-submit",
      "required-independent-review",
      "clean-tested-fast-forward-to-local-main",
      "slice-end-to-end-evidence-and-review-when-last-task",
      "continue-next-ready-task-or-wave-increment-qualification"
    ],
    "remotePushAuthorized": false,
    "gateBypassAllowed": false
  },
  "capabilityQualification": [
    "happy-path",
    "failure-and-denial",
    "cancellation",
    "migration",
    "restart-and-recovery",
    "security-privacy-and-rights",
    "accessibility",
    "performance",
    "required-platforms",
    "independent-capability-review"
  ]
}
