{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/governance-recovery-request.packet.v1.json",
  "title": "Research Observatory inert governance recovery request packet",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "documentType",
    "recoveryRequestId",
    "title",
    "targetWave",
    "status",
    "executionState",
    "classification",
    "authorityChain",
    "frozenBoundary",
    "triggerEvidence",
    "controlHold",
    "bootstrapUnit",
    "postBootstrap",
    "acceptanceCriteria",
    "verificationObligations",
    "rollback",
    "nonGoals",
    "approvalRequirements",
    "files"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": "1.0-recovery-proposal"},
    "documentType": {"const": "governance-recovery-request-packet"},
    "recoveryRequestId": {"$ref": "#/$defs/grrId"},
    "title": {"type": "string", "minLength": 1},
    "targetWave": {"$ref": "#/$defs/waveId"},
    "status": {"const": "pending-human-approval"},
    "executionState": {"const": "non-executable"},
    "classification": {"const": "control-plane-recovery"},
    "authorityChain": {
      "type": "object",
      "required": ["waveBase", "orderedAmendments"],
      "properties": {
        "waveBase": {
          "type": "object",
          "required": ["waveId", "packetCommit", "approvalRecordCommit"],
          "properties": {
            "waveId": {"$ref": "#/$defs/waveId"},
            "packetCommit": {"$ref": "#/$defs/commit"},
            "approvalRecordCommit": {"$ref": "#/$defs/commit"}
          },
          "additionalProperties": false
        },
        "orderedAmendments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "changeRequestId", "status", "packetCommit", "approvalRecord", "effectiveStateCommit"],
            "properties": {
              "id": {"$ref": "#/$defs/amendmentId"},
              "changeRequestId": {
                "oneOf": [
                  {"type": "null"},
                  {"$ref": "#/$defs/ecrId"}
                ]
              },
              "status": {"const": "ADOPTED"},
              "packetCommit": {"$ref": "#/$defs/commit"},
              "approvalRecord": {"$ref": "#/$defs/fileReference"},
              "effectiveStateCommit": {"$ref": "#/$defs/commit"},
              "adoptionEvidence": {
                "oneOf": [
                  {"type": "null"},
                  {"$ref": "#/$defs/evidenceReference"}
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "frozenBoundary": {
      "type": "object",
      "required": [
        "branch",
        "taskId",
        "taskStatus",
        "taskCandidateCommit",
        "taskFoundationCommit",
        "taskBlockRecordCommit",
        "waveStatus",
        "waveScope",
        "wavePauseCategory",
        "wavePauseRecordCommit",
        "reviewProjectionCommit"
      ],
      "properties": {
        "branch": {"type": "string", "pattern": "^codex/[A-Za-z0-9._/-]+$"},
        "taskId": {"type": "string", "pattern": "^CAP-[0-9]{2}\\.S[0-9]{2}\\.T[0-9]{2}$"},
        "taskStatus": {"const": "BLOCKED"},
        "taskCandidateCommit": {"$ref": "#/$defs/commit"},
        "taskFoundationCommit": {"$ref": "#/$defs/commit"},
        "taskBlockRecordCommit": {"$ref": "#/$defs/commit"},
        "waveStatus": {"const": "PAUSED"},
        "waveScope": {"const": "wave"},
        "wavePauseCategory": {"const": "human-decision"},
        "wavePauseRecordCommit": {"$ref": "#/$defs/commit"},
        "reviewProjectionCommit": {"$ref": "#/$defs/commit"}
      },
      "additionalProperties": false
    },
    "triggerEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "severity", "summary", "reproduction", "requiredRecovery"],
        "properties": {
          "id": {"type": "string", "pattern": "^GRR-[0-9]{4}-F[0-9]{2}$"},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "summary": {"type": "string", "minLength": 1},
          "reproduction": {"$ref": "#/$defs/nonEmptyStrings"},
          "requiredRecovery": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "controlHold": {
      "type": "object",
      "required": ["id", "currentEnforcement", "commandsDenied", "releaseConditions"],
      "properties": {
        "id": {"type": "string", "pattern": "^HOLD-W(?:[0-9]|1[01])-GRR-[0-9]{4}$"},
        "currentEnforcement": {"const": "governance-and-paused-ledger-only"},
        "commandsDenied": {"$ref": "#/$defs/nonEmptyStrings"},
        "releaseConditions": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "additionalProperties": false
    },
    "bootstrapUnit": {
      "type": "object",
      "required": ["id", "kind", "exceptionReason", "authorizedPaths", "requiredOutcomes", "prohibitedOutcomes"],
      "properties": {
        "id": {"type": "string", "pattern": "^GRR-[0-9]{4}\\.B[0-9]{2}$"},
        "kind": {"const": "one-time-self-hosting-governance-recovery"},
        "exceptionReason": {"type": "string", "minLength": 1},
        "authorizedPaths": {"$ref": "#/$defs/nonEmptyUniqueStrings"},
        "requiredOutcomes": {"$ref": "#/$defs/nonEmptyStrings"},
        "prohibitedOutcomes": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "additionalProperties": false
    },
    "postBootstrap": {
      "type": "object",
      "required": ["requiredChangeRequestId", "requiredAmendmentId", "authorizedTaskIds", "ordinaryWaveResumeAuthorized"],
      "properties": {
        "requiredChangeRequestId": {"$ref": "#/$defs/ecrId"},
        "requiredAmendmentId": {"$ref": "#/$defs/amendmentId"},
        "authorizedTaskIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}\\.T[0-9]{2}$"}
        },
        "ordinaryWaveResumeAuthorized": {"const": false}
      },
      "additionalProperties": false
    },
    "acceptanceCriteria": {"$ref": "#/$defs/nonEmptyStrings"},
    "verificationObligations": {"$ref": "#/$defs/nonEmptyStrings"},
    "rollback": {"$ref": "#/$defs/nonEmptyStrings"},
    "nonGoals": {"$ref": "#/$defs/nonEmptyStrings"},
    "approvalRequirements": {
      "type": "object",
      "required": ["independentReview", "humanApproval", "exactCommitRequired", "selfApprovalDenied"],
      "properties": {
        "independentReview": {"const": "control-and-security"},
        "humanApproval": {"const": "explicit-repository-owner"},
        "exactCommitRequired": {"const": true},
        "selfApprovalDenied": {"const": true}
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "role": {"enum": ["canonical-proposal", "proposal-schema", "human-review"]}
        },
        "additionalProperties": false
      },
      "allOf": [
        {
          "contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "canonical-proposal"}}},
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "proposal-schema"}}},
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "human-review"}}},
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "waveId": {"type": "string", "pattern": "^W(?:[0-9]|1[01])$"},
    "amendmentId": {"type": "string", "pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}$"},
    "ecrId": {"type": "string", "pattern": "^ECR-[0-9]{4}$"},
    "grrId": {"type": "string", "pattern": "^GRR-[0-9]{4}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileReference": {
      "type": "object",
      "required": ["path", "sha256", "introductionCommit"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "introductionCommit": {"$ref": "#/$defs/commit"}
      },
      "additionalProperties": false
    },
    "evidenceReference": {
      "type": "object",
      "required": ["path", "sha256", "commit"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "commit": {"$ref": "#/$defs/commit"}
      },
      "additionalProperties": false
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
