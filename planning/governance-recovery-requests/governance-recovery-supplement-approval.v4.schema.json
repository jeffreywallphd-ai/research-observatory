{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/governance-recovery-supplement.approval.v4.json",
  "title": "Exact GRR-0002.S02 packet review ledger and human approval",
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attempt": {"type": "string", "pattern": "^R[0-9]{2,}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._*/-]+$"},
    "reference": {
      "type": "object",
      "required": ["path", "sha256", "commit"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "commit": {"$ref": "#/$defs/commit"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "blocking", "criterionIndex", "title", "reproduction", "requiredRemediation"],
      "properties": {
        "id": {"type": "string", "pattern": "^GRR-0002\\.S02-R[0-9]{2,}-F[0-9]{2,}$"},
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "blocking": {"type": "boolean"},
        "criterionIndex": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "reproduction": {"type": "string", "minLength": 1},
        "requiredRemediation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "closure": {
      "type": "object",
      "required": ["findingId", "disposition", "evidence"],
      "properties": {
        "findingId": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["fixed", "not-reproduced", "superseded", "accepted-risk"]},
        "evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "priorAttempt": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["attemptId", "ledger", "result"],
          "properties": {
            "attemptId": {"$ref": "#/$defs/attempt"},
            "ledger": {"$ref": "#/$defs/reference"},
            "result": {"enum": ["changes-requested", "blocked"]}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "$schema", "schemaVersion", "documentType", "recoveryRequestId", "supplementId",
        "attemptId", "candidateCommit", "packetSha256", "reviewer", "result", "findings",
        "closures", "priorAttempt", "verified", "approvalAvailable"
      ],
      "properties": {
        "$schema": {"const": "./governance-recovery-supplement-approval.v4.schema.json"},
        "schemaVersion": {"const": "4.0"},
        "documentType": {"const": "governance-recovery-supplement-packet-review"},
        "recoveryRequestId": {"const": "GRR-0002"},
        "supplementId": {"const": "GRR-0002.S02"},
        "attemptId": {"$ref": "#/$defs/attempt"},
        "candidateCommit": {"$ref": "#/$defs/commit"},
        "packetSha256": {"$ref": "#/$defs/sha256"},
        "reviewer": {"type": "string", "minLength": 1},
        "result": {"enum": ["approved", "changes-requested", "blocked"]},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "closures": {"type": "array", "items": {"$ref": "#/$defs/closure"}},
        "priorAttempt": {"$ref": "#/$defs/priorAttempt"},
        "verified": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "approvalAvailable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "$schema", "schemaVersion", "documentType", "recoveryRequestId", "supplementId", "targetWave",
        "status", "approvedBy", "approvedAt", "decision", "packet", "supplementalBootstrapUnit",
        "independentPacketReview", "executionAuthority"
      ],
      "properties": {
        "$schema": {"const": "../governance-recovery-requests/governance-recovery-supplement-approval.v4.schema.json"},
        "schemaVersion": {"const": "4.0"},
        "documentType": {"const": "governance-recovery-supplement-approval"},
        "recoveryRequestId": {"const": "GRR-0002"},
        "supplementId": {"const": "GRR-0002.S02"},
        "targetWave": {"const": "W1"},
        "status": {"const": "APPROVED"},
        "approvedBy": {"type": "string", "minLength": 1},
        "approvedAt": {"type": "string", "format": "date-time"},
        "decision": {"type": "string", "minLength": 1},
        "packet": {
          "type": "object",
          "required": ["commit", "path", "sha256", "proposalPath", "proposalSha256", "schemaPath", "schemaSha256", "reviewPath", "reviewSha256"],
          "properties": {
            "commit": {"$ref": "#/$defs/commit"},
            "path": {"const": "planning/governance-recovery-requests/GRR-0002.S02.packet.json"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "proposalPath": {"$ref": "#/$defs/path"},
            "proposalSha256": {"$ref": "#/$defs/sha256"},
            "schemaPath": {"const": "planning/governance-recovery-requests/governance-recovery-supplement.v4.schema.json"},
            "schemaSha256": {"$ref": "#/$defs/sha256"},
            "reviewPath": {"$ref": "#/$defs/path"},
            "reviewSha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "supplementalBootstrapUnit": {"const": "GRR-0002.B02"},
        "independentPacketReview": {
          "type": "object",
          "required": ["attemptId", "candidateCommit", "ledger", "result", "openFindingIds", "closedFindingIds"],
          "properties": {
            "attemptId": {"$ref": "#/$defs/attempt"},
            "candidateCommit": {"$ref": "#/$defs/commit"},
            "ledger": {"$ref": "#/$defs/reference"},
            "result": {"const": "APPROVED"},
            "openFindingIds": {"type": "array", "maxItems": 0},
            "closedFindingIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        },
        "executionAuthority": {
          "type": "object",
          "required": ["supplementalBootstrapOnly", "postBootstrapExecution", "amendmentMaterialization", "ordinaryWaveResume", "taskExecution", "releaseGateApproval"],
          "properties": {
            "supplementalBootstrapOnly": {"const": true},
            "postBootstrapExecution": {"const": false},
            "amendmentMaterialization": {"const": false},
            "ordinaryWaveResume": {"const": false},
            "taskExecution": {"const": false},
            "releaseGateApproval": {"const": false}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
