{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/governance-recovery-supplement.packet.v2.json",
  "title": "Generation-neutral governance recovery supplement packet",
  "type": "object",
  "required": [
    "$schema", "schemaVersion", "documentType", "recoveryRequestId", "supplementId", "title",
    "targetWave", "status", "executionState", "classification", "controlTransition",
    "baseRecoveryAuthority", "targetAmendmentAuthority", "triggerEvidence", "activationBoundary",
    "supplementalBootstrap", "acceptanceCriteria", "verificationObligations", "rollback",
    "alternatives", "files", "requiredApprovalStatement"
  ],
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonicalPath": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._*/-]+$"},
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reference": {
      "type": "object",
      "required": ["path", "sha256", "commit"],
      "properties": {
        "path": {"$ref": "#/$defs/canonicalPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "commit": {"$ref": "#/$defs/commit"}
      },
      "additionalProperties": false
    },
    "fileReference": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/canonicalPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": {"const": "./governance-recovery-supplement.v2.schema.json"},
    "schemaVersion": {"const": "2.0-recovery-supplement-proposal"},
    "documentType": {"const": "governance-recovery-supplement-packet"},
    "recoveryRequestId": {"type": "string", "pattern": "^GRR-[0-9]{4}$"},
    "supplementId": {"type": "string", "pattern": "^GRR-[0-9]{4}\\.S[0-9]{2}$"},
    "title": {"type": "string", "minLength": 1},
    "targetWave": {"type": "string", "pattern": "^W(?:[0-9]|1[01])$"},
    "status": {"const": "pending-human-approval"},
    "executionState": {"const": "non-executable"},
    "classification": {"const": "approved-bootstrap-latent-control-defect"},
    "controlTransition": {
      "type": "object",
      "required": ["predecessorRevision", "successorRevision", "generationNeutral", "olderReadersFailClosed"],
      "properties": {
        "predecessorRevision": {"type": "integer", "minimum": 7, "maximum": 7},
        "successorRevision": {"type": "integer", "minimum": 8, "maximum": 8},
        "generationNeutral": {"const": true},
        "olderReadersFailClosed": {"const": true}
      },
      "additionalProperties": false
    },
    "baseRecoveryAuthority": {
      "type": "object",
      "required": ["packet", "approval", "holdId", "bootstrapUnit", "latestApprovedReview"],
      "properties": {
        "packet": {"$ref": "#/$defs/reference"},
        "approval": {
          "type": "object",
          "required": ["path", "sha256", "introductionCommit"],
          "properties": {
            "path": {"$ref": "#/$defs/canonicalPath"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "introductionCommit": {"$ref": "#/$defs/commit"}
          },
          "additionalProperties": false
        },
        "holdId": {"type": "string", "pattern": "^HOLD-W(?:[0-9]|1[01])-GRR-[0-9]{4}$"},
        "bootstrapUnit": {"type": "string", "pattern": "^GRR-[0-9]{4}\\.B00$"},
        "latestApprovedReview": {
          "type": "object",
          "required": ["attemptId", "path", "sha256", "candidateCommit", "reviewedStateCommit"],
          "properties": {
            "attemptId": {"type": "string", "pattern": "^R[0-9]{2,}$"},
            "path": {"$ref": "#/$defs/canonicalPath"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "candidateCommit": {"$ref": "#/$defs/commit"},
            "reviewedStateCommit": {"$ref": "#/$defs/commit"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "targetAmendmentAuthority": {
      "type": "object",
      "required": ["changeRequestPacket", "amendmentApproval", "bootstrap", "backlogPresence"],
      "properties": {
        "changeRequestPacket": {
          "type": "object",
          "required": ["id", "path", "sha256", "commit"],
          "properties": {
            "id": {"type": "string", "pattern": "^ECR-[0-9]{4}$"},
            "path": {"$ref": "#/$defs/canonicalPath"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "commit": {"$ref": "#/$defs/commit"}
          },
          "additionalProperties": false
        },
        "amendmentApproval": {
          "type": "object",
          "required": ["id", "path", "sha256", "introductionCommit"],
          "properties": {
            "id": {"type": "string", "pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}$"},
            "path": {"$ref": "#/$defs/canonicalPath"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "introductionCommit": {"$ref": "#/$defs/commit"}
          },
          "additionalProperties": false
        },
        "bootstrap": {
          "type": "object",
          "required": ["id", "candidateCommit", "evidence"],
          "properties": {
            "id": {"type": "string", "pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}\\.B00$"},
            "candidateCommit": {"$ref": "#/$defs/commit"},
            "evidence": {"$ref": "#/$defs/reference"}
          },
          "additionalProperties": false
        },
        "backlogPresence": {"const": false}
      },
      "additionalProperties": false
    },
    "triggerEvidence": {
      "type": "object",
      "required": ["discoveryCommit", "backlogSha256", "command", "diagnostic", "atomicNoMutation"],
      "properties": {
        "discoveryCommit": {"$ref": "#/$defs/commit"},
        "backlogSha256": {"$ref": "#/$defs/sha256"},
        "command": {"type": "string", "minLength": 1},
        "diagnostic": {"type": "string", "minLength": 1},
        "atomicNoMutation": {"const": true}
      },
      "additionalProperties": false
    },
    "activationBoundary": {
      "type": "object",
      "required": ["controlRevision", "holdStatus", "waveStatus", "waveScope", "amendmentId", "amendmentBacklogStatus", "blockedTaskId", "blockedTaskStatus"],
      "properties": {
        "controlRevision": {"const": 7},
        "holdStatus": {"const": "ACTIVE"},
        "waveStatus": {"const": "PAUSED"},
        "waveScope": {"const": "wave"},
        "amendmentId": {"type": "string", "pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}$"},
        "amendmentBacklogStatus": {"const": "ABSENT"},
        "blockedTaskId": {"type": "string", "pattern": "^CAP-[0-9]{2}\\.S[0-9]{2}\\.T[0-9]{2}$"},
        "blockedTaskStatus": {"const": "BLOCKED"}
      },
      "additionalProperties": false
    },
    "supplementalBootstrap": {
      "type": "object",
      "required": ["id", "kind", "exceptionReason", "authorizedPaths", "requiredOutcomes", "prohibitedOutcomes"],
      "properties": {
        "id": {"type": "string", "pattern": "^GRR-[0-9]{4}\\.B[0-9]{2}$"},
        "kind": {"const": "append-only-approved-bootstrap-remediation"},
        "exceptionReason": {"type": "string", "minLength": 1},
        "authorizedPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/canonicalPath"}},
        "requiredOutcomes": {"$ref": "#/$defs/strings"},
        "prohibitedOutcomes": {"$ref": "#/$defs/strings"}
      },
      "additionalProperties": false
    },
    "acceptanceCriteria": {"$ref": "#/$defs/strings"},
    "verificationObligations": {"$ref": "#/$defs/strings"},
    "rollback": {"$ref": "#/$defs/strings"},
    "alternatives": {"type": "array", "minItems": 2, "items": {"type": "object"}},
    "files": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/fileReference"}},
    "requiredApprovalStatement": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
