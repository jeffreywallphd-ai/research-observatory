{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/governance-recovery-supplement.packet.v1.json",
  "title": "Governance recovery supplemental bootstrap packet",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "documentType",
    "recoveryRequestId",
    "supplementId",
    "title",
    "targetWave",
    "status",
    "executionState",
    "classification",
    "baseRecoveryAuthority",
    "triggerEvidence",
    "activationBoundary",
    "supplementalBootstrap",
    "acceptanceCriteria",
    "verificationObligations",
    "rollback",
    "alternatives",
    "files",
    "requiredApprovalStatement"
  ],
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "canonicalPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._*/-]+$"
    },
    "fileReference": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/canonicalPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": {"const": "./governance-recovery-supplement.schema.json"},
    "schemaVersion": {"const": "1.0-recovery-supplement-proposal"},
    "documentType": {"const": "governance-recovery-supplement-packet"},
    "recoveryRequestId": {"type": "string", "pattern": "^GRR-[0-9]{4}$"},
    "supplementId": {"type": "string", "pattern": "^GRR-[0-9]{4}\\.S[0-9]{2}$"},
    "title": {"type": "string", "minLength": 1},
    "targetWave": {"type": "string", "pattern": "^W(?:[0-9]|1[01])$"},
    "status": {"const": "pending-human-approval"},
    "executionState": {"const": "non-executable"},
    "classification": {"const": "approved-bootstrap-latent-control-defect"},
    "baseRecoveryAuthority": {
      "type": "object",
      "required": ["packet", "approval", "holdId", "bootstrapUnit", "latestApprovedReview"],
      "properties": {
        "packet": {
          "type": "object",
          "required": ["commit", "path", "sha256"],
          "properties": {
            "commit": {"$ref": "#/$defs/commit"},
            "path": {"$ref": "#/$defs/canonicalPath"},
            "sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "approval": {
          "type": "object",
          "required": ["introductionCommit", "path", "sha256"],
          "properties": {
            "introductionCommit": {"$ref": "#/$defs/commit"},
            "path": {"$ref": "#/$defs/canonicalPath"},
            "sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "holdId": {"type": "string", "pattern": "^HOLD-W(?:[0-9]|1[01])-GRR-[0-9]{4}$"},
        "bootstrapUnit": {"type": "string", "pattern": "^GRR-[0-9]{4}\\.B[0-9]{2}$"},
        "latestApprovedReview": {
          "type": "object",
          "required": ["attemptId", "path", "sha256", "candidateCommit", "reviewedStateCommit"],
          "properties": {
            "attemptId": {"type": "string", "pattern": "^R[0-9]{2,}$"},
            "path": {"$ref": "#/$defs/canonicalPath"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "candidateCommit": {"$ref": "#/$defs/commit"},
            "reviewedStateCommit": {"$ref": "#/$defs/commit"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "triggerEvidence": {
      "type": "object",
      "required": ["discoveryCommit", "backlogSha256", "command", "diagnostic", "atomicNoMutation"],
      "properties": {
        "discoveryCommit": {"$ref": "#/$defs/commit"},
        "backlogSha256": {"$ref": "#/$defs/sha256"},
        "command": {"type": "string", "minLength": 1},
        "diagnostic": {"type": "string", "minLength": 1},
        "atomicNoMutation": {"const": true}
      },
      "additionalProperties": false
    },
    "activationBoundary": {
      "type": "object",
      "required": ["holdStatus", "waveStatus", "waveScope", "amendmentId", "amendmentLifecycle", "bootstrapStatus", "materializedTaskCount", "blockedTaskId", "blockedTaskStatus"],
      "properties": {
        "holdStatus": {"const": "ACTIVE"},
        "waveStatus": {"const": "PAUSED"},
        "waveScope": {"const": "wave"},
        "amendmentId": {"type": "string", "pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}$"},
        "amendmentLifecycle": {"const": "APPROVED"},
        "bootstrapStatus": {"const": "APPROVED"},
        "materializedTaskCount": {"const": 0},
        "blockedTaskId": {"type": "string", "pattern": "^CAP-[0-9]{2}\\.S[0-9]{2}\\.T[0-9]{2}$"},
        "blockedTaskStatus": {"const": "BLOCKED"}
      },
      "additionalProperties": false
    },
    "supplementalBootstrap": {
      "type": "object",
      "required": ["id", "kind", "exceptionReason", "authorizedPaths", "requiredOutcomes", "prohibitedOutcomes"],
      "properties": {
        "id": {"type": "string", "pattern": "^GRR-[0-9]{4}\\.B[0-9]{2}$"},
        "kind": {"const": "append-only-approved-bootstrap-remediation"},
        "exceptionReason": {"type": "string", "minLength": 1},
        "authorizedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalPath"}
        },
        "requiredOutcomes": {"$ref": "#/$defs/nonEmptyStrings"},
        "prohibitedOutcomes": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "additionalProperties": false
    },
    "acceptanceCriteria": {"$ref": "#/$defs/nonEmptyStrings"},
    "verificationObligations": {"$ref": "#/$defs/nonEmptyStrings"},
    "rollback": {"$ref": "#/$defs/nonEmptyStrings"},
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "title", "disposition", "consequence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["recommended", "safe", "rejected"]},
          "consequence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fileReference"}
    },
    "requiredApprovalStatement": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
