{
  "$defs": {
    "AcquisitionOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "remote-acquisition",
          "title": "Kind",
          "type": "string"
        },
        "locationId": {
          "$ref": "#/$defs/Identity"
        },
        "receiptSha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "kind",
        "locationId",
        "receiptSha256"
      ],
      "title": "AcquisitionOrigin",
      "type": "object"
    },
    "AnchorContext": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/Count"
        },
        "text": {
          "maxLength": 8192,
          "title": "Text",
          "type": "string"
        },
        "highlight": {
          "$ref": "#/$defs/CodepointRange"
        }
      },
      "required": [
        "start",
        "text",
        "highlight"
      ],
      "title": "AnchorContext",
      "type": "object"
    },
    "AnchorQuote": {
