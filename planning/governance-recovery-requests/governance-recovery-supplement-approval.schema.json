{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/governance-recovery-supplement.approval.v1.json",
  "title": "Governance recovery supplement approval",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentType",
    "recoveryRequestId",
    "supplementId",
    "targetWave",
    "status",
    "approvedBy",
    "approvedAt",
    "decision",
    "packet",
    "supplementalBootstrapUnit",
    "independentPacketReview",
    "executionAuthority"
  ],
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonicalPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._*/-]+$"
    }
  },
  "properties": {
    "$schema": {"const": "../governance-recovery-requests/governance-recovery-supplement-approval.schema.json"},
    "schemaVersion": {"const": "1.0"},
    "documentType": {"const": "governance-recovery-supplement-approval"},
    "recoveryRequestId": {"type": "string", "pattern": "^GRR-[0-9]{4}$"},
    "supplementId": {"type": "string", "pattern": "^GRR-[0-9]{4}\\.S[0-9]{2}$"},
    "targetWave": {"type": "string", "pattern": "^W(?:[0-9]|1[01])$"},
    "status": {"const": "APPROVED"},
    "approvedBy": {"type": "string", "minLength": 1},
    "approvedAt": {"type": "string", "format": "date-time"},
    "decision": {"type": "string", "minLength": 1},
    "packet": {
      "type": "object",
      "required": ["commit", "path", "sha256", "proposalPath", "proposalSha256", "schemaPath", "schemaSha256", "reviewPath", "reviewSha256"],
      "properties": {
        "commit": {"$ref": "#/$defs/commit"},
        "path": {"$ref": "#/$defs/canonicalPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "proposalPath": {"$ref": "#/$defs/canonicalPath"},
        "proposalSha256": {"$ref": "#/$defs/sha256"},
        "schemaPath": {"$ref": "#/$defs/canonicalPath"},
        "schemaSha256": {"$ref": "#/$defs/sha256"},
        "reviewPath": {"$ref": "#/$defs/canonicalPath"},
        "reviewSha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "supplementalBootstrapUnit": {"type": "string", "pattern": "^GRR-[0-9]{4}\\.B[0-9]{2}$"},
    "independentPacketReview": {
      "type": "object",
      "required": ["reviewer", "attemptId", "candidateCommit", "packetSha256", "result", "openFindingIds", "closedFindingIds", "priorAdverseLedger"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "attemptId": {"type": "string", "pattern": "^R[0-9]{2,}$"},
        "candidateCommit": {"$ref": "#/$defs/commit"},
        "packetSha256": {"$ref": "#/$defs/sha256"},
        "result": {"const": "APPROVED"},
        "openFindingIds": {"type": "array", "maxItems": 0},
        "closedFindingIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "priorAdverseLedger": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": {"$ref": "#/$defs/canonicalPath"},
            "sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "executionAuthority": {
      "type": "object",
      "required": ["supplementalBootstrapOnly", "postBootstrapExecution", "amendmentMaterialization", "ordinaryWaveResume", "taskExecution", "releaseGateApproval"],
      "properties": {
        "supplementalBootstrapOnly": {"const": true},
        "postBootstrapExecution": {"const": false},
        "amendmentMaterialization": {"const": false},
        "ordinaryWaveResume": {"const": false},
        "taskExecution": {"const": false},
        "releaseGateApproval": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
