{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/governance-recovery-supplement.approval.v4.json",
  "title": "Exact GRR-0002.S02 governance recovery supplement approval",
  "type": "object",
  "required": [
    "$schema", "schemaVersion", "documentType", "recoveryRequestId", "supplementId", "targetWave",
    "status", "approvedBy", "approvedAt", "decision", "packet", "supplementalBootstrapUnit",
    "independentPacketReview", "executionAuthority"
  ],
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._*/-]+$"}
  },
  "properties": {
    "$schema": {"const": "../governance-recovery-requests/governance-recovery-supplement-approval.v4.schema.json"},
    "schemaVersion": {"const": "4.0"},
    "documentType": {"const": "governance-recovery-supplement-approval"},
    "recoveryRequestId": {"const": "GRR-0002"},
    "supplementId": {"const": "GRR-0002.S02"},
    "targetWave": {"const": "W1"},
    "status": {"const": "APPROVED"},
    "approvedBy": {"type": "string", "minLength": 1},
    "approvedAt": {"type": "string", "format": "date-time"},
    "decision": {"type": "string", "minLength": 1},
    "packet": {
      "type": "object",
      "required": ["commit", "path", "sha256", "proposalPath", "proposalSha256", "schemaPath", "schemaSha256", "reviewPath", "reviewSha256"],
      "properties": {
        "commit": {"$ref": "#/$defs/commit"}, "path": {"const": "planning/governance-recovery-requests/GRR-0002.S02.packet.json"},
        "sha256": {"$ref": "#/$defs/sha256"}, "proposalPath": {"$ref": "#/$defs/path"}, "proposalSha256": {"$ref": "#/$defs/sha256"},
        "schemaPath": {"const": "planning/governance-recovery-requests/governance-recovery-supplement.v4.schema.json"},
        "schemaSha256": {"$ref": "#/$defs/sha256"}, "reviewPath": {"$ref": "#/$defs/path"}, "reviewSha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "supplementalBootstrapUnit": {"const": "GRR-0002.B02"},
    "independentPacketReview": {
      "type": "object", "required": ["reviewer", "attemptId", "candidateCommit", "packetSha256", "result", "openFindingIds", "closedFindingIds", "priorAdverseLedger"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1}, "attemptId": {"type": "string", "pattern": "^R[0-9]{2,}$"},
        "candidateCommit": {"$ref": "#/$defs/commit"}, "packetSha256": {"$ref": "#/$defs/sha256"}, "result": {"const": "APPROVED"},
        "openFindingIds": {"type": "array", "maxItems": 0},
        "closedFindingIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "priorAdverseLedger": {
          "anyOf": [
            {"type": "null"},
            {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}
          ]
        }
      },
      "additionalProperties": false
    },
    "executionAuthority": {
      "type": "object", "required": ["supplementalBootstrapOnly", "postBootstrapExecution", "amendmentMaterialization", "ordinaryWaveResume", "taskExecution", "releaseGateApproval"],
      "properties": {
        "supplementalBootstrapOnly": {"const": true}, "postBootstrapExecution": {"const": false},
        "amendmentMaterialization": {"const": false}, "ordinaryWaveResume": {"const": false},
        "taskExecution": {"const": false}, "releaseGateApproval": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}


