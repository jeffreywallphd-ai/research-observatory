{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/ui-change-evidence-1.0.json",
  "title": "Research Observatory UI change evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentType",
    "taskId",
    "changeKind",
    "contractPath",
    "implementationAgent",
    "changedFiles",
    "reference",
    "focusedEvidence"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "documentType": {"const": "ui-change-evidence"},
    "taskId": {"type": "string", "pattern": "^CAP-[0-9]{2}\\.S[0-9]{2}\\.T[0-9]{2}$"},
    "changeKind": {
      "enum": ["intentional-design-change", "approved-reference-implementation", "defect-restoration"]
    },
    "contractPath": {
      "type": "string",
      "pattern": "^artifacts/evidence/ui-change/CAP-[0-9]{2}\\.S[0-9]{2}\\.T[0-9]{2}\\.json$"
    },
    "implementationAgent": {
      "type": "string",
      "pattern": "^(agent|human):[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "changedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
      "uniqueItems": true
    },
    "reference": {
      "type": "object",
      "required": [
        "referenceId",
        "version",
        "packageSha256",
        "approvalCommit",
        "approvedBy",
        "previousReferenceId"
      ],
      "properties": {
        "referenceId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "packageSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approvalCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "approvedBy": {"type": "string", "minLength": 1},
        "previousReferenceId": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "focusedEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "result", "scope"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "result": {"const": "passed"},
          "scope": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "restoration": {
      "type": "object",
      "required": ["defect", "expectedBehavior"],
      "properties": {
        "defect": {"type": "string", "minLength": 1},
        "expectedBehavior": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "implementationScope": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"changeKind": {"const": "defect-restoration"}}},
      "then": {"required": ["restoration"]}
    },
    {
      "if": {"properties": {"changeKind": {"enum": ["intentional-design-change", "approved-reference-implementation"]}}},
      "then": {"required": ["implementationScope"]}
    }
  ],
  "additionalProperties": false
}
