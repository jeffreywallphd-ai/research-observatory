{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false,
    "types": ["node", "vitest/globals"]
  },
  "include": ["core-api", "domain", "project"]
}
