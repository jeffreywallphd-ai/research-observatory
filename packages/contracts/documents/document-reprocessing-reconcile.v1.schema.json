      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Identity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Rationale": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
    },
    "ReprocessingMapping": {
      "additionalProperties": false,
      "properties": {
        "obligationId": {
          "$ref": "#/$defs/Digest"
        },
        "nodeId": {
          "$ref": "#/$defs/Identity"
        },
        "relatedNodeId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "referenceId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "obligationId",
        "nodeId",
        "relatedNodeId",
        "referenceId"
      ],
      "title": "ReprocessingMapping",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "commandId": {
      "$ref": "#/$defs/Identity"
    },
    "comparisonRevisionId": {
      "$ref": "#/$defs/Identity"
    },
    "expectedPlanRevisionId": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identity"
        },
        {
          "type": "null"
        }
      ]
    },
    "rationale": {
      "$ref": "#/$defs/Rationale"
    },
    "mappings": {
      "items": {
        "$ref": "#/$defs/ReprocessingMapping"
      },
      "maxItems": 32,
      "title": "Mappings",
      "type": "array"
    }
  },
  "required": [
    "commandId",
    "comparisonRevisionId",
    "expectedPlanRevisionId",
    "rationale",
    "mappings"
