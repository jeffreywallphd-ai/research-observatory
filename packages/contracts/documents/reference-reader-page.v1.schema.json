      "properties": {
        "exact": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Exact",
          "type": "string"
        },
        "prefix": {
          "maxLength": 64,
          "title": "Prefix",
          "type": "string"
        },
        "suffix": {
          "maxLength": 64,
          "title": "Suffix",
          "type": "string"
        }
      },
      "required": [
        "exact",
        "prefix",
        "suffix"
