{
  "$defs": {
    "AcquisitionOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "remote-acquisition",
          "title": "Kind",
          "type": "string"
        },
        "locationId": {
          "$ref": "#/$defs/Identity"
        },
        "receiptSha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "kind",
        "locationId",
        "receiptSha256"
      ],
      "title": "AcquisitionOrigin",
      "type": "object"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Format": {
      "enum": [
        "jats",
        "tei",
        "xml",
        "html",
        "pdf",
        "docx",
        "plain-text"
      ],
      "type": "string"
    },
    "Identity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "LocalOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "local-import",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LocalOrigin",
      "type": "object"
    },
    "ProjectIdentity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "SourceIdentity": {
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "$ref": "#/$defs/ProjectIdentity"
        },
        "attachmentId": {
          "$ref": "#/$defs/Identity"
        },
        "documentId": {
          "$ref": "#/$defs/Identity"
        },
        "documentRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "candidateId": {
          "$ref": "#/$defs/Identity"
        },
        "sourceAssertionRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "workId": {
          "$ref": "#/$defs/Identity"
        },
        "workRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "versionId": {
          "$ref": "#/$defs/Identity"
        },
        "versionRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "objectSha256": {
          "$ref": "#/$defs/Digest"
        },
        "byteLength": {
          "maximum": 134217728,
          "minimum": 0,
          "title": "Bytelength",
          "type": "integer"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "provenance": {
          "discriminator": {
            "mapping": {
              "local-import": "#/$defs/LocalOrigin",
              "remote-acquisition": "#/$defs/AcquisitionOrigin"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/LocalOrigin"
            },
            {
              "$ref": "#/$defs/AcquisitionOrigin"
            }
          ],
          "title": "Provenance"
        }
      },
      "required": [
        "projectId",
        "attachmentId",
        "documentId",
        "documentRevisionId",
        "candidateId",
        "sourceAssertionRevisionId",
        "workId",
        "workRevisionId",
        "versionId",
        "versionRevisionId",
        "objectSha256",
        "byteLength",
        "format",
        "provenance"
      ],
      "title": "SourceIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectIdentity"
    },
    "source": {
      "$ref": "#/$defs/SourceIdentity"
    },
    "documentRevisionId": {
      "$ref": "#/$defs/Identity"
    },
    "collectionId": {
      "$ref": "#/$defs/Identity"
    },
    "collectionRevisionId": {
      "$ref": "#/$defs/Identity"
    },
    "status": {
      "const": "unavailable",
      "default": "unavailable",
      "title": "Status",
      "type": "string"
    },
    "reasonCode": {
      "enum": [
        "viewer-resource-limit",
        "citations-unavailable"
      ],
      "title": "Reasoncode",
      "type": "string"
    },
    "scholarlyVerification": {
      "const": "unverified",
      "default": "unverified",
      "title": "Scholarlyverification",
      "type": "string"
    }
  },
  "required": [
    "projectId",
    "source",
    "documentRevisionId",
    "collectionId",
    "collectionRevisionId",
    "reasonCode"
  ],
  "title": "CitationReaderNotice",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/contracts/documents/citation-reader-notice.v1.schema.json",
  "x-research-observatory-semanticRules": [
    "immutable-encrypted-canonical-collection-exact-reference-collection-id-revision-and-protected-payload-digest",
    "current-native-human-project-intent-privacy-source-inspect-derive-and-canonical-target-authority-through-delivery",
    "exact-accepted-revision-node-projection-and-codepoint-raw-contributors-no-normalized-prefix-guessing",
    "native-per-member-target-tokens-distinguish-unique-groups-partial-missing-and-duplicate-ids",
    "numbering-requires-reported-label-no-reference-order-or-footnote-math-superscript-target-inference",
    "author-year-and-sentence-patterns-explicitly-inferred-no-scholarly-support-or-verification",
    "cross-element-normalization-boundary-preserves-exact-child-anchor-and-unknown-ancestor-highlight",
    "inferred-markers-use-collection-revision-order-and-source-selectors-not-new-canonical-element-identities",
    "expected-reference-and-citation-head-cas-exact-retry-full-inputs-and-atomic-provenance-outbox-stale-propagation",
    "accepted-v1-original-and-literal-v28-remain-unchanged-no-model-or-network-operation",
    "bounded-1000-markers-128-target-members-16-mib-collection-five-second-cooperative-operation",
    "one-64-kib-reader-context-256-marker-1024-context-codepoints-four-groups-four-reference-previews-explicit-counts",
    "opaque-rights-fenced-unavailable-head-is-not-permission-to-display-prior-protected-context"
  ]
}
