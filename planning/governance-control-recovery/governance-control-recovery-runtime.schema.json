{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/governance-control-recovery.runtime.v1.json",
  "title": "Governance control-recovery approval and bootstrap runtime records",
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "id": {"type": "string", "pattern": "^GCR-[0-9]{4}$"},
    "bootstrapId": {"type": "string", "pattern": "^GCR-[0-9]{4}\\.B00$"},
    "attemptId": {"type": "string", "pattern": "^R[0-9]{2,}$"},
    "canonicalPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._*/-]+$"
    },
    "reference": {
      "type": "object",
      "required": ["path", "sha256", "commit"],
      "properties": {
        "path": {"$ref": "#/$defs/canonicalPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "commit": {"$ref": "#/$defs/commit"}
      },
      "additionalProperties": false
    },
    "triggerWitness": {
      "type": "object",
      "required": ["path", "sha256", "role", "untracked", "unstaged", "executionAuthority"],
      "properties": {
        "path": {"const": "artifacts/evidence/W1.A04.B00.json"},
        "sha256": {"const": "4a9d944ff95972b449b617bc384306c7023e79d31d6b427e6b6f4678cd58b22c"},
        "role": {"const": "atomic-failure-trigger-only"},
        "untracked": {"const": true},
        "unstaged": {"const": true},
        "executionAuthority": {"const": false}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "blocking", "criterionIndex", "title", "reproduction", "requiredRemediation"],
      "properties": {
        "id": {"type": "string", "pattern": "^GCR-[0-9]{4}(?:\\.B00)?-R[0-9]{2,}-F[0-9]{2,}$"},
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "blocking": {"type": "boolean"},
        "criterionIndex": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "reproduction": {"type": "string", "minLength": 1},
        "requiredRemediation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "closure": {
      "type": "object",
      "required": ["findingId", "disposition", "evidence"],
      "properties": {
        "findingId": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["fixed", "not-reproduced", "superseded", "accepted-risk"]},
        "evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["id", "command", "exitCode", "result"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "exitCode": {"type": "integer"},
        "result": {"enum": ["passed", "failed"]},
        "outputSha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "criterionEvidence": {
      "type": "object",
      "required": ["index", "statement", "evidence"],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "statement": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "verificationSelection": {
      "type": "object",
      "required": ["riskAnalysis", "selectedChecks", "deferredCoverage"],
      "properties": {
        "riskAnalysis": {"type": "string", "minLength": 1},
        "selectedChecks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "deferredCoverage": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "submission": {
      "type": "object",
      "required": ["attemptId", "submittedBy", "submittedAt", "candidateCommit", "baseCommit", "branch", "evidence", "priorAttemptId", "openFindingIds", "rootCauseAnalysis"],
      "properties": {
        "attemptId": {"$ref": "#/$defs/attemptId"},
        "submittedBy": {"type": "string", "minLength": 1},
        "submittedAt": {"$ref": "#/$defs/timestamp"},
        "candidateCommit": {"$ref": "#/$defs/commit"},
        "baseCommit": {"$ref": "#/$defs/commit"},
        "branch": {"type": "string", "pattern": "^codex/.+"},
        "evidence": {"$ref": "#/$defs/reference"},
        "priorAttemptId": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/attemptId"}]},
        "openFindingIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "rootCauseAnalysis": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "reviewProjection": {
      "type": "object",
      "required": ["reviewer", "result", "reviewedAt", "reviewedStateCommit", "notes"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "result": {"enum": ["approved", "changes-requested", "blocked"]},
        "reviewedAt": {"$ref": "#/$defs/timestamp"},
        "reviewedStateCommit": {"$ref": "#/$defs/commit"},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": ["submission", "review", "ledger", "findings", "closures"],
      "properties": {
        "submission": {"$ref": "#/$defs/submission"},
        "review": {"$ref": "#/$defs/reviewProjection"},
        "ledger": {"$ref": "#/$defs/reference"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "closures": {"type": "array", "items": {"$ref": "#/$defs/closure"}}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "attemptId", "candidateCommit", "packetSha256", "branch", "reviewer", "result", "findings", "closures", "verified", "approvalAvailable"],
      "properties": {
        "schemaVersion": {"const": "1.0-control-recovery-review"},
        "documentType": {"const": "governance-control-recovery-packet-review"},
        "controlRecoveryId": {"$ref": "#/$defs/id"},
        "attemptId": {"$ref": "#/$defs/attemptId"},
        "candidateCommit": {"$ref": "#/$defs/commit"},
        "packetSha256": {"$ref": "#/$defs/sha256"},
        "branch": {"type": "string", "pattern": "^codex/.+"},
        "reviewer": {"type": "string", "minLength": 1},
        "result": {"enum": ["approved", "changes-requested", "blocked"]},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "closures": {"type": "array", "items": {"$ref": "#/$defs/closure"}},
        "verified": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "approvalAvailable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "status", "approvedBy", "approvedAt", "decision", "packet", "independentPacketReview", "triggerWitness", "executionAuthority"],
      "properties": {
        "schemaVersion": {"const": "1.0-control-recovery-approval"},
        "documentType": {"const": "governance-control-recovery-approval"},
        "controlRecoveryId": {"$ref": "#/$defs/id"},
        "status": {"const": "APPROVED"},
        "approvedBy": {"type": "string", "minLength": 1},
        "approvedAt": {"$ref": "#/$defs/timestamp"},
        "decision": {"type": "string", "minLength": 1},
        "packet": {"$ref": "#/$defs/reference"},
        "independentPacketReview": {
          "type": "object",
          "required": ["attemptId", "candidateCommit", "ledger", "result", "closedFindingIds", "openFindingIds"],
          "properties": {
            "attemptId": {"$ref": "#/$defs/attemptId"},
            "candidateCommit": {"$ref": "#/$defs/commit"},
            "ledger": {"$ref": "#/$defs/reference"},
            "result": {"const": "APPROVED"},
            "closedFindingIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "openFindingIds": {"type": "array", "maxItems": 0}
          },
          "additionalProperties": false
        },
        "triggerWitness": {"$ref": "#/$defs/triggerWitness"},
        "executionAuthority": {
          "type": "object",
          "required": ["bootstrapOnly", "bootstrapUnit", "ordinaryExecution", "revisionAdoptionBeforeReview"],
          "properties": {
            "bootstrapOnly": {"const": true},
            "bootstrapUnit": {"$ref": "#/$defs/bootstrapId"},
            "ordinaryExecution": {"const": false},
            "revisionAdoptionBeforeReview": {"const": false}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "bootstrapUnit", "attemptId", "commit", "baseCommit", "branch", "triggerWitness", "changedFiles", "checks", "acceptanceCriteria", "findingClosures", "unverifiedItems", "verificationSelection"],
      "properties": {
        "schemaVersion": {"const": "1.0-control-recovery-evidence"},
        "documentType": {"const": "governance-control-recovery-bootstrap-evidence"},
        "controlRecoveryId": {"$ref": "#/$defs/id"},
        "bootstrapUnit": {"$ref": "#/$defs/bootstrapId"},
        "attemptId": {"$ref": "#/$defs/attemptId"},
        "commit": {"$ref": "#/$defs/commit"},
        "baseCommit": {"$ref": "#/$defs/commit"},
        "branch": {"type": "string", "pattern": "^codex/.+"},
        "triggerWitness": {"$ref": "#/$defs/triggerWitness"},
        "changedFiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/canonicalPath"}, "uniqueItems": true},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterionEvidence"}},
        "findingClosures": {"type": "array", "items": {"$ref": "#/$defs/closure"}},
        "unverifiedItems": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "verificationSelection": {"$ref": "#/$defs/verificationSelection"}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "bootstrapUnit", "attemptId", "candidateCommit", "reviewedStateCommit", "reviewer", "result", "evidence", "findings", "closures", "notes"],
      "properties": {
        "schemaVersion": {"const": "1.0-control-recovery-review"},
        "documentType": {"const": "governance-control-recovery-bootstrap-review"},
        "controlRecoveryId": {"$ref": "#/$defs/id"},
        "bootstrapUnit": {"$ref": "#/$defs/bootstrapId"},
        "attemptId": {"$ref": "#/$defs/attemptId"},
        "candidateCommit": {"$ref": "#/$defs/commit"},
        "reviewedStateCommit": {"$ref": "#/$defs/commit"},
        "reviewer": {"type": "string", "minLength": 1},
        "result": {"enum": ["approved", "changes-requested", "blocked"]},
        "evidence": {"$ref": "#/$defs/reference"},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "closures": {"type": "array", "items": {"$ref": "#/$defs/closure"}},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "bootstrapUnit", "status", "approval", "triggerWitness", "attempts", "currentSubmission", "adoption"],
      "properties": {
        "schemaVersion": {"const": "1.0-control-recovery-state"},
        "documentType": {"const": "governance-control-recovery-bootstrap-state"},
        "controlRecoveryId": {"$ref": "#/$defs/id"},
        "bootstrapUnit": {"$ref": "#/$defs/bootstrapId"},
        "status": {"enum": ["REVIEW", "CHANGES_REQUESTED", "BLOCKED", "APPROVED", "ADOPTED", "ADOPTION_FINALIZATION"]},
        "approval": {"$ref": "#/$defs/reference"},
        "triggerWitness": {"$ref": "#/$defs/triggerWitness"},
        "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}},
        "currentSubmission": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/submission"}]},
        "adoption": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["adoptedBy", "adoptedAt", "predecessorRevision", "successorRevision", "reviewedStateCommit", "evidence"],
              "properties": {
                "adoptedBy": {"type": "string", "minLength": 1},
                "adoptedAt": {"$ref": "#/$defs/timestamp"},
                "predecessorRevision": {"const": 6},
                "successorRevision": {"const": 7},
                "reviewedStateCommit": {"$ref": "#/$defs/commit"},
                "evidence": {"$ref": "#/$defs/reference"}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "documentType", "controlRecoveryId", "bootstrapUnit", "reviewedStateCommit", "triggerWitness", "predecessorRevision", "successorRevision", "expectedChangedFiles", "checks", "unverifiedItems"],
      "properties": {
        "schemaVersion": {"const": "1.0-control-recovery-adoption-evidence"},
        "documentType": {"const": "governance-control-recovery-adoption-evidence"},
        "controlRecoveryId": {"$ref": "#/$defs/id"},
        "bootstrapUnit": {"$ref": "#/$defs/bootstrapId"},
        "reviewedStateCommit": {"$ref": "#/$defs/commit"},
        "triggerWitness": {"$ref": "#/$defs/triggerWitness"},
        "predecessorRevision": {"const": 6},
        "successorRevision": {"const": 7},
        "expectedChangedFiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/canonicalPath"}, "uniqueItems": true},
        "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
        "unverifiedItems": {"type": "array", "maxItems": 0, "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  ]
}
