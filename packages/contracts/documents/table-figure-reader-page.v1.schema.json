        "order": {
          "exclusiveMaximum": 1000,
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "jump": {
          "$ref": "#/$defs/StructureJump"
        },
        "captionState": {
          "enum": [
            "reported",
            "ambiguous",
            "not-reported",
            "unavailable"
          ],
          "title": "Captionstate",
          "type": "string"
        },
        "captionCount": {
          "maximum": 32,
          "minimum": 0,
