{
  "$defs": {
    "AcquisitionOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "remote-acquisition",
          "title": "Kind",
          "type": "string"
        },
        "locationId": {
          "$ref": "#/$defs/Identity"
        },
        "receiptSha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "kind",
        "locationId",
        "receiptSha256"
      ],
      "title": "AcquisitionOrigin",
      "type": "object"
    },
    "CodepointRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/Count"
        },
        "end": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "CodepointRange",
      "type": "object"
    },
    "ConfidenceObservation": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "reported",
            "unknown",
            "not-reported",
            "not-applicable",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "state",
        "value"
      ],
      "title": "ConfidenceObservation",
      "type": "object"
    },
    "CoordinatesState": {
      "enum": [
        "available",
        "not-reported",
        "format-has-no-pages",
        "unsupported-location",
        "parser-unavailable"
      ],
      "type": "string"
    },
    "Count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "DecisionCode": {
      "enum": [
        "allow",
        "deny",
        "unknown",
        "require-confirmation"
      ],
      "type": "string"
    },
    "DestinationKind": {
      "enum": [
        "local-project",
        "local-export",
        "remote-model",
        "external-export",
        "collaboration"
      ],
      "type": "string"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Format": {
      "enum": [
        "jats",
        "tei",
        "xml",
        "html",
        "pdf",
        "docx",
        "plain-text"
      ],
      "type": "string"
    },
    "Identity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "LocalOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "local-import",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LocalOrigin",
      "type": "object"
    },
    "NodeKind": {
      "enum": [
        "region",
        "title",
        "abstract",
        "section",
        "paragraph",
        "sentence",
        "list",
        "list-item",
        "footnote",
        "reference",
        "citation-marker",
        "table",
        "table-cell",
        "figure",
        "caption",
        "equation",
        "unknown"
      ],
      "type": "string"
    },
    "NormalizedPageRegion": {
      "additionalProperties": false,
      "properties": {
        "pageIndex": {
          "exclusiveMaximum": 500,
          "minimum": 0,
          "title": "Pageindex",
          "type": "integer"
        },
        "pageNumber": {
          "maximum": 500,
          "minimum": 1,
          "title": "Pagenumber",
          "type": "integer"
        },
        "x0": {
          "$ref": "#/$defs/UnitCoordinate"
        },
        "y0": {
          "$ref": "#/$defs/UnitCoordinate"
        },
        "x1": {
          "$ref": "#/$defs/UnitCoordinate"
        },
        "y1": {
          "$ref": "#/$defs/UnitCoordinate"
        },
        "sourceWidth": {
          "exclusiveMinimum": 0,
          "title": "Sourcewidth",
          "type": "number"
        },
        "sourceHeight": {
          "exclusiveMinimum": 0,
          "title": "Sourceheight",
          "type": "number"
        },
        "rotation": {
          "enum": [
            0,
            90,
            180,
            270
          ],
          "title": "Rotation",
          "type": "integer"
        },
        "frame": {
          "const": "unrotated-source-page",
          "default": "unrotated-source-page",
          "title": "Frame",
          "type": "string"
        },
        "origin": {
          "const": "top-left",
          "default": "top-left",
          "title": "Origin",
          "type": "string"
        },
        "unit": {
          "const": "normalized",
          "default": "normalized",
          "title": "Unit",
          "type": "string"
        },
        "granularity": {
          "const": "block",
          "default": "block",
          "title": "Granularity",
          "type": "string"
        }
      },
      "required": [
        "pageIndex",
        "pageNumber",
        "x0",
        "y0",
        "x1",
        "y1",
        "sourceWidth",
        "sourceHeight",
        "rotation"
      ],
      "title": "NormalizedPageRegion",
      "type": "object"
    },
    "ProjectIdentity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "RightsAction": {
      "enum": [
        "store",
        "inspect",
        "index",
        "derive",
        "model-use",
        "quote",
        "export",
        "share"
      ],
      "type": "string"
    },
    "RightsUse": {
      "additionalProperties": false,
      "description": "One action and an exact purpose/destination; there are no wildcards.",
      "properties": {
        "action": {
          "$ref": "#/$defs/RightsAction"
        },
        "purpose": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "title": "Purpose",
          "type": "string"
        },
        "destinationKind": {
          "$ref": "#/$defs/DestinationKind"
        },
        "provider": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "region": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "shareGroup": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sharegroup"
        }
      },
      "required": [
        "action",
        "purpose",
        "destinationKind"
      ],
      "title": "RightsUse",
      "type": "object"
    },
    "SourceIdentity": {
      "additionalProperties": false,
      "properties": {
        "projectId": {
          "$ref": "#/$defs/ProjectIdentity"
        },
        "attachmentId": {
          "$ref": "#/$defs/Identity"
        },
        "documentId": {
          "$ref": "#/$defs/Identity"
        },
        "documentRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "candidateId": {
          "$ref": "#/$defs/Identity"
        },
        "sourceAssertionRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "workId": {
          "$ref": "#/$defs/Identity"
        },
        "workRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "versionId": {
          "$ref": "#/$defs/Identity"
        },
        "versionRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "objectSha256": {
          "$ref": "#/$defs/Digest"
        },
        "byteLength": {
          "maximum": 134217728,
          "minimum": 0,
          "title": "Bytelength",
          "type": "integer"
        },
        "format": {
          "$ref": "#/$defs/Format"
        },
        "provenance": {
          "discriminator": {
            "mapping": {
              "local-import": "#/$defs/LocalOrigin",
              "remote-acquisition": "#/$defs/AcquisitionOrigin"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/LocalOrigin"
            },
            {
              "$ref": "#/$defs/AcquisitionOrigin"
            }
          ],
          "title": "Provenance"
        }
      },
      "required": [
        "projectId",
        "attachmentId",
        "documentId",
        "documentRevisionId",
        "candidateId",
        "sourceAssertionRevisionId",
        "workId",
        "workRevisionId",
        "versionId",
        "versionRevisionId",
        "objectSha256",
        "byteLength",
        "format",
        "provenance"
      ],
      "title": "SourceIdentity",
      "type": "object"
    },
    "UnitCoordinate": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "ViewerUseDecision": {
      "additionalProperties": false,
      "properties": {
        "use": {
          "$ref": "#/$defs/RightsUse"
        },
        "code": {
          "$ref": "#/$defs/DecisionCode"
        },
        "reasonCode": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "title": "Reasoncode",
          "type": "string"
        }
      },
      "required": [
        "use",
        "code",
        "reasonCode"
      ],
      "title": "ViewerUseDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceIdentity"
    },
    "normalizedRevisionId": {
      "$ref": "#/$defs/Identity"
    },
    "policyRevisionId": {
      "$ref": "#/$defs/Identity"
    },
    "scholarlyVerification": {
      "const": "unverified",
      "default": "unverified",
      "title": "Scholarlyverification",
      "type": "string"
    },
    "policyBasis": {
      "items": {
        "$ref": "#/$defs/ViewerUseDecision"
      },
      "maxItems": 4,
      "minItems": 2,
      "title": "Policybasis",
      "type": "array"
    },
    "action": {
      "const": "export-annotation",
      "title": "Action",
      "type": "string"
    },
    "anchorId": {
      "$ref": "#/$defs/Identity"
    },
    "anchorRevisionId": {
      "$ref": "#/$defs/Identity"
    },
    "nodeId": {
      "$ref": "#/$defs/Identity"
    },
    "nodeKind": {
      "$ref": "#/$defs/NodeKind"
    },
    "textPosition": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodepointRange"
        },
        {
          "type": "null"
        }
      ]
    },
    "pageRegion": {
      "anyOf": [
        {
          "$ref": "#/$defs/NormalizedPageRegion"
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "$ref": "#/$defs/ConfidenceObservation"
    },
    "coordinatesState": {
      "$ref": "#/$defs/CoordinatesState"
    }
  },
  "required": [
    "source",
    "normalizedRevisionId",
    "policyRevisionId",
    "policyBasis",
    "action",
    "anchorId",
    "anchorRevisionId",
    "nodeId",
    "nodeKind",
    "textPosition",
    "pageRegion",
    "confidence",
    "coordinatesState"
  ],
  "title": "ViewerAnnotationOutput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/contracts/documents/viewer-annotation-output.v1.schema.json",
  "x-research-observatory-semanticRules": [
    "fixed-action-specific-inspect-derive-quote-and-local-export-purposes-not-generic-project-export",
    "exact-retained-copy-source-assertion-human-intent-privacy-policy-and-anchor-authority",
    "explicit-trusted-human-permitted-use-review-is-idempotent-and-does-not-execute-an-action",
    "unrelated-assertions-identities-recorded-and-expiry-times-remain-immutable",
    "denial-expiry-dispute-and-propagation-cannot-be-overridden-by-missing-permission-review",
    "native-only-payload-no-renderer-text-path-actor-grant-or-program-authority",
    "fresh-permission-after-materialization-and-destination-before-native-publication",
    "exact-at-most-2048-codepoint-quotation-with-source-revision-anchor-and-citation-identifiers",
    "annotation-excludes-quotation-and-context-and-preserves-geometry-and-uncertainty",
    "content-free-denial-audit-and-direct-browser-transfer-disabled",
    "delivered-plaintext-is-explicitly-outside-project-protection-and-extraction-remains-unverified",
    "bounded-create-new-native-output-and-physical-closure-before-releasing-ownership"
  ]
}
