          "title": "Retainedpreviewstate",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Warnings",
          "type": "array"
        },
        "excluded": {
          "title": "Excluded",
          "type": "boolean"
        },
        "exclusion": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableFigureExclusion"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "nodeId",
        "kind",
        "order",
        "jump",
        "captionState",
        "captionCount",
        "captions",
        "labelCount",
        "labels",
        "rows",
        "columns",
        "gridState",
        "cellCount",
        "afterCell",
        "nextAfterCell",
        "cells",
        "confidence",
        "preview",
        "retainedPreviewState",
        "warnings",
        "excluded",
        "exclusion"
      ],
      "title": "TableFigureReaderEntry",
      "type": "object"
    },
    "UnavailableStructurePreview": {
      "additionalProperties": false,
