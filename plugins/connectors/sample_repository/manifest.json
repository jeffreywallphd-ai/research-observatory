{
  "schemaVersion": "1.0",
  "pluginId": "sample.repository",
  "pluginVersion": "1.0.0",
  "sdkVersion": "1.0.0",
  "requiredFeatures": ["source-assertions-v1", "brokered-requests-v1"],
  "publisherKeyId": "sample-repository-publisher",
