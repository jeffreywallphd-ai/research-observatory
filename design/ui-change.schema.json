{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/ui-change-evidence-1.4.json",
  "title": "Research Observatory UI change evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentType",
    "taskId",
    "changeKind",
    "contractPath",
    "implementationAgent",
    "changedFiles",
    "reference",
    "focusedEvidence"
  ],
  "properties": {
    "schemaVersion": {"enum": ["1.0", "1.1", "1.2", "1.3", "1.4"]},
    "documentType": {"const": "ui-change-evidence"},
    "taskId": {
      "type": "string",
      "pattern": "^(?:CAP-[0-9]{2}\\.S[0-9]{2}\\.T[0-9]{2}|W(?:[0-9]|1[01])\\.A[0-9]{2}\\.T[0-9]{2}|W(?:[0-9]|1[01])\\.C[0-9]{2,}\\.T01)$"
    },
    "changeKind": {
      "enum": ["intentional-design-change", "approved-reference-implementation", "defect-restoration"]
    },
    "contractPath": {
      "type": "string",
      "pattern": "^artifacts/evidence/ui-change/(?:CAP-[0-9]{2}\\.S[0-9]{2}\\.T[0-9]{2}|W(?:[0-9]|1[01])\\.A[0-9]{2}\\.T[0-9]{2}|W(?:[0-9]|1[01])\\.C[0-9]{2,}\\.T01)\\.json$"
    },
    "implementationAgent": {
      "type": "string",
      "pattern": "^(agent|human):[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "changedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
      "uniqueItems": true
    },
    "reference": {
      "type": "object",
      "required": [
        "referenceId",
        "version",
        "packageSha256",
        "approvalCommit",
        "approvedBy",
        "previousReferenceId"
      ],
      "properties": {
        "referenceId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "packageSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approvalCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "approvedBy": {"type": "string", "minLength": 1},
        "previousReferenceId": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "focusedEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "result", "scope"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "result": {"const": "passed"},
          "scope": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "restoration": {
      "type": "object",
      "required": ["defect", "expectedBehavior"],
      "properties": {
        "defect": {"type": "string", "minLength": 1},
        "expectedBehavior": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "implementationScope": {"type": "string", "minLength": 1},
    "restorationClassification": {
      "type": "object",
      "required": ["path", "sha256", "commit"],
      "properties": {
        "path": {"type": "string", "pattern": "^artifacts/evidence/W(?:[0-9]|1[01])\\.C[0-9]{2,}\\.T01\\.ui-classification-R[0-9]{2}\\.json$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "commit": {"$ref": "#/$defs/commit"}
      },
      "additionalProperties": false
    },
    "amendmentAuthority": {
      "type": "object",
      "required": ["correctionId", "adoptionCommit", "reactivationCommit", "inheritedCorrectionUiFiles", "resumedUiFiles", "classification"],
      "properties": {
        "correctionId": {"type": "string", "pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}$"},
        "adoptionCommit": {"$ref": "#/$defs/commit"},
        "reactivationCommit": {"$ref": "#/$defs/commit"},
        "inheritedCorrectionUiFiles": {"$ref": "#/properties/changedFiles"},
        "resumedUiFiles": {"$ref": "#/properties/changedFiles"},
        "classification": {
          "type": "object",
          "required": ["path", "sha256", "commit"],
          "properties": {
            "path": {"type": "string", "pattern": "^artifacts/evidence/W(?:[0-9]|1[01])\\.A[0-9]{2}\\.T[0-9]{2}\\.ui-classification-R[0-9]{2}\\.json$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "commit": {"$ref": "#/$defs/commit"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "intentionalAmendmentAuthority": {
      "type": "object",
      "required": ["amendmentId", "changeRequestId", "controlTaskId", "referenceApprovalPath"],
      "properties": {
        "amendmentId": {"const": "W2.A01"},
        "changeRequestId": {"const": "ECR-0009"},
        "controlTaskId": {"const": "W2.A01.T01"},
        "referenceApprovalPath": {"const": "planning/reference-approvals/RO-UI-ACADEMIC-MINIMAL-1.8.json"}
      },
      "additionalProperties": false
    },
    "adoptedContinuationAuthority": {
      "type": "object",
      "required": [
        "amendmentId",
        "changeRequestId",
        "controlTaskId",
        "inheritedAmendmentId",
        "inheritedTaskId",
        "inheritedContractPath",
        "adoptionCommit",
        "reactivationCommit",
        "inheritedUiFiles",
        "inheritedUiCommits",
        "resumedUiFiles",
        "resumedUiCommits",
        "classification"
      ],
      "properties": {
        "amendmentId": {"const": "W2.A02"},
        "changeRequestId": {"const": "ECR-0010"},
        "controlTaskId": {"const": "W2.A02.T01"},
        "inheritedAmendmentId": {"const": "W2.A01"},
        "inheritedTaskId": {"const": "W2.A01.T02"},
        "inheritedContractPath": {"const": "artifacts/evidence/ui-change/W2.A01.T02.json"},
        "adoptionCommit": {"$ref": "#/$defs/commit"},
        "reactivationCommit": {"$ref": "#/$defs/commit"},
        "inheritedUiFiles": {"$ref": "#/properties/changedFiles"},
        "inheritedUiCommits": {"$ref": "#/$defs/commits"},
        "resumedUiFiles": {"$ref": "#/properties/changedFiles"},
        "resumedUiCommits": {"$ref": "#/$defs/commits"},
        "classification": {
          "type": "object",
          "required": ["path", "sha256", "commit"],
          "properties": {
            "path": {"type": "string", "pattern": "^artifacts/evidence/CAP-05\\.S01\\.T01\\.ui-classification-R[0-9]{2}\\.json$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "commit": {"$ref": "#/$defs/commit"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "referenceActivationAuthority": {
      "type": "object",
      "required": [
        "amendmentId",
        "changeRequestId",
        "controlTaskId",
        "consumerTaskId",
        "referenceApprovalPath",
        "witnessPath",
        "publicationCommit",
        "witnessCommit",
        "adoptionCommit",
        "reactivationCommit",
        "activationUiFiles",
        "activationUiCommits"
      ],
      "properties": {
        "amendmentId": {"const": "W2.A03"},
        "changeRequestId": {"const": "ECR-0011"},
        "controlTaskId": {"const": "W2.A03.T01"},
        "consumerTaskId": {"const": "W2.A03.T02"},
        "referenceApprovalPath": {"const": "planning/reference-approvals/RO-UI-ACADEMIC-MINIMAL-1.8.json"},
        "witnessPath": {"const": "packages/contracts/workflow-profile/presentation-compatibility-1.8.json"},
        "publicationCommit": {"$ref": "#/$defs/commit"},
        "witnessCommit": {"$ref": "#/$defs/commit"},
        "adoptionCommit": {"$ref": "#/$defs/commit"},
        "reactivationCommit": {"$ref": "#/$defs/commit"},
        "activationUiFiles": {"$ref": "#/properties/changedFiles"},
        "activationUiCommits": {"$ref": "#/$defs/commits"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "commits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/commit"}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"required": ["restorationClassification"]},
      "then": {
        "properties": {
          "schemaVersion": {"const": "1.0"},
          "changeKind": {"const": "defect-restoration"},
          "taskId": {"pattern": "^W(?:[0-9]|1[01])\\.C[0-9]{2,}\\.T01$"}
        }
      }
    },
    {
      "if": {"properties": {"taskId": {"pattern": "^W(?:[0-9]|1[01])\\.C[0-9]{2,}\\.T01$"}}},
      "then": {"properties": {"schemaVersion": {"const": "1.0"}, "changeKind": {"const": "defect-restoration"}}}
    },
    {
      "if": {"properties": {"schemaVersion": {"const": "1.1"}}},
      "then": {
        "required": ["amendmentAuthority"],
        "properties": {
          "changeKind": {"const": "defect-restoration"},
          "taskId": {"pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}\\.T[0-9]{2}$"}
        }
      },
      "else": {"not": {"required": ["amendmentAuthority"]}}
    },
    {
      "if": {"properties": {"schemaVersion": {"const": "1.2"}}},
      "then": {
        "required": ["intentionalAmendmentAuthority"],
        "properties": {
          "taskId": {"const": "W2.A01.T02"},
          "changeKind": {"const": "intentional-design-change"},
          "reference": {
            "properties": {
              "referenceId": {"const": "RO-UI-ACADEMIC-MINIMAL-1.8"},
              "version": {"const": "1.8"},
              "previousReferenceId": {"const": "RO-UI-ACADEMIC-MINIMAL-1.7"}
            }
          }
        },
        "not": {"anyOf": [{"required": ["restoration"]}, {"required": ["restorationClassification"]}]}
      },
      "else": {"not": {"required": ["intentionalAmendmentAuthority"]}}
    },
    {
      "if": {"properties": {"schemaVersion": {"enum": ["1.3", "1.4"]}}},
      "then": {
        "required": ["adoptedContinuationAuthority"],
        "properties": {
          "taskId": {"const": "CAP-05.S01.T01"},
          "changeKind": {"const": "defect-restoration"},
          "reference": {
            "properties": {
              "referenceId": {"const": "RO-UI-ACADEMIC-MINIMAL-1.8"},
              "version": {"const": "1.8"},
              "previousReferenceId": {"const": "RO-UI-ACADEMIC-MINIMAL-1.7"}
            }
          }
        },
        "not": {
          "anyOf": [
            {"required": ["restorationClassification"]},
            {"required": ["amendmentAuthority"]},
            {"required": ["intentionalAmendmentAuthority"]}
          ]
        }
      },
      "else": {"not": {"required": ["adoptedContinuationAuthority"]}}
    },
    {
      "if": {"properties": {"schemaVersion": {"const": "1.4"}}},
      "then": {
        "required": ["referenceActivationAuthority", "adoptedContinuationAuthority"],
        "properties": {
          "taskId": {"const": "CAP-05.S01.T01"},
          "changeKind": {"const": "defect-restoration"}
        }
      },
      "else": {"not": {"required": ["referenceActivationAuthority"]}}
    },
    {
      "if": {"properties": {"changeKind": {"const": "defect-restoration"}}},
      "then": {"required": ["restoration"]}
    },
    {
      "if": {"properties": {"changeKind": {"enum": ["intentional-design-change", "approved-reference-implementation"]}}},
      "then": {"required": ["implementationScope"]}
    }
  ],
  "additionalProperties": false
}
