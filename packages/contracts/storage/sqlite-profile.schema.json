{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/contracts/storage/sqlite-profile.schema.json",
  "title": "Research Observatory SQLite profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "profileId",
    "databaseSchemaVersion",
    "applicationId",
    "schemaFingerprintSha256",
    "minimumSqliteVersion",
    "identifierStorage",
    "timestampStorage",
    "canonicalColumnTypes",
    "derivedBinaryStorage",
    "objectCreationSources",
    "immutableRowTables",
    "mutableStateTables",
    "connectionProfile",
    "checkpointPolicy",
    "integrityChecks",
    "canonicalTables"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "documentType": {"const": "research-observatory-sqlite-profile"},
    "profileId": {"const": "sqlite-wal-v1"},
    "databaseSchemaVersion": {"const": 10},
    "applicationId": {"const": 1380926035},
    "schemaFingerprintSha256": {"const": "49459b9ca8e54d27ad45abf16615946107a8d73e1ba8e211f1c45bc8fa230187"},
    "minimumSqliteVersion": {"const": "3.37.0"},
    "identifierStorage": {
      "const": {
        "project": "uuid4-bridge-or-uuid7-lowercase-text",
        "aggregate": "uuid7-lowercase-text",
        "revision": "uuid7-lowercase-text",
        "event": "uuid7-lowercase-text",
        "actor": "canonical-id-or-uuid7-lowercase-text",
        "setting": "uuid7-lowercase-text"
      }
    },
    "timestampStorage": {"const": "utc-rfc3339-millisecond-text"},
    "canonicalColumnTypes": {"const": ["INTEGER", "REAL", "TEXT"]},
    "derivedBinaryStorage": {"const": "digest-reference-only"},
    "objectCreationSources": {
      "const": [
        "local-import",
        "connector-acquisition",
        "local-derivation",
        "test-fixture",
        "legacy-unreported"
      ]
    },
    "immutableRowTables": {
      "const": [
        "schema_metadata",
        "schema_migrations",
        "projects",
        "aggregate_identities",
        "aggregate_revisions",
        "scholarly_records",
        "documents",
        "workflows",
        "workflow_definitions",
        "workflow_authority_snapshots",
        "workflow_history_events",
        "workflow_checkpoints",
        "workflow_committed_outputs",
        "material_dependency_outputs",
        "material_dependencies",
        "material_dependency_diagnostics",
        "dependency_impact_runs",
        "dependency_impact_decisions",
        "dependency_impact_items",
        "dependency_stale_causes",
        "dependency_impact_audit_events",
        "evidence",
        "ontologies",
        "decisions",
        "provenance_events",
        "provenance_ledger_events",
        "provenance_ledger_entities",
        "provenance_ledger_relations",
        "provenance_ledger_checkpoints",
        "provenance_legacy_bridges",
        "settings"
      ]
    },
    "mutableStateTables": {
      "const": [
        "object_records",
        "object_envelope_upgrades",
        "outbox_events",
        "workflow_queue_jobs",
        "workflow_job_attempts",
        "workflow_attempt_artifacts"
      ]
    },
    "connectionProfile": {
      "const": {
        "foreignKeys": true,
        "journalMode": "wal",
        "synchronous": "full",
        "busyTimeoutMilliseconds": 5000,
        "trustedSchema": false,
        "defensive": true,
        "doubleQuotedStringLiterals": false,
        "loadableExtensions": false,
        "recursiveTriggers": true,
        "walAutocheckpointPages": 1000,
        "lockingMode": "normal",
        "schemaChanges": "dedicated-backed-up-migration-connection-only"
      }
    },
    "checkpointPolicy": {
      "const": {
        "automaticMode": "passive",
        "automaticPages": 1000,
        "manualAuthority": "migration-backup-and-maintenance-only"
      }
    },
    "integrityChecks": {
      "const": ["quick_check", "foreign_key_check", "strict_table_inventory"]
    },
    "canonicalTables": {
      "const": [
        "schema_metadata",
        "schema_migrations",
        "projects",
        "object_records",
        "object_envelope_upgrades",
        "aggregate_identities",
        "aggregate_revisions",
        "scholarly_records",
        "documents",
        "workflows",
        "workflow_definitions",
        "workflow_authority_snapshots",
        "workflow_queue_jobs",
        "workflow_job_attempts",
        "workflow_attempt_artifacts",
        "workflow_history_events",
        "workflow_checkpoints",
        "workflow_committed_outputs",
        "material_dependency_outputs",
        "material_dependencies",
        "material_dependency_diagnostics",
        "dependency_impact_runs",
        "dependency_impact_decisions",
        "dependency_impact_items",
        "dependency_stale_causes",
        "dependency_impact_audit_events",
        "evidence",
        "ontologies",
        "decisions",
        "provenance_events",
        "provenance_ledger_events",
        "provenance_ledger_entities",
        "provenance_ledger_relations",
        "provenance_ledger_checkpoints",
        "provenance_legacy_bridges",
        "settings",
        "outbox_events"
      ]
    }
  }
}
