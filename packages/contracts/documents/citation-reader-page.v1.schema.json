      "title": "LocalOrigin",
      "type": "object"
    },
    "NodeKind": {
      "enum": [
        "region",
        "title",
        "abstract",
        "section",
        "paragraph",
        "sentence",
        "list",
        "list-item",
        "footnote",
        "reference",
        "citation-marker",
        "table",
        "table-cell",
        "figure",
        "caption",
        "equation",
        "unknown"
      ],
      "type": "string"
