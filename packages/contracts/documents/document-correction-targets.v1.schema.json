{
  "$defs": {
    "CorrectionWorkTarget": {
      "additionalProperties": false,
      "properties": {
        "workId": {
          "$ref": "#/$defs/Identity"
        },
        "workRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "title": {
          "$ref": "#/$defs/Preview"
        },
        "scholarlyVerification": {
          "const": "unverified",
          "default": "unverified",
          "title": "Scholarlyverification",
          "type": "string"
        }
      },
      "required": [
        "workId",
        "workRevisionId",
        "title"
      ],
      "title": "CorrectionWorkTarget",
      "type": "object"
    },
    "Identity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Preview": {
      "maxLength": 160,
      "type": "string"
    },
    "ProjectIdentity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "projectId": {
      "$ref": "#/$defs/ProjectIdentity"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/CorrectionWorkTarget"
      },
      "maxItems": 10,
      "title": "Items",
      "type": "array"
    },
    "nextAfterWorkId": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identity"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "projectId",
    "items",
    "nextAfterWorkId"
  ],
  "title": "CorrectionWorkTargets",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
