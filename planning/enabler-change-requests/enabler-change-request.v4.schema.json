{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/enabler-change-request.packet.v4.json",
  "title": "Post-migration product-authority Wave amendment packet",
  "type": "object",
  "required": [
    "$schema", "schemaVersion", "documentType", "changeRequestId", "proposedAmendmentId", "targetWave",
    "status", "executionState", "classification", "authorityChain", "migrationAuthority", "activationBoundary",
    "bootstrapUnit", "sliceContributions", "authorizedTaskIds", "taskInventory", "refactorBudget",
    "governedExperience", "acceptanceCriteria", "verificationObligations", "rollback", "nonGoals", "files"
  ],
  "properties": {
    "$schema": {"const": "./enabler-change-request.v4.schema.json"},
    "schemaVersion": {"const": "4.0-proposal"},
    "documentType": {"const": "enabler-change-request-packet"},
    "changeRequestId": {"$ref": "#/$defs/ecr"},
    "proposedAmendmentId": {"$ref": "#/$defs/amendment"},
    "targetWave": {"$ref": "#/$defs/wave"},
    "status": {"const": "pending-approval"},
    "executionState": {"const": "non-executable"},
    "classification": {"const": "product-scope-security-experience"},
    "authorityChain": {
      "type": "object",
      "required": ["waveBase", "orderedAmendments", "reservedAmendments"],
      "properties": {
        "waveBase": {
          "type": "object",
          "required": ["waveId", "packetCommit", "approvalRecordCommit"],
          "properties": {
            "waveId": {"$ref": "#/$defs/wave"},
            "packetCommit": {"$ref": "#/$defs/commit"},
            "approvalRecordCommit": {"$ref": "#/$defs/commit"}
          },
          "additionalProperties": false
        },
        "orderedAmendments": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/adoptedAmendment"}
        },
        "reservedAmendments": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reservedAmendment"}
        }
      },
      "additionalProperties": false
    },
    "migrationAuthority": {"$ref": "#/$defs/migrationReference"},
    "activationBoundary": {
      "type": "object",
      "required": [
        "waveStatus", "ordinaryTaskStatesDenied", "reviewCandidateMutationDenied",
        "otherEnablerCampaignDenied", "activeRecoveryHolds"
      ],
      "properties": {
        "waveStatus": {"const": "PAUSED"},
        "ordinaryTaskStatesDenied": {"const": ["IN_PROGRESS", "REVIEW"]},
        "reviewCandidateMutationDenied": {"const": true},
        "otherEnablerCampaignDenied": {"const": true},
        "activeRecoveryHolds": {"const": []}
      },
      "additionalProperties": false
    },
    "bootstrapUnit": {
      "type": "object",
      "required": ["id", "kind", "exceptionReason", "authorizedPaths", "requiredOutcomes", "prohibitedOutcomes"],
      "properties": {
        "id": {"type": "string", "pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}\\.B[0-9]{2}$"},
        "kind": {"const": "append-only-amendment-bootstrap"},
        "exceptionReason": {"type": "string", "minLength": 1},
        "authorizedPaths": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/scopedPath"}
        },
        "requiredOutcomes": {"$ref": "#/$defs/nonEmptyStrings"},
        "prohibitedOutcomes": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "additionalProperties": false
    },
    "sliceContributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "capabilityId", "title", "objective", "workType", "refactorTaskIds", "taskIds", "acceptanceCriteria"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/slice"},
          "capabilityId": {"type": "string", "pattern": "^CAP-[0-9]{2}$"},
          "title": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "workType": {"enum": ["new-product-work", "mixed-refactor-and-new"]},
          "refactorTaskIds": {
            "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/task"}
          },
          "taskIds": {
            "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/task"}
          },
          "acceptanceCriteria": {"$ref": "#/$defs/nonEmptyStrings"}
        },
        "additionalProperties": false
      }
    },
    "authorizedTaskIds": {
      "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/task"}
    },
    "taskInventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "objective", "estimate", "dependencies", "acceptanceCriteria", "verification"],
        "properties": {
          "id": {"$ref": "#/$defs/task"},
          "title": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "estimate": {"$ref": "#/$defs/estimate"},
          "dependencies": {
            "type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}
          },
          "acceptanceCriteria": {"$ref": "#/$defs/nonEmptyStrings"},
          "verification": {"$ref": "#/$defs/nonEmptyStrings"}
        },
        "additionalProperties": false
      }
    },
    "refactorBudget": {
      "type": "object",
      "required": [
        "baseline", "refactorAllocations", "refactorPoints", "refactorSharePercent", "limitPolicy",
        "refactorTaskIds", "method"
      ],
      "properties": {
        "baseline": {
          "type": "object",
          "required": ["waveId", "sourceCommit", "sourcePath", "estimateScale", "tasks", "totalPoints"],
          "properties": {
            "waveId": {"$ref": "#/$defs/wave"},
            "sourceCommit": {"$ref": "#/$defs/commit"},
            "sourcePath": {"const": "planning/backlog.yaml"},
            "estimateScale": {
              "type": "object",
              "required": ["S", "M", "L"],
              "properties": {
                "S": {"const": 1},
                "M": {"const": 3},
                "L": {"const": 5}
              },
              "additionalProperties": false
            },
            "tasks": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": ["id", "estimate", "points"],
                "properties": {
                  "id": {"$ref": "#/$defs/canonicalTask"},
                  "estimate": {"$ref": "#/$defs/estimate"},
                  "points": {"enum": [1, 3, 5]}
                },
                "additionalProperties": false
              }
            },
            "totalPoints": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "refactorAllocations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["taskId", "estimate", "points"],
            "properties": {
              "taskId": {"$ref": "#/$defs/task"},
              "estimate": {"$ref": "#/$defs/estimate"},
              "points": {"enum": [1, 3, 5]}
            },
            "additionalProperties": false
          }
        },
        "refactorPoints": {"type": "number", "minimum": 0},
        "refactorSharePercent": {"type": "number", "minimum": 0, "maximum": 100},
        "limitPolicy": {
          "oneOf": [
            {
              "type": "object",
              "required": ["mode", "limitPercent"],
              "properties": {
                "mode": {"const": "standard-15-percent"},
                "limitPercent": {"const": 15}
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["mode", "authorizedBy", "authorization", "scopeTaskIds", "rationale"],
              "properties": {
                "mode": {"const": "owner-directed-wave-exception"},
                "authorizedBy": {"const": "repository-owner"},
                "authorization": {"type": "string", "minLength": 1},
                "scopeTaskIds": {
                  "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/task"}
                },
                "rationale": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          ]
        },
        "refactorTaskIds": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/task"}
        },
        "method": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "governedExperience": {
      "type": "object",
      "required": ["referenceId", "approvalRequired", "files"],
      "properties": {
        "referenceId": {"type": "string", "minLength": 1},
        "approvalRequired": {"const": true},
        "files": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryFile"}
        }
      },
      "additionalProperties": false
    },
    "acceptanceCriteria": {"$ref": "#/$defs/nonEmptyStrings"},
    "verificationObligations": {"$ref": "#/$defs/nonEmptyStrings"},
    "rollback": {"$ref": "#/$defs/nonEmptyStrings"},
    "nonGoals": {"$ref": "#/$defs/nonEmptyStrings"},
    "files": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": {"$ref": "#/$defs/ecrPath"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "role": {"enum": ["canonical-proposal", "proposal-schema", "human-review"]}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "wave": {"type": "string", "pattern": "^W(?:[0-9]|1[01])$"},
    "ecr": {"type": "string", "pattern": "^ECR-[0-9]{4}$"},
    "amendment": {"type": "string", "pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}$"},
    "slice": {"type": "string", "pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}\\.S[0-9]{2}$"},
    "task": {"type": "string", "pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}\\.T[0-9]{2}$"},
    "canonicalTask": {"type": "string", "pattern": "^CAP-[0-9]{2}\\.S[0-9]{2}\\.T[0-9]{2}$"},
    "estimate": {"enum": ["S", "M", "L"]},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ecrPath": {
      "type": "string",
      "pattern": "^planning/enabler-change-requests/(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "scopedPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._*/-]+$"
    },
    "approvalReference": {
      "type": "object",
      "required": ["path", "sha256", "introductionCommit"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^planning/wave-amendment-approvals/W(?:[0-9]|1[01])\\.A[0-9]{2}\\.json$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "introductionCommit": {"$ref": "#/$defs/commit"}
      },
      "additionalProperties": false
    },
    "adoptedAmendment": {
      "type": "object",
      "required": ["id", "changeRequestId", "status", "packetCommit", "approvalReference", "effectiveStateCommit"],
      "properties": {
        "id": {"$ref": "#/$defs/amendment"},
        "changeRequestId": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/ecr"}]},
        "status": {"const": "ADOPTED"},
        "packetCommit": {"$ref": "#/$defs/commit"},
        "approvalReference": {"$ref": "#/$defs/approvalReference"},
        "effectiveStateCommit": {"$ref": "#/$defs/commit"}
      },
      "additionalProperties": false
    },
    "reservedAmendment": {
      "type": "object",
      "required": ["id", "changeRequestId", "status", "packetCommit", "approvalReference", "supersededByMigration"],
      "properties": {
        "id": {"$ref": "#/$defs/amendment"},
        "changeRequestId": {"$ref": "#/$defs/ecr"},
        "status": {"const": "APPROVED_UNMATERIALIZED_SUPERSEDED"},
        "packetCommit": {"$ref": "#/$defs/commit"},
        "approvalReference": {"$ref": "#/$defs/approvalReference"},
        "supersededByMigration": {"$ref": "#/$defs/migrationReference"}
      },
      "additionalProperties": false
    },
    "migrationReference": {
      "type": "object",
      "required": ["id", "path", "sha256", "commit"],
      "properties": {
        "id": {"type": "string", "pattern": "^GOV-MIG-[0-9]{4}$"},
        "path": {"type": "string", "pattern": "^planning/governance-migrations/GOV-MIG-[0-9]{4}\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "commit": {"$ref": "#/$defs/commit"}
      },
      "additionalProperties": false
    },
    "repositoryFile": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "nonEmptyStrings": {
      "type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
