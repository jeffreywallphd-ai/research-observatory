{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/governance-control-recovery-request.v1.json",
  "title": "Governance control-recovery request packet",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "documentType",
    "controlRecoveryId",
    "title",
    "targetWave",
    "status",
    "executionState",
    "classification",
    "rootAuthority",
    "authorityChain",
    "triggerEvidence",
    "activationBoundary",
    "generationTransition",
    "lifecycle",
    "bootstrapUnit",
    "acceptanceCriteria",
    "verificationObligations",
    "rollback",
    "alternatives",
    "files",
    "requiredApprovalStatement"
  ],
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonicalPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._*/-]+$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifactReference": {
      "type": "object",
      "required": ["path", "sha256", "commit"],
      "properties": {
        "path": {"$ref": "#/$defs/canonicalPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "commit": {"$ref": "#/$defs/commit"}
      },
      "additionalProperties": false
    },
    "fileReference": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/canonicalPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "$schema": {"const": "./governance-control-recovery-request.schema.json"},
    "schemaVersion": {"const": "1.0-control-recovery-proposal"},
    "documentType": {"const": "governance-control-recovery-request-packet"},
    "controlRecoveryId": {"type": "string", "pattern": "^GCR-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 1},
    "targetWave": {"type": "string", "pattern": "^W(?:[0-9]|1[01])$"},
    "status": {"const": "pending-human-approval"},
    "executionState": {"const": "non-executable"},
    "classification": {"const": "recovery-controller-generation-defect"},
    "rootAuthority": {
      "type": "object",
      "required": ["basis", "exceptionScope", "packetReviewHistory", "approvalSchema", "approvalPath", "approvalIntroduction"],
      "properties": {
        "basis": {"const": "repository-owner-governance-mismatch-protocol"},
        "exceptionScope": {"const": "one-time-exact-packet-bootstrap-only"},
        "packetReviewHistory": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifactReference"}
        },
        "approvalSchema": {"$ref": "#/$defs/fileReference"},
        "approvalPath": {
          "type": "string",
          "pattern": "^planning/governance-control-recovery/GCR-[0-9]{4}\\.approval\\.json$"
        },
        "approvalIntroduction": {
          "type": "object",
          "required": ["exclusiveCreate", "cleanExactBranchHead", "packetReviewApproved", "introductionCommitIsExecutionBase"],
          "properties": {
            "exclusiveCreate": {"const": true},
            "cleanExactBranchHead": {"const": true},
            "packetReviewApproved": {"const": true},
            "introductionCommitIsExecutionBase": {"const": true}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "authorityChain": {
      "type": "object",
      "required": ["activeRecovery", "approvedRepairAmendment", "blockedBootstrap"],
      "properties": {
        "activeRecovery": {
          "type": "object",
          "required": ["requestId", "holdId", "packet", "approval", "bootstrapReview"],
          "properties": {
            "requestId": {"type": "string", "pattern": "^GRR-[0-9]{4}$"},
            "holdId": {"type": "string", "pattern": "^HOLD-W(?:[0-9]|1[01])-GRR-[0-9]{4}$"},
            "packet": {"$ref": "#/$defs/artifactReference"},
            "approval": {"$ref": "#/$defs/artifactReference"},
            "bootstrapReview": {"$ref": "#/$defs/artifactReference"}
          },
          "additionalProperties": false
        },
        "approvedRepairAmendment": {
          "type": "object",
          "required": ["changeRequestId", "amendmentId", "packet", "approval"],
          "properties": {
            "changeRequestId": {"type": "string", "pattern": "^ECR-[0-9]{4}$"},
            "amendmentId": {"type": "string", "pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}$"},
            "packet": {"$ref": "#/$defs/artifactReference"},
            "approval": {"$ref": "#/$defs/artifactReference"}
          },
          "additionalProperties": false
        },
        "blockedBootstrap": {
          "type": "object",
          "required": ["id", "candidateCommit", "evidencePath", "evidenceSha256"],
          "properties": {
            "id": {"type": "string", "pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}\\.B00$"},
            "candidateCommit": {"$ref": "#/$defs/commit"},
            "evidencePath": {"$ref": "#/$defs/canonicalPath"},
            "evidenceSha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "triggerEvidence": {
      "type": "object",
      "required": ["discoveryCommit", "backlogSha256", "failedCommand", "diagnostic", "atomicNoMutation", "independentAudit"],
      "properties": {
        "discoveryCommit": {"$ref": "#/$defs/commit"},
        "backlogSha256": {"$ref": "#/$defs/sha256"},
        "failedCommand": {"type": "string", "minLength": 1},
        "diagnostic": {"type": "string", "minLength": 1},
        "atomicNoMutation": {"const": true},
        "independentAudit": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "activationBoundary": {
      "type": "object",
      "required": ["controlRevision", "holdId", "holdStatus", "waveStatus", "waveScope", "taskId", "taskStatus", "amendmentId", "amendmentBacklogStatus", "releaseGate", "releaseGateStatus"],
      "properties": {
        "controlRevision": {"type": "integer", "minimum": 1},
        "holdId": {"type": "string", "pattern": "^HOLD-W(?:[0-9]|1[01])-GRR-[0-9]{4}$"},
        "holdStatus": {"const": "ACTIVE"},
        "waveStatus": {"const": "PAUSED"},
        "waveScope": {"enum": ["wave", "amendment-hold"]},
        "taskId": {"type": "string", "pattern": "^CAP-[0-9]{2}\\.S[0-9]{2}\\.T[0-9]{2}$"},
        "taskStatus": {"const": "BLOCKED"},
        "amendmentId": {"type": "string", "pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}$"},
        "amendmentBacklogStatus": {"const": "ABSENT"},
        "releaseGate": {"type": "string", "pattern": "^G(?:[0-9]|1[01])$"},
        "releaseGateStatus": {"const": "PENDING"}
      },
      "additionalProperties": false
    },
    "generationTransition": {
      "type": "object",
      "required": ["predecessorControlRevision", "nextControlRevision", "existingHoldPreserved", "newHoldCreated", "installationMode", "postBootstrapGate"],
      "properties": {
        "predecessorControlRevision": {"type": "integer", "minimum": 1},
        "nextControlRevision": {"type": "integer", "minimum": 2},
        "existingHoldPreserved": {"const": true},
        "newHoldCreated": {"const": false},
        "installationMode": {"const": "exact-packet-root-bootstrap"},
        "postBootstrapGate": {"const": "independently-approved-GRR-0002.S01-B01"}
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": ["branch", "actor", "canonicalPaths", "submission", "review", "remediation", "adoption", "commands"],
      "properties": {
        "branch": {"type": "string", "pattern": "^codex/.+"},
        "actor": {"type": "string", "minLength": 1},
        "canonicalPaths": {
          "type": "object",
          "required": ["controller", "state", "evidencePattern", "reviewPattern", "adoptionEvidence"],
          "properties": {
            "controller": {"$ref": "#/$defs/canonicalPath"},
            "state": {"$ref": "#/$defs/canonicalPath"},
            "evidencePattern": {"$ref": "#/$defs/canonicalPath"},
            "reviewPattern": {"$ref": "#/$defs/canonicalPath"},
            "adoptionEvidence": {"$ref": "#/$defs/canonicalPath"}
          },
          "additionalProperties": false
        },
        "submission": {
          "type": "object",
          "required": ["base", "candidateAncestry", "cleanBranchAndHead", "pathComparison", "staleWriter", "atomicFailure", "liveRevisionDuringReview", "untrackedException"],
          "properties": {
            "base": {"const": "approval-introduction-commit"},
            "candidateAncestry": {"const": "strict-descendant"},
            "cleanBranchAndHead": {"const": true},
            "pathComparison": {"const": "approval-base-to-candidate-exact-allowlist"},
            "staleWriter": {"const": "compare-and-swap"},
            "atomicFailure": {"const": "byte-stable"},
            "liveRevisionDuringReview": {"const": 6},
            "untrackedException": {"const": "only-canonical-current-attempt-evidence"}
          },
          "additionalProperties": false
        },
        "review": {
          "type": "object",
          "required": ["independent", "severityRanked", "reviewedStateBinding", "immutableAttempts", "blockingFindingDenial", "selfReviewDenied"],
          "properties": {
            "independent": {"const": true},
            "severityRanked": {"const": true},
            "reviewedStateBinding": {"const": true},
            "immutableAttempts": {"const": true},
            "blockingFindingDenial": {"const": true},
            "selfReviewDenied": {"const": true}
          },
          "additionalProperties": false
        },
        "remediation": {
          "type": "object",
          "required": ["candidateAncestry", "freshEvidence", "explicitClosures", "priorAttemptsPreserved"],
          "properties": {
            "candidateAncestry": {"const": "strict-descendant-of-prior-candidate"},
            "freshEvidence": {"const": true},
            "explicitClosures": {"const": true},
            "priorAttemptsPreserved": {"const": true}
          },
          "additionalProperties": false
        },
        "adoption": {
          "type": "object",
          "required": ["requiresApprovedB00", "predecessorRevision", "successorRevision", "singleGenerationRecord", "directChildOfEvidenceCommit", "exactChangedPaths", "olderReadersFailClosed", "postAdoptionGate"],
          "properties": {
            "requiresApprovedB00": {"const": true},
            "predecessorRevision": {"const": 6},
            "successorRevision": {"const": 7},
            "singleGenerationRecord": {"const": true},
            "directChildOfEvidenceCommit": {"const": true},
            "exactChangedPaths": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/canonicalPath"}
            },
            "olderReadersFailClosed": {"const": true},
            "postAdoptionGate": {"const": "separate-GRR-0002.S01-review-and-exact-approval"}
          },
          "additionalProperties": false
        },
        "commands": {
          "type": "object",
          "required": ["submit", "review", "resubmit", "adopt", "validate"],
          "properties": {
            "submit": {"type": "string", "minLength": 1},
            "review": {"type": "string", "minLength": 1},
            "resubmit": {"type": "string", "minLength": 1},
            "adopt": {"type": "string", "minLength": 1},
            "validate": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "bootstrapUnit": {
      "type": "object",
      "required": ["id", "kind", "exceptionReason", "authorizedPaths", "requiredOutcomes", "prohibitedOutcomes"],
      "properties": {
        "id": {"type": "string", "pattern": "^GCR-[0-9]{4}\\.B00$"},
        "kind": {"const": "one-time-recovery-controller-generation"},
        "exceptionReason": {"type": "string", "minLength": 1},
        "authorizedPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/canonicalPath"}
        },
        "requiredOutcomes": {"$ref": "#/$defs/nonEmptyStrings"},
        "prohibitedOutcomes": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "additionalProperties": false
    },
    "acceptanceCriteria": {"$ref": "#/$defs/nonEmptyStrings"},
    "verificationObligations": {"$ref": "#/$defs/nonEmptyStrings"},
    "rollback": {"$ref": "#/$defs/nonEmptyStrings"},
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "title", "disposition", "consequence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["recommended", "safe", "rejected"]},
          "consequence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fileReference"}
    },
    "requiredApprovalStatement": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
