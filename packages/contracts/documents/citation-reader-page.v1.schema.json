        "locationId": {
          "$ref": "#/$defs/Identity"
        },
        "receiptSha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "kind",
        "locationId",
        "receiptSha256"
      ],
      "title": "AcquisitionOrigin",
      "type": "object"
    },
    "AnchorContext": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/Count"
        },
        "text": {
          "maxLength": 8192,
          "title": "Text",
          "type": "string"
        },
        "highlight": {
          "$ref": "#/$defs/CodepointRange"
        }
      },
      "required": [
        "start",
        "text",
        "highlight"
      ],
      "title": "AnchorContext",
      "type": "object"
    },
    "AnchorQuote": {
      "additionalProperties": false,
      "properties": {
        "exact": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Exact",
          "type": "string"
        },
        "prefix": {
          "maxLength": 64,
          "title": "Prefix",
          "type": "string"
        },
        "suffix": {
          "maxLength": 64,
          "title": "Suffix",
          "type": "string"
        }
      },
      "required": [
        "exact",
        "prefix",
        "suffix"
      ],
      "title": "AnchorQuote",
      "type": "object"
    },
    "CanonicalWorkReference": {
      "additionalProperties": false,
      "properties": {
        "workId": {
          "$ref": "#/$defs/Identity"
        },
        "revisionId": {
          "$ref": "#/$defs/Identity"
        }
      },
      "required": [
        "workId",
        "revisionId"
      ],
      "title": "CanonicalWorkReference",
      "type": "object"
    },
    "CitationContextPreview": {
      "additionalProperties": false,
