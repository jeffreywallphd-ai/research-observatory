{
  "schemaVersion": "1.0",
  "documentType": "continuous-integration-policy",
  "workflowPath": ".github/workflows/ci.yml",
  "runner": "windows-2025",
  "artifactRetentionDays": 14,
  "allowedActions": {
    "actions/checkout": {
      "version": "v6.0.2",
      "sha": "de0fac2e4500dabe0009e67214ff5f5447ce83dd"
    },
    "actions/setup-python": {
      "version": "v6.3.0",
      "sha": "ece7cb06caefa5fff74198d8649806c4678c61a1"
    },
    "actions/setup-node": {
      "version": "v7.0.0",
      "sha": "820762786026740c76f36085b0efc47a31fe5020"
    },
    "actions/upload-artifact": {
      "version": "v7.0.1",
      "sha": "043fb46d1a93c77aae656e7c1c64a875d1fc6a0a"
    }
  },
  "jobs": {
    "foundation": {
      "artifactPath": "artifacts/tmp/ci-foundation.json",
      "requiredRunFragments": [
        "uv==0.12.2",
        "uv sync --frozen --no-install-project",
        "tools/verify.py --profile foundation"
      ]
    },
    "quality": {
      "artifactPath": "artifacts/tmp/ci-quality.json",
      "requiredRunFragments": [
        "uv==0.12.2",
        "uv sync --frozen --no-install-project",
        "tools/quality_check.py"
      ]
    },
    "desktop-ui": {
      "artifactPath": "artifacts/tmp/ci-desktop-ui.json",
      "requiredRunFragments": [
        "uv==0.12.2",
        "uv sync --frozen --no-install-project",
        "playwright.exe install chromium",
        "tools/verify.py --profile desktop"
      ]
    },
    "security": {
      "artifactPath": "artifacts/tmp/ci-security.json",
      "requiredRunFragments": [
        "uv==0.12.2",
        "uv sync --frozen --no-install-project",
        "tools/install_trivy.py",
        "tools/security_check.py",
        "unittest discover -s tests/security"
      ]
    },
    "contracts": {
      "artifactPath": "artifacts/tmp/ci-contracts.json",
      "requiredRunFragments": [
        "uv==0.12.2",
        "uv sync --frozen --no-install-project",
        "tools/verify.py --profile service"
      ]
    },
    "packaging-smoke": {
      "artifactPath": "artifacts/tmp/ci-packaging-smoke.json",
      "requiredRunFragments": [
        "uv==0.12.2",
        "uv sync --frozen --no-install-project",
        "pnpm@11.20.0",
        "pnpm install --frozen-lockfile",
        "1.96.1",
        "cargo fetch --locked",
        "tools/packaging_smoke_check.py"
      ]
    }
  }
}
