{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/schemas/ui-change-evidence-1.1.json",
  "title": "Research Observatory UI change evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "documentType",
    "taskId",
    "changeKind",
    "contractPath",
    "implementationAgent",
    "changedFiles",
    "reference",
    "focusedEvidence"
  ],
  "properties": {
    "schemaVersion": {"enum": ["1.0", "1.1"]},
    "documentType": {"const": "ui-change-evidence"},
    "taskId": {
      "type": "string",
      "pattern": "^(?:CAP-[0-9]{2}\\.S[0-9]{2}\\.T[0-9]{2}|W(?:[0-9]|1[01])\\.A[0-9]{2}\\.T[0-9]{2}|W(?:[0-9]|1[01])\\.C[0-9]{2,}\\.T01)$"
    },
    "changeKind": {
      "enum": ["intentional-design-change", "approved-reference-implementation", "defect-restoration"]
    },
    "contractPath": {
      "type": "string",
      "pattern": "^artifacts/evidence/ui-change/(?:CAP-[0-9]{2}\\.S[0-9]{2}\\.T[0-9]{2}|W(?:[0-9]|1[01])\\.A[0-9]{2}\\.T[0-9]{2}|W(?:[0-9]|1[01])\\.C[0-9]{2,}\\.T01)\\.json$"
    },
    "implementationAgent": {
      "type": "string",
      "pattern": "^(agent|human):[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "changedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"},
      "uniqueItems": true
    },
    "reference": {
      "type": "object",
      "required": [
        "referenceId",
        "version",
        "packageSha256",
        "approvalCommit",
        "approvedBy",
        "previousReferenceId"
      ],
      "properties": {
        "referenceId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "packageSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "approvalCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "approvedBy": {"type": "string", "minLength": 1},
        "previousReferenceId": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "focusedEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "result", "scope"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "result": {"const": "passed"},
          "scope": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "restoration": {
      "type": "object",
      "required": ["defect", "expectedBehavior"],
      "properties": {
        "defect": {"type": "string", "minLength": 1},
        "expectedBehavior": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "implementationScope": {"type": "string", "minLength": 1},
    "amendmentAuthority": {
      "type": "object",
      "required": ["correctionId", "adoptionCommit", "reactivationCommit", "inheritedCorrectionUiFiles", "resumedUiFiles", "classification"],
      "properties": {
        "correctionId": {"type": "string", "pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}$"},
        "adoptionCommit": {"$ref": "#/$defs/commit"},
        "reactivationCommit": {"$ref": "#/$defs/commit"},
        "inheritedCorrectionUiFiles": {"$ref": "#/properties/changedFiles"},
        "resumedUiFiles": {"$ref": "#/properties/changedFiles"},
        "classification": {
          "type": "object",
          "required": ["path", "sha256", "commit"],
          "properties": {
            "path": {"type": "string", "pattern": "^artifacts/evidence/W(?:[0-9]|1[01])\\.A[0-9]{2}\\.T[0-9]{2}\\.ui-classification-R[0-9]{2}\\.json$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "commit": {"$ref": "#/$defs/commit"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
  "allOf": [
    {
      "if": {"properties": {"taskId": {"pattern": "^W(?:[0-9]|1[01])\\.C[0-9]{2,}\\.T01$"}}},
      "then": {"properties": {"schemaVersion": {"const": "1.0"}, "changeKind": {"const": "defect-restoration"}}}
    },
    {
      "if": {"properties": {"schemaVersion": {"const": "1.1"}}},
      "then": {
        "required": ["amendmentAuthority"],
        "properties": {
          "changeKind": {"const": "defect-restoration"},
          "taskId": {"pattern": "^W(?:[0-9]|1[01])\\.A[0-9]{2}\\.T[0-9]{2}$"}
        }
      },
      "else": {"not": {"required": ["amendmentAuthority"]}}
    },
    {
      "if": {"properties": {"changeKind": {"const": "defect-restoration"}}},
      "then": {"required": ["restoration"]}
    },
    {
      "if": {"properties": {"changeKind": {"enum": ["intentional-design-change", "approved-reference-implementation"]}}},
      "then": {"required": ["implementationScope"]}
    }
  ],
  "additionalProperties": false
}
