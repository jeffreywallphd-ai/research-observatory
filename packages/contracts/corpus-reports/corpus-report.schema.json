{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/contracts/corpus-reports/corpus-report.schema.json",
  "title": "Research Observatory corpus report snapshot, member and drill page",
  "description": "Immutable canonical-item report values. Core rechecks project, Intent, source, rights and current read authority in protected storage.",
  "x-research-observatory-semanticRules": [
    "snapshot-denominator-is-one-current-revision-per-canonical-item",
    "report-member-rows-are-strictly-ordered-by-item-id",
    "source-and-route-contributions-count-distinct-member-items-not-paths",
    "source-and-route-overlap-count-distinct-items-in-pair-intersection",
    "unattributed-paths-never-invent-source-roots",
    "all-seven-dimensions-classify-every-member-once",
    "known-values-require-exact-retained-rights-authorized-witness",
    "missing-values-are-not-zero-or-imputed",
    "summary-overflow-is-explicit-and-member-drill-stays-exact",
    "report-creation-and-current-read-authority-remain-core-responsibilities"
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/CorpusReportSnapshot"
    },
    {
      "$ref": "#/$defs/CorpusReportMember"
    },
    {
      "$ref": "#/$defs/CorpusReportDrillPage"
    }
  ],
  "$defs": {
    "Count": {
      "maximum": 100000,
      "minimum": 0,
      "type": "integer"
    },
    "CoverageSummary": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "$ref": "#/$defs/ReportDimension"
        },
        "known": {
          "$ref": "#/$defs/Count"
        },
        "notReported": {
          "$ref": "#/$defs/Count"
        },
        "unknown": {
          "$ref": "#/$defs/Count"
        },
        "unavailable": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "dimension",
        "known",
        "notReported",
        "unknown",
        "unavailable"
      ],
      "type": "object"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "DiscoveryPathCount": {
      "maximum": 100000000,
      "minimum": 0,
      "type": "integer"
    },
    "DiscoveryPathPairCount": {
      "maximum": 49950000000,
      "minimum": 0,
      "type": "integer"
    },
    "Identity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "MembershipCount": {
      "additionalProperties": false,
      "properties": {
        "membership": {
          "$ref": "#/$defs/ReportMembership"
        },
        "itemCount": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "membership",
        "itemCount"
      ],
      "type": "object"
    },
    "ProjectIdentity": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[47][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "ReportDimension": {
      "enum": [
        "identifier",
        "year",
        "venue",
        "language",
        "discipline",
        "oa",
        "full-text"
      ],
      "type": "string"
    },
    "ReportMembership": {
      "enum": [
        "candidate",
        "included",
        "excluded",
        "withdrawn"
      ],
      "type": "string"
    },
    "ReportRoute": {
      "enum": [
        "import-member",
        "connector-record",
        "citation",
        "recommendation",
        "manual"
      ],
      "type": "string"
    },
    "RouteContribution": {
      "additionalProperties": false,
      "properties": {
        "route": {
          "$ref": "#/$defs/ReportRoute"
        },
        "itemCount": {
          "$ref": "#/$defs/Count"
        },
        "discoveryPathCount": {
          "$ref": "#/$defs/DiscoveryPathCount"
        }
      },
      "required": [
        "route",
        "itemCount",
        "discoveryPathCount"
      ],
      "type": "object"
    },
    "RouteOverlap": {
      "additionalProperties": false,
      "properties": {
        "leftRoute": {
          "$ref": "#/$defs/ReportRoute"
        },
        "rightRoute": {
          "$ref": "#/$defs/ReportRoute"
        },
        "itemCount": {
          "$ref": "#/$defs/Count"
        },
        "discoveryPathPairCount": {
          "$ref": "#/$defs/DiscoveryPathPairCount"
        }
      },
      "required": [
        "leftRoute",
        "rightRoute",
        "itemCount",
        "discoveryPathPairCount"
      ],
      "type": "object"
    },
    "SourceContribution": {
      "additionalProperties": false,
      "properties": {
        "sourceKey": {
          "$ref": "#/$defs/SourceKey"
        },
        "itemCount": {
          "$ref": "#/$defs/Count"
        },
        "discoveryPathCount": {
          "$ref": "#/$defs/DiscoveryPathCount"
        }
      },
      "required": [
        "sourceKey",
        "itemCount",
        "discoveryPathCount"
      ],
      "type": "object"
    },
    "SourceKey": {
      "maxLength": 90,
      "pattern": "^(?:import:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|connector:[a-z][a-z0-9-]{0,63})$",
      "type": "string"
    },
    "SourceOverlap": {
      "additionalProperties": false,
      "properties": {
        "leftSourceKey": {
          "$ref": "#/$defs/SourceKey"
        },
        "rightSourceKey": {
          "$ref": "#/$defs/SourceKey"
        },
        "itemCount": {
          "$ref": "#/$defs/Count"
        },
        "discoveryPathPairCount": {
          "$ref": "#/$defs/DiscoveryPathPairCount"
        }
      },
      "required": [
        "leftSourceKey",
        "rightSourceKey",
        "itemCount",
        "discoveryPathPairCount"
      ],
      "type": "object"
    },
    "ValueBucket": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "itemCount": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "value",
        "itemCount"
      ],
      "type": "object"
    },
    "ValueDistribution": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "$ref": "#/$defs/ReportDimension"
        },
        "buckets": {
          "items": {
            "$ref": "#/$defs/ValueBucket"
          },
          "maxItems": 50,
          "type": "array"
        },
        "otherKnownCount": {
          "$ref": "#/$defs/Count"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "dimension",
        "buckets",
        "otherKnownCount",
        "truncated"
      ],
      "type": "object"
    },
    "CorpusReportSnapshot": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "type": "string"
        },
        "contractVersion": {
          "const": "1.0.0",
          "type": "string"
        },
        "documentType": {
          "const": "research-observatory-corpus-report-snapshot",
          "type": "string"
        },
        "snapshotId": {
          "$ref": "#/$defs/Identity"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectIdentity"
        },
        "intentRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "protocolRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "ruleVersion": {
          "const": "corpus-report/1.0.0",
          "type": "string"
        },
        "createdAt": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
          "type": "string"
        },
        "memberCount": {
          "$ref": "#/$defs/Count"
        },
        "discoveryPathCount": {
          "$ref": "#/$defs/DiscoveryPathCount"
        },
        "membersSha256": {
          "$ref": "#/$defs/Digest"
        },
        "membershipCounts": {
          "items": {
            "$ref": "#/$defs/MembershipCount"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "duplicateLinkedItemCount": {
          "$ref": "#/$defs/Count"
        },
        "unattributedItemCount": {
          "$ref": "#/$defs/Count"
        },
        "unattributedDiscoveryPathCount": {
          "$ref": "#/$defs/DiscoveryPathCount"
        },
        "sourceContributions": {
          "items": {
            "$ref": "#/$defs/SourceContribution"
          },
          "maxItems": 512,
          "type": "array"
        },
        "sourceOverlaps": {
          "items": {
            "$ref": "#/$defs/SourceOverlap"
          },
          "maxItems": 20000,
          "type": "array"
        },
        "routeContributions": {
          "items": {
            "$ref": "#/$defs/RouteContribution"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array"
        },
        "routeOverlaps": {
          "items": {
            "$ref": "#/$defs/RouteOverlap"
          },
          "maxItems": 10,
          "type": "array"
        },
        "coverage": {
          "items": {
            "$ref": "#/$defs/CoverageSummary"
          },
          "maxItems": 7,
          "minItems": 7,
          "type": "array"
        },
        "valueDistributions": {
          "items": {
            "$ref": "#/$defs/ValueDistribution"
          },
          "maxItems": 6,
          "minItems": 6,
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "contractVersion",
        "documentType",
        "snapshotId",
        "projectId",
        "intentRevisionId",
        "protocolRevisionId",
        "ruleVersion",
        "createdAt",
        "memberCount",
        "discoveryPathCount",
        "membersSha256",
        "membershipCounts",
        "duplicateLinkedItemCount",
        "unattributedItemCount",
        "unattributedDiscoveryPathCount",
        "sourceContributions",
        "sourceOverlaps",
        "routeContributions",
        "routeOverlaps",
        "coverage",
        "valueDistributions"
      ],
      "type": "object"
    },
    "ReportField": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "$ref": "#/$defs/ReportDimension"
        },
        "state": {
          "$ref": "#/$defs/ReportState"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "witnessRevisionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "dimension",
        "state",
        "value",
        "witnessRevisionId"
      ],
      "type": "object"
    },
    "ReportPath": {
      "additionalProperties": false,
      "properties": {
        "pathId": {
          "$ref": "#/$defs/Identity"
        },
        "sourceRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "contextRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "sourceKey": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "route": {
          "$ref": "#/$defs/ReportRoute"
        },
        "metadataAssertionStatus": {
          "enum": [
            "retained",
            "no-external-assertion"
          ],
          "type": "string"
        },
        "reportInspectStatus": {
          "enum": [
            "allowed",
            "unassessed"
          ],
          "type": "string"
        },
        "rightsPolicyRevisionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "rightsExpiresAt": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceCopyAvailability": {
          "const": "unknown",
          "type": "string"
        }
      },
      "required": [
        "pathId",
        "sourceRevisionId",
        "contextRevisionId",
        "sourceKey",
        "route",
        "metadataAssertionStatus",
        "reportInspectStatus",
        "rightsPolicyRevisionId",
        "rightsExpiresAt",
        "sourceCopyAvailability"
      ],
      "type": "object"
    },
    "ReportState": {
      "enum": [
        "known",
        "not-reported",
        "unknown",
        "unavailable"
      ],
      "type": "string"
    },
    "CorpusReportMember": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "type": "string"
        },
        "contractVersion": {
          "const": "1.0.0",
          "type": "string"
        },
        "documentType": {
          "const": "research-observatory-corpus-report-member",
          "type": "string"
        },
        "snapshotId": {
          "$ref": "#/$defs/Identity"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectIdentity"
        },
        "itemId": {
          "$ref": "#/$defs/Identity"
        },
        "itemRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "workId": {
          "$ref": "#/$defs/Identity"
        },
        "workRevisionId": {
          "$ref": "#/$defs/Identity"
        },
        "membership": {
          "$ref": "#/$defs/ReportMembership"
        },
        "duplicateOfItemId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "displayLabel": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/ReportPath"
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/ReportField"
          },
          "maxItems": 7,
          "minItems": 7,
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "contractVersion",
        "documentType",
        "snapshotId",
        "projectId",
        "itemId",
        "itemRevisionId",
        "workId",
        "workRevisionId",
        "membership",
        "duplicateOfItemId",
        "displayLabel",
        "paths",
        "fields"
      ],
      "type": "object"
    },
    "CorpusReportFilter": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ReportFilterKind"
        },
        "membership": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportMembership"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceKey": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "leftSourceKey": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "rightSourceKey": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportRoute"
            },
            {
              "type": "null"
            }
          ]
        },
        "leftRoute": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportRoute"
            },
            {
              "type": "null"
            }
          ]
        },
        "rightRoute": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportRoute"
            },
            {
              "type": "null"
            }
          ]
        },
        "dimension": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportDimension"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportState"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "membership",
        "sourceKey",
        "leftSourceKey",
        "rightSourceKey",
        "route",
        "leftRoute",
        "rightRoute",
        "dimension",
        "state",
        "value"
      ],
      "type": "object"
    },
    "ReportFilterKind": {
      "enum": [
        "all",
        "membership",
        "duplicate-linked",
        "unattributed",
        "source",
        "route",
        "source-overlap",
        "route-overlap",
        "coverage"
      ],
      "type": "string"
    },
    "CorpusReportDrillPage": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0",
          "type": "string"
        },
        "contractVersion": {
          "const": "1.0.0",
          "type": "string"
        },
        "documentType": {
          "const": "research-observatory-corpus-report-drill-page",
          "type": "string"
        },
        "snapshotId": {
          "$ref": "#/$defs/Identity"
        },
        "projectId": {
          "$ref": "#/$defs/ProjectIdentity"
        },
        "filter": {
          "$ref": "#/$defs/CorpusReportFilter"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/CorpusReportMember"
          },
          "maxItems": 100,
          "type": "array"
        },
        "nextCursor": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "total": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "schemaVersion",
        "contractVersion",
        "documentType",
        "snapshotId",
        "projectId",
        "filter",
        "members",
        "nextCursor",
        "total"
      ],
      "type": "object"
    }
  }
}
