{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-observatory.local/contracts/storage/object-store-profile.schema.json",
  "title": "Research Observatory object-store profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "profileId",
    "contentIdentity",
    "deduplicationScope",
    "physicalIdentity",
    "objectBytesLocation",
    "metadataAuthority",
    "referenceAuthority",
    "atomicPublication",
    "deleteCrashRecovery",
    "accessSerialization",
    "activeReaderDelete",
    "referenceAvailability",
    "storageStates",
    "retentionClasses",
    "readableRightsStates",
    "openMode",
    "corruptionBehavior",
    "encryptionBoundary",
    "dataKeyProfile",
    "keyWrapping",
    "plaintextTemporaryStorage",
    "plaintextFixtureMode",
    "priorEnvelopeUpgrade",
    "upgradeComposition",
    "upgradePhases",
    "upgradeRollback",
    "upgradeInterruptionCoverage",
    "upgradeCancellation",
    "malformedEnvelopeFailure",
    "wrappedKeyAuthenticationFailure",
    "keyUnavailableBehavior",
    "accountingCategories",
    "quotaPolicy",
    "lowDiskBehavior",
    "automaticCanonicalReclamation",
    "garbageCollection",
    "cacheEviction",
    "orphanCleanup",
    "cleanupAudit",
    "cleanupRestart",
    "sharedCacheAuthority",
    "releaseQualification"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "documentType": {"const": "research-observatory-object-store-profile"},
    "profileId": {"const": "project-object-store-v1"},
    "contentIdentity": {"const": "plaintext-sha256"},
    "deduplicationScope": {"const": "project-only"},
    "physicalIdentity": {"const": "hmac-sha256-project-identity"},
    "objectBytesLocation": {"const": "project-objects-class"},
    "metadataAuthority": {"const": "sqlite-object-records"},
    "referenceAuthority": {"const": ["immutable-document-revisions"]},
    "atomicPublication": {
      "const": [
        "exclusive-project-staging",
        "stream-encrypt-and-hash-plaintext",
        "fsync-complete-file",
        "verify-identity-authentication-and-content",
        "create-if-absent-publication",
        "retain-verified-handle-through-commit",
        "reconcile-commit-acknowledgement",
        "commit-metadata"
      ]
    },
    "deleteCrashRecovery": {"const": "restore-unless-delete-metadata-committed"},
    "accessSerialization": {"const": "reserved-metadata-transaction-for-held-stream"},
    "activeReaderDelete": {"const": "bounded-busy-retry"},
    "referenceAvailability": {"const": "document-link-requires-available-object"},
    "storageStates": {"const": ["pending", "available", "quarantined", "deleted"]},
    "retentionClasses": {"const": ["project-lifetime", "derived-rebuildable", "export-retained"]},
    "readableRightsStates": {"const": ["allowed", "not-applicable"]},
    "openMode": {"const": "verified-controlled-stream-no-path"},
    "corruptionBehavior": {"const": "deny-before-first-byte-and-quarantine"},
    "encryptionBoundary": {"const": "secretstream-xchacha20poly1305-v1"},
    "dataKeyProfile": {"const": "random-256-bit-key-per-object"},
    "keyWrapping": {"const": "xchacha20poly1305-ietf-versioned-project-master-key"},
    "plaintextTemporaryStorage": {"const": "forbidden"},
    "plaintextFixtureMode": {"const": "explicit-test-only"},
    "priorEnvelopeUpgrade": {"const": "pre-open-durable-journaled-verified-copy-on-write"},
    "upgradeComposition": {"const": "mandatory-core-pre-open-coordinator"},
    "upgradePhases": {
      "const": [
        "legacy-detected",
        "replacement-writing",
        "replacement-verified",
        "swap-intent",
        "metadata-committed",
        "complete"
      ]
    },
    "upgradeRollback": {"const": "retain-plaintext-outside-temp-until-production-open-verifies"},
    "upgradeInterruptionCoverage": {
      "const": "pre-and-post-journal-fsync-rename-verification-metadata-commit-cleanup"
    },
    "upgradeCancellation": {"const": "journaled-safe-boundary-preserve-and-resume"},
    "malformedEnvelopeFailure": {"const": "corrupt-quarantine"},
    "wrappedKeyAuthenticationFailure": {"const": "key-unavailable-preserve"},
    "keyUnavailableBehavior": {"const": "bounded-failure-preserve-for-recovery"},
    "accountingCategories": {
      "const": [
        "canonical-metadata",
        "durable-objects",
        "derived-objects",
        "orphaned-objects",
        "indexes",
        "project-cache",
        "models",
        "configuration",
        "exports",
        "operational",
        "shared-cache"
      ]
    },
    "quotaPolicy": {"const": "deployment-supplied-project-and-shared-cache-soft-hard-thresholds"},
    "lowDiskBehavior": {"const": "deny-new-object-writes-preserve-reads-and-cleanup"},
    "automaticCanonicalReclamation": {"const": "unreferenced-derived-rebuildable-only"},
    "garbageCollection": {"const": "preview-lease-revalidate-reference-reader-and-file-identity"},
    "cacheEviction": {"const": "exclusive-regular-rebuildable-files-only"},
    "orphanCleanup": {"const": "opaque-inventory-without-metadata-exclusive-file-only"},
    "cleanupAudit": {"const": "content-free-intent-and-completion-project-audit"},
    "cleanupRestart": {"const": "item-atomic-rescan-and-resume"},
    "sharedCacheAuthority": {"const": "optional-explicit-root-layout-deferred-to-cap-02-s05"},
    "releaseQualification": {"const": "authenticated-encrypted-object-adapter"}
  }
}
